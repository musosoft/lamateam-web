{
  "name": "lamateam-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/cache-map-images.mjs && astro build",
    "typecheck": "tsc --noEmit",
    "check": "astro check && pnpm build && pnpm typecheck && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy": "pnpm build && pnpm typecheck && wrangler deploy --config dist/server/wrangler.json",
    "preview": "pnpm build && wrangler dev --config dist/server/wrangler.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:style": "stylelint \"**/*.{css,astro}\"",
    "lint:astro": "eslint .",
    "lint": "pnpm lint:style && pnpm lint:astro",
    "fix": "pnpm lint:style --fix && eslint . --fix && pnpm format",
    "postinstall": "astro telemetry disable"
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/cloudflare": "13.1.3",
    "@iconify-json/mdi": "^1.2.3",
    "@libsql/client": "^0.17.2",
    "astro": "6.0.8",
    "astro-icon": "^1.1.5",
    "cookie": "^1.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.6.1+sha512.40ee09af407fa9fbb5fbfb8e1cb40fbb74c0af0c3e10e9224d7b53c7658528615b2c92450e74cfad91e3a2dcafe3ce4050d80bda71d757756d2ce2b66213e9a3",
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^1.6.0",
    "fluid-tailwindcss": "^1.0.9",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.5.0",
    "stylelint-config-html": "^1.1.0",
    "wrangler": "^4.76.0"
  },
  "pnpm": {
    "overrides": {
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "tar@<7.5.11": ">=7.5.11",
      "svgo@<3.3.3": ">=3.3.3",
      "ajv@<8.18.0": ">=8.18.0"
    }
  }
}
