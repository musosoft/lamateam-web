          <li>MarekQX</li>
          <li>štefan</li>
          <li>Deadman</li>
          <li>paty</li>
          <li>vladko</li>
        </ul>
      </div>
    </details>

    <details class="bg-gray-800 rounded-lg shadow-lg">
      <summary
        class="cursor-pointer py-3 px-4 font-semibold hover:bg-gray-700 rounded-lg text-xl"
        >Kdo je admin?</summary
      >
      <div class="p-4 text-sm leading-6 overflow-y-scroll max-h-96">
        <ul>
          <li>Bassik</li>
          <li>Hor</li>
          <li>Ipos</li>
          <li>BOT - Luc@sonE™</li>
          <li>muso.sk</li>
          <li>Qatro-SPS</li>
          <li>Voody</li>
