---
// src/pages/faq.astro
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/Accordion.astro';
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';

let demoFiles: string[] = [];
let serverMaps: string[] = [];

const MAPS_CSV_URL =
  'https://docs.google.com/spreadsheets/d/e/2PACX-1vTufS4N6N-30qHu47IuYFnR8CqjM9iTTWQLQ9d4w0SxpmdI984EcnbG8D4ZAerbtKzuxtTHAlHrZpHQ/pub?output=csv';
const MAP_IMAGE_BASE = 'https://stats.lamateam.eu/hlstatsimg/games/css/maps';
const MAP_PLACEHOLDER = '/assets/map-placeholder.svg';

interface MapCard {
  name: string;
  sourceImage: string;
  optimizedImage: string;
  width: number;
  height: number;
}

const mapCards: MapCard[] = [];

function parseCsvLine(line: string, delimiter: string): string[] {
  const out: string[] = [];
  let cur = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const ch = line[i];

    if (ch === '"') {
      if (inQuotes && line[i + 1] === '"') {
        cur += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
      continue;
    }

    if (ch === delimiter && !inQuotes) {
      out.push(cur);
      cur = '';
      continue;
    }

    cur += ch;
  }

  out.push(cur);
  return out;
}

async function urlExists(url: string, timeoutMs = 2500): Promise<boolean> {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), timeoutMs);

  try {
    const head = await fetch(url, { method: 'HEAD', signal: ctrl.signal });
    if (head.ok) return true;

    const get = await fetch(url, { method: 'GET', signal: ctrl.signal });
    return get.ok;
  } catch {
    return false;
  } finally {
    clearTimeout(t);
  }
}

async function resolveMapImage(mapName: string): Promise<string> {
  const encoded = encodeURIComponent(mapName);
  const candidates = [
    `${MAP_IMAGE_BASE}/${mapName}.jpg`,
    `https://images.gamebanana.com/img/ss/maps/${mapName}_1.jpg`,
    `https://images.gamebanana.com/img/ss/maps/${mapName}.jpg`,
    `https://www.17buddies.rocks/17b2/maps/images/${mapName}.jpg`,
    `https://www.17buddies.rocks/17b2/maps/images/${encoded}.jpg`,
  ];

  for (const url of candidates) {
    if (await urlExists(url)) return url;
  }

  return MAP_PLACEHOLDER;
}

function getCustomMapsFromCsv(raw: string): string[] {
  const delimiter = raw.includes('";"') ? ';' : ',';
  const lines = raw
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter(Boolean);

  if (!lines.length) return [];

  const header = parseCsvLine(lines[0], delimiter).map((v) =>
    v.trim().replace(/^"|"$/g, ''),
  );

  let mapCol = header.findIndex((h) => h.toUpperCase() === 'MAPA');
  if (mapCol === -1) mapCol = 1;

  const uniq = new Set<string>();
  for (let i = 1; i < lines.length; i++) {
    const row = parseCsvLine(lines[i], delimiter);
    if (row.length <= mapCol) continue;

    let name = row[mapCol]?.trim().replace(/^"|"$/g, '') ?? '';
    if (!name) continue;

    if (name.toLowerCase().endsWith('.bsp')) {
      name = name.slice(0, -4);
    }

    if (name) uniq.add(name);
  }

  return Array.from(uniq);
}

try {
  const response = await fetch(
    'https://wild-fire-819b.still-fog-235d.workers.dev/list',
  );
  if (response.ok) {
    demoFiles = (await response.json()) as string[];
  } else {
    console.error('Failed to fetch demo files:', response.statusText);
  }
} catch (error) {
  console.error('Error fetching demo files:', error);
}

try {
  const csvResp = await fetch(MAPS_CSV_URL);
  if (csvResp.ok) {
    const csvRaw = await csvResp.text();
    serverMaps = getCustomMapsFromCsv(csvRaw);

    const resolved = await Promise.all(
      serverMaps.map(async (name) => {
        const sourceImage = await resolveMapImage(name);

        if (sourceImage === MAP_PLACEHOLDER) {
          return {
            name,
            sourceImage,
            optimizedImage: MAP_PLACEHOLDER,
            width: 320,
            height: 180,
          } satisfies MapCard;
        }

        try {
          const optimized = await getImage({
            src: sourceImage,
            width: 320,
            height: 180,
            format: 'webp',
            quality: 'mid',
          });

          return {
            name,
            sourceImage,
            optimizedImage: optimized.src,
            width: optimized.attributes.width ?? 320,
            height: optimized.attributes.height ?? 180,
          } satisfies MapCard;
        } catch {
          return {
            name,
            sourceImage,
            optimizedImage: sourceImage,
            width: 320,
            height: 180,
          } satisfies MapCard;
        }
      }),
    );

    mapCards.push(...resolved);
  } else {
    console.error('Failed to fetch map CSV:', csvResp.statusText);
  }
} catch (error) {
  console.error('Error fetching map CSV:', error);
}
---

<Layout title="FAQ">
  <h1 class="text-3xl font-bold text-center mb-8">Často kladené otázky</h1>
  <div class="space-y-4 overflow-y-auto w-full max-w-7xl mx-auto">
    <Accordion summary="Užitečné informace">
      <p>
        Kompletní a aktuální přehled hráčských příkazů najdeš na
        <a href="/info" class="text-cyan-300 underline">/info</a>.
      </p>
      <p>Nejpoužívanější: <code>!motd</code>, <code>!nb</code>, <code>!rtv</code>, <code>!nominate</code>, <code>!rs</code>.</p>
      <p>
        Pokud máš připomínky, nápady na zlepšení, nebo chceš nahlásit
        podvádějícího hráče, napiš nám v sekci KONTAKT.
      </p>
      <p><strong>Majitelem serveru je crazy69.</strong></p>
      <p>Hosting zabezpečuje FakaHeda.eu.</p>
      <p>Najdeš nás taky na Facebooku - hledej: LaMaTeAm.eu.</p>
    </Accordion>

    <Accordion summary="Hitboxy, Hitreg, Rate, 'nehituje to'...?">
      <h2 class="text-xl font-bold">📜 Shrnutí</h2>

      <ul class="space-y-2">
        <li>
          <strong>🎯 Hitbox</strong> — Neviditelná krabice kolem hráče, kterou server
          používá k detekci zásahů. Pokud trefíš model, ale ne hitbox, server to nepočítá
          jako zásah.
        </li>

        <li>
          <strong>📡 Hitreg</strong> — Kontrola, zda jsi trefil hitbox. Střely se
          kontrolují <strong>na serveru, ne na tvém PC</strong>. Můžeš vidět
          krev, ale neudělat žádný damage, protože server rozhoduje, ne tvoje
          obrazovka.
        </li>

        <li>
          <strong>⏲️ Tickrate 100</strong> — Server přepočítává hru <strong
            >100x za sekundu</strong
          >. To znamená lepší registraci střel, plynulejší pohyb a přesnější
          fyziku. Vše je přesnější než na serveru s 66 tickrate.
        </li>

        <li>
          <strong>📥 Updaterate 100</strong> — Server ti posílá <strong
            >100 aktualizací za sekundu</strong
          >. Vidíš plynulý pohyb hráčů bez sekání. Server vynucuje <strong
            >updaterate 100</strong
          > pro všechny hráče – nelze změnit.
        </li>

        <li>
          <strong>📤 Cmdrate 100</strong> — Tvoje příkazy (střelba, pohyb) se posílají
          <strong>100x za sekundu</strong> na server. Tím je zajištěno, že server
          vždy ví, co děláš, bez zpoždění. Server vynucuje <strong
            >cmdrate 100</strong
          > pro všechny hráče – nelze změnit.
        </li>

        <li>
          <strong>🚀 Rate 196000</strong> — Maximální rychlost dat, která můžeš přijmout
          od serveru, je <strong>1.57 Mbps</strong>. Server vynucuje <strong
            >rate 196000</strong
          > – nelze změnit.
        </li>

        <li>
          <strong>📐 Interp 0-0.031</strong> — To je rezerva, která zajišťuje plynulost
          pohybu i při menších ztrátách dat. Server vynucuje interp mezi <strong
            >0 a 0.031</strong
          >. Čím nižší interp, tím přesnější zásahy.
        </li>

        <li>
          <strong>⚡ Ping vs Latency</strong> —
          <ul class="list-disc list-inside ml-6">
            <li>
              <strong>Ping</strong>: Celkový čas, který trvá odeslání a přijetí
              paketů (tam i zpět).
            </li>
            <li>
              <strong>Latency</strong>: Čas, který trvá, než tvůj příkaz dorazí
              na server (pouze jedna cesta).
            </li>
          </ul>
        </li>

        <li>
          <strong>🩸 Krev, ale žádný damage</strong> — Krev se zobrazuje <strong
            >na tvém PC</strong
          >, ale o zásahu rozhoduje server. Pokud server výstřel nezaznamená,
          neuvidíš damage, i když jsi viděl krev.
        </li>

        <li>
          <strong>📈 Net_Graph 4</strong> —
          <ul class="list-disc list-inside ml-6">
            <li>
              <strong>Loss</strong> — Pakety se ztratí po cestě na server. Hráči teleportují
              a střely se nezaregistrují.
            </li>
            <li>
              <strong>Choke</strong> — Chybí snímky, protože tvé připojení je přetížené.
              Vidíš trhaný pohyb hráčů.
            </li>
            <li>
              Mezery v čarách = Chybějící snímky (choke) nebo ztracené pakety
              (loss).
            </li>
          </ul>
        </li>

        <li>
          <strong>📦 Co je Loss?</strong> — Ztracené pakety, které se nikdy nedostanou
          na server. Pokud máš <strong>loss &gt; 0%</strong>, tvoje střely se
          nemusí dostat na server a hráči teleportují.
        </li>

        <li>
          <strong>🌐 Co je Choke?</strong> — Data od serveru se ti nevejdou do připojení.
          Chybí snímky, takže vidíš trhaný pohyb hráčů.
        </li>

        <li>
          <strong>💡 Co dělá Rate Checker?</strong> — <strong
            >Rate Checker je BLBOST!</strong
          > Ukazuje, co máš nastaveno <strong>lokálně</strong>, ale server
          vynucuje své hodnoty. Server nastaví <strong
            >rate 196000, cmdrate 100, updaterate 100</strong
          > a hráč to nemůže změnit.
        </li>
      </ul>

      <h2 class="text-xl font-bold mt-6">
        🔴 Takže, když ti to "nehituje", zkontroluj toto:
      </h2>
      <ul class="list-decimal list-inside space-y-2 mt-4">
        <li>
          <strong>Loss</strong> — Pokud je <strong>loss &gt; 0%</strong>, tvoje
          střely se nemusí dostat na server.
        </li>
        <li><strong>Ping</strong> — Vysoký ping = větší zpoždění zásahu.</li>
        <li>
          <strong>Choke</strong> — Pokud je choke &gt; 0%, vidíš pohyby později a
          trhaně.
        </li>
        <li>
          <strong>Net_Graph 4</strong> — Sleduj mezery ve žlutých a zelených čarách.
        </li>
      </ul>

      <h2 class="text-xl font-bold mt-6">📜 Co vynucuje server?</h2>
      <ul class="list-disc list-inside space-y-2">
        <li><strong>Rate</strong> = 196000</li>
        <li><strong>Cmdrate</strong> = 100</li>
        <li><strong>Updaterate</strong> = 100</li>
        <li><strong>Interp</strong> = 0-0.031</li>
        <li><strong>Interp Ratio</strong> = 1</li>
      </ul>

      <p class="mt-6">
        Pokud někdo ještě někdy řekne <strong>"nehituje to"</strong>, odkaž ho
        na tento seznam. <strong>Server je šéf! 🎉</strong>
      </p>
    </Accordion>

    <Accordion summary="Málo FPS, špatný skin, chybí radar, blbnou zvuky...?">
      <!-- FAQ Item 1 -->
      <div class="space-y-2 mb-4">
        <p class="text-gray-100 text-xl">1. Pokus - vyzkoušej magický fix:</p>
        <div
          class="text-sm inline-flex items-center space-x-4 bg-gray-900 text-gray-200 rounded-lg p-4"
        >
          <span class="flex gap-4">
            <span class="shrink-0 text-blue-500 pointer-events-none">~</span>
            <span class="flex-1 copy-content">
              exec config;exec autoexec;record
              null;stop;soundscape_flush;snd_restart;hud_reloadscheme;overview_mode
              1
            </span>
            <button
              onclick="copyToClipboard(this)"
              class="shrink-0 text-gray-500 transition hover:text-white"
            >
              <Icon name="mdi:content-copy" class="h-5 w-5" />
            </button>
          </span>
        </div>

        <!-- FAQ Item 2 -->
        <div class="space-y-2">
          <p class="text-gray-100 text-xl">2. Pokus - vyzkoušej retry:</p>
          <div
            class="text-sm inline-flex items-center space-x-4 bg-gray-900 text-gray-200 rounded-lg p-4"
          >
            <span class="flex gap-4">
              <span class="shrink-0 text-blue-500 pointer-events-none">~</span>
              <span class="flex-1 copy-content">retry</span>
            </span>
            <button
              onclick="copyToClipboard(this)"
              class="shrink-0 text-gray-500 transition hover:text-white"
            >
              <Icon name="mdi:content-copy" class="h-5 w-5" />
            </button>
          </div>
        </div>

        <!-- FAQ Item 3 -->
        <div class="space-y-2">
          <p class="text-gray-100 text-xl">3. Pokus - vyzkoušej náš CFG:</p>
          <ol class="list-decimal list-inside space-y-2 text-gray-200 text-md">
            <li>Stlač <kbd>Win</kbd> + <kbd>R</kbd>.</li>
            <li>Zkopíruj, vlož do "Spustit" dialogu, a stlač Enter:</li>
          </ol>
          <div
            class="text-sm inline-flex items-center space-x-4 bg-gray-900 text-gray-200 rounded-lg p-4"
          >
            <span class="flex gap-4">
              <span class="shrink-0 text-blue-500 pointer-events-none">$</span>
              <span class="flex-1 copy-content">
                powershell iwr
                'https://raw.githack.com/musosoft/css-cfg/main/autoexec.cfg'
                -OutFile
                '%PROGRAMFILES(x86)%\Steam\SteamApps\common\counter-strike
                source\cstrike\cfg\autoexec.cfg'
              </span>
            </span>
            <button
              onclick="copyToClipboard(this)"
              class="shrink-0 text-gray-500 transition hover:text-white"
            >
              <Icon name="mdi:content-copy" class="h-5 w-5" />
            </button>
          </div>
          <p class="text-gray-200 text-md">
            3. Napíš "exec autoexec.cfg" do konzole.
          </p>
        </div>
      </div>
    </Accordion>

    <Accordion summary="Jak nahrát demo?">
      <ol class="list-decimal list-inside space-y-2">
        <li>
          Nahrávaní dema spusť příkazem v console <code
