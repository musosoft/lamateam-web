                  class="h-24 w-full object-cover"
                />
                <div class="truncate border-t border-gray-800 px-2 py-2 text-center text-xs font-medium text-gray-200 group-hover:text-cyan-300">
                  {mapCard.name}
                </div>
              </div>
            ))}
