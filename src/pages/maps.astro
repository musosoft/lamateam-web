---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
import { isGameUserAgent } from '../lib/motd-locale';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
const isGame = isGameUserAgent(Astro.request.headers.get('user-agent'));
const rawCommunityId =
  Astro.url.searchParams.get('communityid') ||
  Astro.cookies.get('communityid')?.value ||
  '';
const communityId = isGame ? rawCommunityId.slice(0, 32) : '';
import MapRatings from '../components/MapRatings.astro';
---

<Layout
  title={t('Maps | LaMaTeAm')}
  description={t('Current LaMaTeAm CS:S maps in the classic rotation.')}
  lang={locale}
>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('Server Maps')}
      </h1>
    </header>
    <MapRatings locale={locale} motdPrompt={isGame} communityId={communityId} />
  </section>
</Layout>
