---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<Layout title={t('Hitreg | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('Hit Registration & Rates')}
      </h1>
    </header>
    <article class="space-y-4 panel fl-p-3/6 text-gray-200">
      <ul class="space-y-2 list-disc pl-5">
        <li>
          <strong>{t('Hitbox')}</strong>{' '}
          {t(
            '— An invisible box around a player that the server uses to detect hits.',
          )}
        </li>
        <li>
          <strong>{t('Hit registration')}</strong>{' '}
          {t(
            '— The check that determines whether you hit a hitbox. Shots are verified by the server, not your PC.',
          )}
        </li>
        <li>
          <strong>{t('Tickrate 100')}</strong>{' '}
          {t('— The server updates the game 100 times per second.')}
        </li>
        <li>
          <strong>{t('Ping vs. latency')}</strong>{' '}
          {t(
            '— Ping is the round trip; latency is the one-way trip to the server.',
          )}
        </li>
        <li>
          <strong>{t('Blood but no damage')}</strong>{' '}
          {t(
            '— Your client renders the blood, but the server confirms the hit.',
          )}
        </li>
        <li>
          <strong>{t('Rate Checker')}</strong>{' '}
          {t(
            "— It shows your local settings, but the server's enforced values still apply.",
          )}
        </li>
      </ul>
      <h2 class="fl-text-lg/2xl font-bold fl-mt-4/6">
        {t('Shots not registering?')}
      </h2>
      <ol class="list-decimal pl-5 space-y-2">
        <li>
          {t('Use')} <code translate="no">net_graph 4</code>{' '}
          {t('to monitor loss, choke, and gaps in the graph lines.')}
        </li>
        <li>
          {t('Keep')} <strong translate="no">loss</strong> {t('and')}{' '}
          <strong translate="no">choke</strong> {t('at 0%.')}
        </li>
        <li>
          {t('Keep your')} <strong translate="no">ping</strong>{' '}
          {t('as low as possible.')}
        </li>
      </ol>
      <h2 class="fl-text-lg/2xl font-bold fl-mt-4/6">
        {t('Server-Enforced Settings')}
      </h2>
      <ul class="list-disc pl-5 space-y-2">
        <li>
          <strong translate="no">Rate</strong>{' '}
          {t('= 196000 — the data rate cannot be changed.')}
        </li>
        <li>
          <strong translate="no">Cmdrate</strong>{' '}
          {t('= 100 — commands sent to the server per second.')}
        </li>
        <li>
          <strong translate="no">Updaterate</strong>{' '}
          {t('= 100 — updates received from the server per second.')}
        </li>
        <li>
          <strong translate="no">Interp</strong>{' '}
          {t('= 0-0.031 — the interpolation range.')}
        </li>
        <li>
          <strong translate="no">Interp Ratio</strong> = 1
        </li>
      </ul>
    </article>
  </section>
</Layout>
