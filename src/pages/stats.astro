---
// src/pages/stats.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../assets/hero.svg?raw';
---

<Layout title="Stats" isAuthenticated={false} userName="" hero={Hero}>
  <!-- Modal for Stats -->
  <div class="fixed inset-0">
    <div class="relative bg-gray-900 rounded-lg mx-auto h-full">
      <iframe src="https://stats.lamateam.eu" class="w-full h-full rounded-lg"
      ></iframe>
    </div>
  </div>
</Layout>
