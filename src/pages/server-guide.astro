<script is:inline>
  const details = document.querySelectorAll('details');

  details.forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (detail.open) setTargetDetail(detail);
    });
  });

  function setTargetDetail(targetDetail) {
    details.forEach((detail) => {
      if (detail !== targetDetail) {
        detail.open = false;
      }
    });
  }

  function precacheMapImages() {
    const imgs = Array.from(document.querySelectorAll('img[data-map-image]'));
    const srcs = imgs
      .map((img) => img.getAttribute('src'))
      .filter((src) => !!src && !src.includes('map-placeholder.svg'));

    const preloadSome = () => {
      srcs.slice(0, 24).forEach((src) => {
        const i = new Image();
        i.decoding = 'async';
        i.src = src;
      });
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(preloadSome, { timeout: 1500 });
    } else {
      setTimeout(preloadSome, 200);
    }
  }

  precacheMapImages();
</script>
