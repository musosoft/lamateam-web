---
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/Accordion.astro';
import FaqNav from '../components/FaqNav.astro';
import mapsGenerated from '../data/maps.generated.json';

const MAP_PLACEHOLDER = '/assets/map-placeholder.svg';

interface MapCard {
  name: string;
  sourceImage: string;
  width: number;
  height: number;
}

const mapCards: MapCard[] = (mapsGenerated.items ?? []).map((it) => ({
  name: it.map,
  sourceImage: it.image,
  width: 320,
  height: 180,
}));
---

<Layout title="FAQ | Server">
  <h1 class="text-3xl font-bold text-center mb-4">Často kladené otázky</h1>
  <FaqNav current="server" />

  <div class="space-y-4 overflow-y-auto w-full max-w-7xl mx-auto">
    <Accordion id="maps" summary="Aktuální mapy na serveru">
      <p class="mb-4 text-gray-300">
        Seznam se načítá při buildu stejnou logikou jako <code>Get-CustomMapsFromCsv</code>
        v setup skriptu (sloupec <code>MAPA</code>, fallback index 1, deduplikace).
      </p>

      {
        mapCards.length === 0 ? (
          <p>Mapy se nepodařilo načíst.</p>
        ) : (
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
            {mapCards.map((mapCard, idx) => (
              <div
                class="group overflow-hidden rounded-xl border border-gray-700 bg-gray-900/70 shadow transition hover:-translate-y-0.5 hover:border-cyan-400/70"
                title={mapCard.name}
              >
                <img
                  src={mapCard.sourceImage}
                  alt={mapCard.name}
                  width={mapCard.width}
                  height={mapCard.height}
                  loading={idx < 8 ? 'eager' : 'lazy'}
                  fetchpriority={idx < 8 ? 'high' : 'auto'}
                  decoding="async"
                  data-map-image
                  onerror={`this.onerror=null;this.src='${MAP_PLACEHOLDER}';`}
                  class="h-24 w-full object-cover"
                />
                <div class="truncate border-t border-gray-800 px-2 py-2 text-center text-xs font-medium text-gray-200 group-hover:text-cyan-300">
                  {mapCard.name}
                </div>
              </div>
            ))}
          </div>
        )
      }
    </Accordion>

