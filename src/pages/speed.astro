---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<Layout title={t('Movement Speed | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('Weapon Movement Speed')}
      </h1>
    </header>
    <article class="panel fl-p-3/6 overflow-x-auto">
      <p class="fl-text-sm/base text-gray-300 fl-mb-3/5">
        {t('Compare running speed for each weapon.')}
      </p>
      <table class="w-full table-auto border-collapse border border-gray-600 rounded-lg contain-paint">
        <thead class="bg-gray-800">
          <tr>
            <th class="px-4 py-2 text-left font-semibold text-gray-200 border border-gray-700 uppercase">
              {t('Speed')}
            </th>
            <th class="px-4 py-2 text-left font-semibold text-gray-200 border border-gray-700 uppercase">
              {t('Weapon')}
            </th>
          </tr>
        </thead>
        <tbody class="bg-gray-800 text-gray-200 text-left">
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              260
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              Scout
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              250
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              Knife, pistols, C4, HE, Flash, MAC-10, MP5, TMP, UMP
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              245
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              P90, Smoke
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              240
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              XM1014
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              235
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              SG552
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              230
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              M4A1
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              221
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              AK-47, AUG
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              220
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              FAMAS, M249, M3
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              215
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              Galil
            </td>
          </tr>
          <tr class="hover:bg-gray-600">
            <td class="px-4 py-2 border border-gray-700" translate="no">
              210
            </td>
            <td class="px-4 py-2 border border-gray-700" translate="no">
              AWM, G3SG1, SG550
            </td>
          </tr>
        </tbody>
      </table>
    </article>
  </section>
</Layout>
