---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
const thumbnails = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/weapons/*.png',
  { eager: true },
);
const speedRows = [
  { speed: 260, weapons: [['scout', 'Scout']] },
  {
    speed: 250,
    weapons: [
      ['knives', 'Knife'],
      ['glock16', 'Glock 18'],
      ['usp', 'USP'],
      ['p228', 'P228'],
      ['deagle', 'Desert Eagle'],
      ['es57', 'Five-seveN'],
      ['beretta', 'Dual Berettas'],
      ['c4', 'C4'],
      ['frag', 'HE grenade'],
      ['flashbang', 'Flashbang'],
      ['mac10', 'MAC-10'],
      ['mp5', 'MP5'],
      ['tmp', 'TMP'],
      ['ump', 'UMP'],
    ],
  },
  {
    speed: 245,
    weapons: [
      ['p90', 'P90'],
      ['smoke', 'Smoke grenade'],
    ],
  },
  { speed: 240, weapons: [['xm1014', 'XM1014']] },
  { speed: 235, weapons: [['sg-552', 'SG552']] },
  { speed: 230, weapons: [['m4a1', 'M4A1']] },
  {
    speed: 221,
    weapons: [
      ['ak47', 'AK-47'],
      ['aug', 'AUG'],
    ],
  },
  {
    speed: 220,
    weapons: [
      ['famas', 'FAMAS'],
      ['m249', 'M249'],
      ['m3', 'M3'],
    ],
  },
  { speed: 215, weapons: [['galil', 'Galil']] },
  {
    speed: 210,
    weapons: [
      ['awp', 'AWM / AWP'],
      ['sg-1', 'G3SG1'],
      ['sg-550', 'SG550'],
    ],
  },
];
const slowest = Math.min(...speedRows.map(({ speed }) => speed));
const fastest = Math.max(...speedRows.map(({ speed }) => speed));
// Relative comparison, not a zero-based measurement: keep the slowest visible.
const relativeFill = (speed: number) =>
  2 + ((speed - slowest) / (fastest - slowest)) * 98;
---

<Layout title={t('Movement Speed | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('Weapon Movement Speed')}
      </h1>
    </header>
    <article class="panel fl-p-3/6">
      <p class="fl-text-sm/base text-gray-300 fl-mb-3/5">
        {t('Compare running speed for each weapon.')}
      </p>
      <table class="speed-table">
        <thead>
          <tr>
            <th scope="col">{t('Speed')}</th>
            <th scope="col">{t('Weapon')}</th>
          </tr>
        </thead>
        <tbody>
          {speedRows.map(({ speed, weapons }) => (
            <tr>
              <td
                class="speed-value"
                style={`--speed-fill: ${relativeFill(speed)}%`}
                translate="no"
              >
                {speed}
              </td>
              <td>
                <div class="weapon-thumbnails">
                  {weapons.map(([id, name]) => (
                    <Image
                      src={
                        thumbnails[`../assets/weapons/Css_${id}.png`].default
                      }
                      alt={`${t('Weapon')}: ${name}`}
                      title={name}
                      width={112}
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </article>
  </section>
</Layout>
<style>
  .speed-table {
    width: 100%;
    border-collapse: collapse;
    background: #182334;
    color: #f3f4f6;
  }
  .speed-table th,
  .speed-table td {
    padding: 0.75rem;
    border: 1px solid #374151;
    text-align: left;
  }
  .speed-table th {
    font-weight: 600;
  }
  .speed-value {
    width: clamp(5rem, 20vw, 11rem);
    background-image: linear-gradient(
      to right,
      #28564f var(--speed-fill),
      transparent var(--speed-fill)
    );
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }
  .weapon-thumbnails {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .weapon-thumbnails :global(img) {
    width: clamp(4rem, 12vw, 7rem);
    height: 4rem;
    object-fit: contain;
  }
  @media (forced-colors: active) {
    .speed-value {
      background-image: none;
    }
  }
</style>
