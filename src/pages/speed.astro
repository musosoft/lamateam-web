---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rychlost | LaMaTeam">
  <section class="mx-auto w-full max-w-5xl px-4 py-8 text-left text-gray-100">
    <header class="mb-6 rounded-2xl border border-gray-700 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 shadow-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">Běžím s knifem rychleji?</h1>
      <p class="mt-2 text-sm text-gray-300 md:text-base">Áno. Tu máš prehľad movement speed podľa zbrane.</p>
    </header>
    <article class="rounded-2xl border border-gray-700 bg-gray-900/80 p-5 shadow-lg overflow-x-auto">
      <table class="w-full table-auto border-collapse border border-gray-600 rounded-lg contain-paint">
        <thead class="bg-gray-800"><tr><th class="px-4 py-2 text-left font-semibold text-gray-200 border border-gray-700 uppercase">Rychlost</th><th class="px-4 py-2 text-left font-semibold text-gray-200 border border-gray-700 uppercase">Zbraň</th></tr></thead>
        <tbody class="bg-gray-800 text-gray-200 text-left">
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">260</td><td class="px-4 py-2 border border-gray-700">Scout</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">250</td><td class="px-4 py-2 border border-gray-700">Knife, pistole, C4, HE, Flash, MAC-10, MP5, TMP, UMP</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">245</td><td class="px-4 py-2 border border-gray-700">P90, Smoke</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">240</td><td class="px-4 py-2 border border-gray-700">XM1014</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">235</td><td class="px-4 py-2 border border-gray-700">SG552</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">230</td><td class="px-4 py-2 border border-gray-700">M4A1</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">221</td><td class="px-4 py-2 border border-gray-700">AK-47, AUG</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">220</td><td class="px-4 py-2 border border-gray-700">FAMAS, M249, M3</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">215</td><td class="px-4 py-2 border border-gray-700">Galil</td></tr>
          <tr class="hover:bg-gray-600"><td class="px-4 py-2 border border-gray-700">210</td><td class="px-4 py-2 border border-gray-700">AWM, G3SG1, SG550</td></tr>
        </tbody>
      </table>
    </article>
  </section>
</Layout>
