---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { env } from "cloudflare:workers";

const baseUrl = env.PUBLIC_BASE_URL || "/";

const STEAM_API_KEY = env.STEAM_API_KEY;

const cookies = Astro.cookies;

function parseSessionCookie() {
  const raw = cookies.get("session")?.value;
  if (!raw) return {};
  try {
    return JSON.parse(decodeURIComponent(raw));
  } catch {
    return {};
  }
}

const userAgent = Astro.request.headers.get("user-agent")?.toLowerCase() || "";
const isGame = userAgent.includes("valve") || userAgent.includes("steam");

const queryCommunityId = Astro.url.searchParams.get("communityid") || "";
const queryPlayerName = Astro.url.searchParams.get("name") || "";
const rawCommunityId = queryCommunityId || cookies.get("communityid")?.value || "";
const rawPlayerName = queryPlayerName || cookies.get("name")?.value || "";
const motdQuery =
  isGame && rawCommunityId && rawPlayerName
    ? `?communityid=${encodeURIComponent(rawCommunityId)}&name=${encodeURIComponent(rawPlayerName)}`
    : "";

function convertToSteam64(communityId: string): string {
  const match = communityId.match(/^\[U:1:(\d+)\]$/);
  if (match) {
    return (BigInt(match[1]) + BigInt("76561197960265728")).toString();
  }
  return communityId;
}

const session = parseSessionCookie();

let steamID = "";
let playerName = "Guest";

if (isGame && rawCommunityId) {
  steamID = convertToSteam64(rawCommunityId);
  playerName = rawPlayerName || "Guest";
} else {
  steamID = session?.steamID || "";
  playerName = session?.playerName || "Guest";
}

const isAuthenticated = !!(steamID && playerName !== "Guest");

async function fetchSteamAvatar(steam64: string) {
  if (!STEAM_API_KEY) {
    console.error("STEAM_API_KEY is not set.");
    return "/assets/default-avatar.webp";
  }
  try {
    const url = `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/?key=${STEAM_API_KEY}&steamids=${steam64}`;
    const resp = await fetch(url);
    if (!resp.ok) {
      console.error("Steam API error:", resp.status);
      return "/assets/default-avatar.webp";
    }
    const data = (await resp.json()) as {
      response?: { players?: Array<{ avatarfull?: string }> };
    };
    return data.response?.players?.[0]?.avatarfull || "/assets/default-avatar.webp";
  } catch (error) {
    console.error("Error fetching avatar from Steam:", error);
    return "/assets/default-avatar.webp";
  }
}

let playerAvatar = "/assets/default-avatar.webp";

if (steamID) {
  playerAvatar = await fetchSteamAvatar(steamID);
}

const pages = [
  { title: 'Mapy', description: 'Aktuální mapy na serveru.', link: '/maps', icon: 'mdi:map' },
  { title: 'Peníze', description: 'Kompletní money systém CS:S.', link: '/money', icon: 'mdi:cash-multiple' },
  { title: 'Hitreg', description: 'Hitboxy, rates a netgraph vysvětlení.', link: '/hitreg-rates', icon: 'mdi:crosshairs-gps' },
  { title: 'Fixy FPS', description: 'Rychlé fixy pro FPS/radar/zvuk.', link: '/performance-fixes', icon: 'mdi:wrench-cog' },
  { title: 'Demo', description: 'Jak nahrát vlastní demo.', link: '/demo-recording', icon: 'mdi:record-rec' },
  { title: 'SourceTV', description: 'Stažení SourceTV dem souborů.', link: '/sourcetv-demos', icon: 'mdi:download-network' },
  { title: 'Rychlost', description: 'Rychlosti pohybu podle zbraně.', link: '/movement-speed', icon: 'mdi:run-fast' },
  { title: 'Supporters', description: 'Kdo podpořil server.', link: '/supporters', icon: 'mdi:heart' },
  { title: 'Admini', description: 'Seznam adminů.', link: '/admins', icon: 'mdi:shield-account' },
  { title: 'Admin pravidla', description: 'Administrátorská pravidla.', link: '/admin-rules', icon: 'mdi:scale-balance' },
  { title: 'Banlist', description: 'Seznam banů hráčů.', link: '/banlist', icon: 'mdi:ban' },
  { title: 'Kontakt', description: 'Kontakt a podpora.', link: '/contact', icon: 'mdi:card-account-mail' },
].map((page) => ({
  ...page,
  link:
    motdQuery && page.link.startsWith('/') && !page.link.startsWith('/api/')
      ? `${page.link}${motdQuery}`
      : page.link,
}));
---

<Layout title="Home">
  {
    isAuthenticated ? (
      <div class="flex items-center space-x-4 mb-8 justify-center">
        <img
          src={playerAvatar}
          alt="Player Avatar"
          class="w-14 h-14 rounded-full border-2 border-gray-700"
        />
        <h1 class="text-lg font-bold text-white">
          <strong>{playerName}</strong>, vítej na LaMaTeam!
        </h1>
      </div>
    ) : (
      <h1 class="fl-text-lg/3xl font-bold text-center text-white mb-8">
        Vítej na LaMaTeam!
      </h1>
    )
  }

  <div class="grid grid-cols-6 gap-2 fl-mb-0/8">
    {
      pages.map((page) => (
        <a
          href={page.link}
          class="group relative flex min-h-20 flex-col items-center justify-center rounded-lg bg-gray-800 p-2 text-center shadow-lg transition hover:-translate-y-0.5 hover:bg-gray-700"
          data-astro-prefetch="load"
          title={page.description}
          aria-label={`${page.title} — ${page.description}`}
        >
          <div class="text-2xl text-indigo-400 transition group-hover:text-indigo-300">
            <Icon name={page.icon} />
          </div>
          <h2 class="mt-1 text-[11px] font-semibold leading-tight text-white sm:text-xs">
            {page.title}
          </h2>
          <span class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 hidden w-40 -translate-x-1/2 rounded-md bg-black/85 px-2 py-1 text-[10px] text-gray-100 shadow-lg group-hover:block group-focus-visible:block">
            {page.description}
          </span>
        </a>
      ))
    }
  </div>

  <!-- Integrated Shoutbox below -->
  <section class="mx-auto w-full px-2 py-4 bg-gray-900 rounded-md">
    {
      !isAuthenticated ? (
        <div class="mb-4">
          <a href="/api/auth/steam" class="text-blue-500 underline">
            Přihlaste se přes Steam, abyste mohli psát zprávy do Shoutboxu.
          </a>
        </div>
      ) : (
        <> </>
      )
    }

    <form
      id="shoutboxForm"
      class="flex gap-4 items-center mb-6"
      onsubmit="return false;"
    >
      <input
        type="text"
        id="messageInput"
        placeholder=`Co máš na umě ${playerName}? ;)`
        class="flex-1 p-3 rounded-md border border-gray-600 bg-gray-800 text-white"
        autocomplete="off"
        disabled={!isAuthenticated}
      />
      <button
        type="button"
        id="sendButton"
        class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md"
        disabled={!isAuthenticated}
      >
        Odeslat
      </button>
    </form>

    <div
      id="shoutboxMessages"
      class="fl-max-h-64/96 overflow-y-auto fl-p-0/4 bg-gray-800 rounded-md"
    >
      <!-- Messages will be loaded dynamically -->
    </div>
  </section>

  <!-- 3) Inline script that has access to these server variables: baseUrl, playerName, playerAvatar, steamID -->
  <!--    define:vars automatically JSON-serializes them so you can reference them by name. -->
  <script is:inline define:vars={{ baseUrl, steamID, playerName, playerAvatar }}
  >
    // This code runs in the client, after the DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      const messageInput = document.getElementById('messageInput');
      const sendButton = document.getElementById('sendButton');
      const shoutboxMessages = document.getElementById('shoutboxMessages');

      // Make sure baseUrl has a trailing slash
      const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';

      // Convert a timestamp to "how long ago" string
      function timeSince(timestamp) {
        const now = Date.now();
        const diffTime = now - new Date(timestamp).getTime();
        if (isNaN(diffTime)) return 'Neplatný čas';

        const seconds = Math.floor(diffTime / 1000);
        const minutes = Math.floor(seconds / 60);
        const hours = Math.floor(minutes / 60);
        const days = Math.floor(hours / 24);
        const months = Math.floor(days / 30);
        const years = Math.floor(days / 365);

        if (years > 0)
          return `${years} rok${years > 1 && years < 5 ? 'y' : years > 4 ? 'ů' : ''}`;
        if (months > 0)
          return `${months} měsíc${months > 1 && months < 5 ? 'e' : months > 4 ? 'ů' : ''}`;
        if (days > 0) {
          if (days === 1) return '1 den';
          if (days > 1 && days < 5) return `${days} dny`;
          return `${days} dní`;
        }
        if (hours > 0)
          return `${hours} hodin${hours > 1 && hours < 5 ? 'y' : ''}`;
        if (minutes > 0)
          return `${minutes} minut${minutes > 1 && minutes < 5 ? 'y' : ''}`;
        return `${seconds} sekund${seconds > 1 && seconds < 5 ? 'y' : ''}`;
      }

      // Render messages into the DOM
      function renderMessages(messages) {
        shoutboxMessages.innerHTML = '';
        messages.forEach(
          ({ player_avatar, player_name, message, timestamp }) => {
            shoutboxMessages.insertAdjacentHTML(
              'beforeend',
              `<div class="flex items-center space-x-4 mb-4">
               <img
                 src="${player_avatar || '/assets/default-avatar.webp'}"
                 alt="Player Avatar"
                 class="w-8 h-8 rounded-full"
               />
               <div class="flex flex-1">
                 <p class="text-white"><strong>${player_name}</strong>: ${message}</p>
                 <p class="text-gray-400 text-sm ml-auto">${timeSince(timestamp)}</p>
               </div>
             </div>`,
            );
          },
        );
      }

      // Load recent messages from /api/shoutbox
      async function fetchMessages() {
        try {
          const resp = await fetch(`${normalizedBaseUrl}api/shoutbox`);
          if (!resp.ok) {
            throw new Error(`HTTP error! status: ${resp.status}`);
          }
          const messages = await resp.json();
          renderMessages(messages);
        } catch (error) {
          console.error('Error fetching messages:', error);
        }
      }

      // Submit a new message to /api/shoutbox
      async function handleSubmit() {
        const msg = messageInput.value.trim();
        if (!msg) return;

        try {
          const resp = await fetch(`${normalizedBaseUrl}api/shoutbox`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              steamid: steamID,
              player_name: playerName,
              player_avatar: playerAvatar,
              message: msg,
            }),
          });
          if (!resp.ok) {
            throw new Error(`HTTP error! status: ${resp.status}`);
          }
          messageInput.value = '';
          fetchMessages();
        } catch (err) {
          console.error('Error submitting message:', err);
        }
      }

      sendButton?.addEventListener('click', handleSubmit);

      // Initial load of messages
      fetchMessages();
    });
  </script>
</Layout>
