---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

// 1) SERVER-SIDE LOGIC (similar to shoutbox.astro)
const baseUrlValue =
  Astro.locals.runtime.env.PUBLIC_SITE_URL ||
  import.meta.env.PUBLIC_SITE_URL ||
  '/';
const STEAM_API_KEY =
  Astro.locals.runtime.env.STEAM_API_KEY ||
  import.meta.env.STEAM_API_KEY;

const cookies = Astro.cookies;

// Helper to parse the "session" cookie
function parseSessionCookie() {
  const raw = cookies.get('session')?.value;
  if (!raw) return {};
  try {
    return JSON.parse(decodeURIComponent(raw));
  } catch {
    return {};
  }
}

// Check user-agent for in-game scenario
const userAgent = Astro.request.headers.get('user-agent')?.toLowerCase() || '';
const isGame = userAgent.includes('valve') || userAgent.includes('steam');

// Possibly set by in-game environment
const rawCommunityId = cookies.get('communityid')?.value || '';
const rawPlayerName = cookies.get('name')?.value || '';

function convertToSteam64(communityId: string) {
  const match = communityId.match(/^\[U:1:(\d+)\]$/);
  if (match) {
    return (BigInt(match[1]) + BigInt('76561197960265728')).toString();
  }
  return communityId; // if it's already 64-bit
}

const session = parseSessionCookie();

// Decide final steamID & playerName
let steamIDValue = '';
let playerNameValue = 'Guest';

if (isGame && rawCommunityId) {
  // In-game scenario
  steamIDValue = convertToSteam64(rawCommunityId);
  playerNameValue = rawPlayerName || 'Guest';
} else {
  // Normal browser scenario from session
  steamIDValue = session?.steamID || '';
  playerNameValue = session?.playerName || 'Guest';
}

// Check if user is “authenticated”
const isAuthenticated = Boolean(steamIDValue && playerNameValue !== 'Guest');

// If we have steamID, try fetching the avatar from Steam
async function fetchSteamAvatar(steam64: string) {
  if (!STEAM_API_KEY) {
    console.error('STEAM_API_KEY is not set.');
    return '/assets/default-avatar.webp';
  }
  try {
    const steamApiUrl = `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/?key=${STEAM_API_KEY}&steamids=${steam64}`;
    const resp = await fetch(steamApiUrl);
    if (!resp.ok) {
      console.error('Steam API error:', resp.status);
      return '/assets/default-avatar.webp';
    }
    const data = await resp.json();
    return data.response.players[0]?.avatarfull || '/assets/default-avatar.webp';
  } catch (err) {
    console.error('Error fetching avatar from Steam:', err);
    return '/assets/default-avatar.webp';
  }
}

let playerAvatarValue = '/assets/default-avatar.webp';
if (steamIDValue) {
  playerAvatarValue = await fetchSteamAvatar(steamIDValue);
}

// 2) PAGE DATA
const pages = [
  {
    title: 'Seznam banů',
    description: 'Zobrazte si nejnovější provinilce.',
    link: '/banlist',
    icon: 'mdi:ban',
  },
  {
    title: 'Statistiky',
    description: 'Prohlédněte si statistiky hráčů a žebříčky.',
    link: '/stats',
    icon: 'mdi:chart-bar',
  },
  {
    title: 'Kontakt',
    description: 'Kontaktujte nás pro podporu nebo dotazy.',
    link: '/contact',
    icon: 'mdi:card-account-mail',
  },
  {
    title: 'VIP',
    description: 'Exkluzivní funkce a výhody pro VIP členy.',
    link: '/vip',
    icon: 'mdi:star-outline',
  },
  {
    title: 'Pravidla',
    description: 'Přečtěte si pravidla a pokyny komunity.',
    link: '/rules',
    icon: 'mdi:book',
  },
  {
    title: 'Příkazy',
    description: 'Naučte se užitečné příkazy do hry.',
    link: '/info',
    icon: 'mdi:information-outline',
  },
  {
    title: 'Shoutbox',
    description: 'Zapojte se do konverzace ve shoutboxu.',
    link: '/shoutbox',
    icon: 'mdi:message-outline',
  },
  {
    title: 'Připojení',
    description: 'Připojte se na server rychle z prohlížeče.',
    link: '/connect',
    icon: 'mdi:connection',
  },
  {
    title: 'Často kladené dotazy',
    description: 'Často kladené otázky a další informace.',
    link: '/faq',
    icon: 'mdi:frequently-asked-questions',
  },
];
---

<Layout title="Welcome to LaMaTeam">
  <!-- Conditional heading or user avatar + name -->
  {
    isAuthenticated ? (
      <div class="flex items-center space-x-4 mb-8 justify-center">
        <img
          src={playerAvatarValue}
          alt="Avatar hráče"
          class="w-14 h-14 rounded-full border-2 border-gray-700"
        />
        <h1 class="text-lg font-bold text-white">
          Vítej <strong>{playerNameValue}</strong> na LaMaTeam!
        </h1>
      </div>
    ) : (
  <h1 class="~text-lg/3xl font-bold text-center text-white mb-8">
    Vítej na LaMaTeam!
  </h1>
    )
  }

  <!-- The grid of pages/links -->
  <div class="grid grid-cols-3 ~gap-2/6">
    {
      pages.map((page) => (
        <a
          href={page.link}
          class="group flex flex-col items-center justify-center bg-gray-800 hover:bg-gray-700 rounded-lg shadow-lg overflow-hidden transform hover:-translate-y-1 transition-all duration-200 ~p-2/4 text-center"
          data-astro-prefetch="load"
        >
          <div class="~text-lg/4xl text-indigo-400 mb-4 group-hover:text-indigo-300 transition">
            <Icon name={page.icon} />
          </div>
          <h2 class="~text-sm/xl font-semibold text-white mb-2">
            {page.title}
          </h2>
          <p class="~text-xs/sm text-gray-300">{page.description}</p>
        </a>
      ))
    }
  </div>
</Layout>
