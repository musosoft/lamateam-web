---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../assets/hero.svg?raw';
import Shoutbox from '../components/Shoutbox.astro';

const cookies = Astro.cookies;
const sessionCookie = cookies.get('session');
const session = sessionCookie ? JSON.parse(decodeURIComponent(sessionCookie.value)) : {};
const isAuthenticated = Boolean(session?.steamID);
const userName = session?.steamID ? `Player ${session.steamID}` : "Guest";
const baseUrl = import.meta.env.BASE_URL || process.env.BASE_URL || '/';

// Log environment variables
console.log('Server-side Environment Variables:', {
  BASE_URL: import.meta.env.BASE_URL || process.env.BASE_URL,
  STEAM_API_KEY: import.meta.env.STEAM_API_KEY || process.env.STEAM_API_KEY,
  TURSO_DATABASE_URL: import.meta.env.TURSO_DATABASE_URL || process.env.TURSO_DATABASE_URL,
  TURSO_AUTH_TOKEN: import.meta.env.TURSO_AUTH_TOKEN || process.env.TURSO_AUTH_TOKEN,
});
---

<Layout title="Welcome to LaMaTeam" isAuthenticated={isAuthenticated} userName={userName} hero={Hero}>
  <div class="relative hidden group-hover:flex h-full mx-4 w-full max-w-3xl animate-fade-in-up p-8 items-center">
    <div class="bg-gray-800 shadow-lg rounded-lg grow">
      <div class="relative flex flex-col h-full w-full overflow-hidden rounded-lg">
        <div class="relative z-10 flex flex-col h-full justify-center gap-8 p-8 text-center text-white">

          <!-- Header Section with Navigation & Login Buttons -->
          <div class="fixed top-1 left-0 right-0 max-w-4xl mx-auto grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
            <a id="rulesBtn" href="#" class="flex items-center justify-center rounded-lg bg-gray-700 px-6 py-3 font-medium transition hover:bg-indigo-600">Pravidla</a>
            <a id="infoBtn" href="#" class="flex items-center justify-center rounded-lg bg-gray-700 px-6 py-3 font-medium transition hover:bg-indigo-600">Prikazy</a>
            <a id="vipBtn" href="#" class="flex items-center justify-center rounded-lg bg-gray-700 px-6 py-3 font-medium transition hover:bg-indigo-600">VIP</a>
          </div>

          <!-- Content Sections -->
          <div id="shoutbox" class="space-y-4 hidden">
            <Shoutbox session={session} baseUrl={baseUrl} />
          </div>

          <!-- Additional sections -->
          <div id='rules' class='space-y-4'>
            <h1 class='mb-4 font-bold tracking-tight text-4xl'>Zákaz:</h1>
            <span class='text-yellow-500'>- T kemp na DE mapách déle jak 30 sekund - (SLAY)</span><br />
            <span class='text-yellow-500'>- SPAM (voice,chat) - (KICK/BAN)</span><br />
            <span class='text-yellow-500'>- Opětovné nakupování - (KICK/BAN)</span><br />
            <span class='text-yellow-500'>- Sprostá mluva, nadávky, urážky, rasismus bez nadsázky - (BAN)</span><br />
            <span class='text-yellow-500'>- kradení nicků, napodobování, vydávání se za admina (BAN)</span><br />
            <span class='text-yellow-500'>- používání cheatů (PERMABAN)</span><br />
            <span class='text-yellow-500'>- BHOP / více jak dva skoky (SLAY/KICK/BAN)</span><br /><br />
            <span class='text-red-500'>!!! NEZNALOST PRAVIDEL NEOMLOUVÁ !!!</span><br /><br /><br />
            <span class='text-red-500'>!!! ÚPLNÁ PRAVIDLA NA LAMATEAM.EU !!!</span>
          </div>
          <div id='info' class='space-y-4 hidden'>
            <h1 class='mb-4 font-bold tracking-tight text-4xl'>Užitečné informace:</h1>
            <span class='text-yellow-500'>Pro odstrčení od hráče napiš do chatu </span>
            <span class='text-green-500'>!nb</span>
            <span class='text-yellow-500'><br />Pokud chceš ve hře zobrazit tohle okno, napiš </span>
            <span class='text-green-500'>!motd</span>
            <span class='text-yellow-500'><br />Pokud máš připomínky, nápady na zlepšení, nebo chceš nahlásit podvádějícího či jinak hru znepříjemňujícího hráče, </span>
            <a class='text-green-500' href='http://lamateam.eu/contact.php'>napiš nám</a>
            <span class='text-yellow-500'><br />- - - - - - - - - - -<br />Chceš nahrát demo na cheatera?<br />Otevři konzoli a napiš </span>
            <span class='text-red-500'>record název_dema<br /></span>
            <span class='text-yellow-500'>Když chceš nahrávání ukončit, napiš </span>
            <span class='text-red-500'>stop</span>
            <span class='text-yellow-500'
              ><br />Nahrané demo najdeš v hlavním adresáři hry (/cstrike)<br />Pošli ho adminům!<br />- - - - - - - - - - -<br />Majitelem serveru crazy69 | Hosting zabezpečuje
              FakaHeda.eu<br />Najdeš nás taky na discordu a na facebooku - hledej:
            </span>
            <span class='text-red-500'><a href='https://www.facebook.com/groups/437402000675912'>LaMaTeAm.eu</a></span>
          </div>
          <div id='vip' class='space-y-4 hidden'>
            <h1 class='mb-4 font-bold tracking-tight text-4xl'>Chceš se stát VIP?</h1>
            <span class='text-yellow-500'>Chceš nás sponzorovat a vždy se připojit, když je plný server? Podpoř nás:</span><br />
            <span class='text-yellow-500'>1 měsíc = 100 Kč</span><br />
            <span class='text-yellow-500'>6 měsíců = 300 Kč</span><br />
            <span class='text-yellow-500'>12 mesíců = 500 Kč</span><br /><br />
            <span class='text-yellow-500'>Peníze můžete zasílat na číslo účtu: 1939775153/0800</span><br />
            <span class='text-yellow-500'>(IBAN CZ88 0800 0000 0019 3977 5153)</span><br />
            <span class='text-yellow-500'>Do informace pro příjemce uveď svůj nick, ať víme kdo poslal příspěvek.</span><br />
            <span class='text-yellow-500'>Podpořit provoz serveru můžeš i zcela nezjištně i libovolnou částkou. Napiš nám a určitě se dohodneme</span><br /><br />
            <span class='text-yellow-500'>PŘIPOJIT DO VIP SLOTU LZE V KONZOLE: </span>
            <span class='text-red-500'>connect 82.208.17.101:27516</span>
          </div>

          <!-- Footer Links -->
          <div class="fixed bottom-1 left-0 right-0 max-w-4xl mx-auto grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
            <a href="https://sourcebans.fakaheda.eu/sbans_336496/" class="flex items-center justify-center rounded-lg bg-gray-700 px-6 py-3 font-medium transition hover:bg-indigo-600">Banlist</a>
            <a href="https://stats.lamateam.eu" class="flex items-center justify-center rounded-lg bg-gray-700 px-6 py-3 font-medium transition hover:bg-indigo-600">Stats</a>
            <a id="shoutboxBtn" href="#" class="flex items-center justify-center rounded-lg bg-gray-700 px-6 py-3 font-medium transition hover:bg-indigo-600">Shoutbox</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const userAgent = navigator.userAgent;
    const isGame = userAgent.includes('Valve Client'); // In-game detection for Valve client
    const mainContent = document.getElementById('main-content');

    // Apply or remove bg-opacity-0 based on userAgent detection
    if (isGame && mainContent) {
      mainContent.classList.add('bg-opacity-0');
    }

    // Toggle visibility of sections
    const shoutbox = document.getElementById('shoutbox');
    const rules = document.getElementById('rules');
    const info = document.getElementById('info');
    const vip = document.getElementById('vip');
    const buttons = {
      shoutboxBtn: document.getElementById('shoutboxBtn'),
      rulesBtn: document.getElementById('rulesBtn'),
      infoBtn: document.getElementById('infoBtn'),
      vipBtn: document.getElementById('vipBtn'),
    };

    function showSection(section) {
      [shoutbox, rules, info, vip].forEach(sec => sec?.classList.add('hidden'));
      section?.classList.remove('hidden');
    }

    buttons.shoutboxBtn?.addEventListener('click', () => showSection(shoutbox));
    buttons.rulesBtn?.addEventListener('click', () => showSection(rules));
    buttons.infoBtn?.addEventListener('click', () => showSection(info));
    buttons.vipBtn?.addEventListener('click', () => showSection(vip));
  });
</script>
