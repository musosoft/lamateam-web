---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const pages = [
  {
    title: 'Seznam banů',
    description: 'Zobrazte si nejnovější provinilce.',
    link: '/banlist',
    icon: 'mdi:ban',
  },
  {
    title: 'Statistiky',
    description: 'Prohlédněte si statistiky hráčů a žebříčky.',
    link: '/stats',
    icon: 'mdi:chart-bar',
  },
  {
    title: 'Kontakt',
    description: 'Kontaktujte nás pro podporu nebo dotazy.',
    link: '/contact',
    icon: 'mdi:card-account-mail',
  },
  {
    title: 'VIP',
    description: 'Exkluzivní funkce a výhody pro VIP členy.',
    link: '/vip',
    icon: 'mdi:star-outline',
  },
  {
    title: 'Pravidla',
    description: 'Přečtěte si pravidla a pokyny komunity.',
    link: '/rules',
    icon: 'mdi:book',
  },
  {
    title: 'Příkazy',
    description: 'Naučte se užitečné příkazy do hry.',
    link: '/info',
    icon: 'mdi:information-outline',
  },
  {
    title: 'Shoutbox',
    description: 'Zapojte se do konverzace ve shoutboxu.',
    link: `/shoutbox`,
    icon: 'mdi:message-outline',
  },
  {
    title: 'Připojení',
    description: 'Připojte se na server rychle z prohlížeče.',
    link: '/connect',
    icon: 'mdi:connection',
  },
  {
    title: 'Často kladené dotazy',
    description: 'Často kladené otázky a další informace.',
    link: '/faq',
    icon: 'mdi:frequently-asked-questions',
  },
];
---

<Layout title="Welcome to LaMaTeam">
  <h1 class="~text-lg/3xl font-bold text-center text-white mb-8">
    Vítej na LaMaTeam
  </h1>
  <div class="grid grid-cols-3 ~gap-2/6">
    {
      pages.map((page) => (
        <a
          href={page.link}
          class="group flex flex-col items-center justify-center bg-gray-800 hover:bg-gray-700 rounded-lg shadow-lg overflow-hidden transform hover:-translate-y-1 transition-all duration-200 ~p-2/4 text-center"
          data-astro-prefetch="load"
        >
          <div class="~text-lg/4xl text-indigo-400 mb-4 group-hover:text-indigo-300 transition">
            <Icon name={page.icon} />
          </div>
          <h2 class="~text-sm/xl font-semibold text-white mb-2">
            {page.title}
          </h2>
          <p class="~text-xs/sm text-gray-300">{page.description}</p>
        </a>
      ))
    }
  </div>
</Layout>
