---
import Rules from '../rules.astro';
import Maps from '../maps.astro';
import Commands from '../commands.astro';
import Money from '../money.astro';
import Hitreg from '../hitreg.astro';
import Fixes from '../fixes.astro';
import Speed from '../speed.astro';
import SourceTV from '../sourcetv.astro';
import Admins from '../admins.astro';
import Vip from '../vip.astro';
import Contact from '../contact.astro';
import Connect from '../connect.astro';
import {
  isLocale,
  pageFromSlug,
  legacyLocaleRedirect,
} from '../../lib/localized-content';

export const prerender = false;
const pages = {
  connect: Connect,
  rules: Rules,
  maps: Maps,
  commands: Commands,
  money: Money,
  hitreg: Hitreg,
  fixes: Fixes,
  speed: Speed,
  sourcetv: SourceTV,
  admins: Admins,
  vip: Vip,
  contact: Contact,
};
const slug = Astro.params.page;
const locale = Astro.params.locale;
if (!isLocale(locale) || !slug) {
  return new Response('Not found', { status: 404 });
}
const page = pageFromSlug(locale, slug);
if (!page || page === 'home') return new Response('Not found', { status: 404 });
const redirect = legacyLocaleRedirect(Astro.url);
if (redirect) return Astro.redirect(redirect, 308);
const Page = pages[page];
---

<Page locale={locale} />
