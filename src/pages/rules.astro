---
// src/pages/rules.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pravidla">
  <h1
    class="mb-6 text-4xl font-extrabold tracking-tight text-center text-gray-900"
  >
    Pravidla Serveru
  </h1>

  <div class="overflow-x-auto">
    <table
      class="w-full table-auto border-collapse border border-gray-600 rounded-lg contain-paint"
    >
      <thead class="bg-gray-800">
        <tr>
          <th
            class="px-4 py-2 text-left font-semibold text-gray-200 border border-gray-700 uppercase"
            >Zákaz</th
          >
          <th
            class="px-4 py-2 text-left font-semibold text-gray-200 border border-gray-700 uppercase"
            >Postih</th
          >
        </tr>
      </thead>
      <tbody class="bg-gray-800 text-gray-200 text-left">
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ cheaty, scripty, externí programy a nastavení zvýhodňující hráče
            oproti ostatním</td
          >
          <td class="px-4 py-2 border border-gray-700">⛔</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ nadávky, rasismus, vyhrožování, politizování či ponižování
            jiných hráčů a menšin</td
          >
          <td class="px-4 py-2 border border-gray-700">🔇⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ úmyslný team attack, kill, flash, blokování spoluhráčů</td
          >
          <td class="px-4 py-2 border border-gray-700">⚡🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ kempení na spawnu: plant mapy - T po 1:30 / hostage mapy - CT po
            1:45</td
          >
          <td class="px-4 py-2 border border-gray-700">⚡</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ používání nevhodného spraye nebo nicku, reklama</td
          >
          <td class="px-4 py-2 border border-gray-700">🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ bugování map/serveru, defus přes stěnu, reconnect do stejného
            kola, zneužívání herních chyb</td
          >
          <td class="px-4 py-2 border border-gray-700">🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ nakupování více než 1 HE, 2 Flashbangů</td
          >
          <td class="px-4 py-2 border border-gray-700">🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ vydávání se za admina, kradení nicků atp.</td
          >
          <td class="px-4 py-2 border border-gray-700">⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ BHOP / Strafe Jumping apod. více než dva skoky</td
          >
          <td class="px-4 py-2 border border-gray-700">⚡🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ spamování příkazů, chatu, voice a neustálé navádění hráčů na
            rtv, votemap</td
          >
          <td class="px-4 py-2 border border-gray-700">🔇🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ obcházení banu nebo opakované porušování pravidel</td
          >
          <td class="px-4 py-2 border border-gray-700">⛔</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ napomáhání a radění hráčům z nepřátelského týmu a radění po
            smrti či ze spectu</td
          >
          <td class="px-4 py-2 border border-gray-700">🔇🦵⏳</td>
        </tr>
        <tr class="hover:bg-gray-600">
          <td class="px-4 py-2 border border-gray-700"
            >❌ ignorování úloh týmu (hostage, bomba) - hráč, který zabije
            posledního žijícího teroristu má právo na defuze Bomby, pokud to
            stíhá</td
          >
          <td class="px-4 py-2 border border-gray-700">⚡🦵⏳</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="mt-6 text-center text-red-600 font-semibold">
    NEZNALOST PRAVIDEL NEOMLOUVÁ! Hráči mají právo podat protest prostřednictvím
    formuláře. Nepište stížnosti přímo majiteli serveru.
  </p>
</Layout>
