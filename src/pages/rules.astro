---
import Layout from '../layouts/Layout.astro';
import ServerRules from '../components/ServerRules.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<Layout
  title={t('Rules | LaMaTeAm')}
  lang={locale}
  description={t(
    'LaMaTeAm CS:S server rules — prohibited actions and penalties.',
  )}
>
  <ServerRules locale={locale} />
</Layout>
