---

<Layout title={t('VIP | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('VIP & Server Support')}
      </h1>
    </header>
    <article class="space-y-3 panel fl-p-3/6 text-gray-200">
      <p class="text-yellow-400">
        {t(
          'Want to support us and be able to join even when the server is full? Become a supporter:',
        )}
      </p>
      <ul class="space-y-1 text-yellow-400 list-disc pl-5">
        <li>{t('1 month = 100 CZK')}</li>
        <li>{t('6 months = 300 CZK')}</li>
        <li>{t('12 months = 500 CZK')}</li>
      </ul>
      <p class="text-yellow-400">
        {t('Send your payment to bank account:')}{' '}
        <strong translate="no">1939775153/0800</strong>
      </p>
      <p class="fl-text-sm/base text-gray-400" translate="no">
        IBAN CZ88 0800 0000 0019 3977 5153
      </p>
      <p>
        {t(
          'Include your nickname in the payment message so we know who sent the contribution.',
        )}
      </p>
      <p>
        {t(
          'You can also support the server without receiving VIP status by contributing any amount. Contact us and we will arrange the details.',
        )}
      </p>
      <section class="reserve-checkout" aria-labelledby="reserve-title">
        <h2 id="reserve-title" class="fl-text-xl/3xl font-bold">
          {t('vip_checkout_heading')}
        </h2>
        <p id="reserve-disclaimer" class="text-gray-300">
          {t('vip_checkout_subheading')}
        </p>
        <form
          id="reserve-form"
          aria-describedby="reserve-disclaimer"
          data-error={t('vip_checkout_error')}
          data-loading={t('vip_checkout_loading')}
        >
          <label for="reserve-steam" class="font-semibold">
            {t('vip_checkout_steam_identity')}
          </label>
          <input
            id="reserve-steam"
            name="steamId"
            value={steamPrefill}
            type="text"
            required
            maxlength="128"
            autocomplete="off"
            spellcheck="false"
            placeholder="STEAM_0:1:12345678"
            aria-describedby="reserve-steam-help"
          />
          <p id="reserve-steam-help" class="text-sm text-gray-300">
            {t('vip_checkout_steam_help')}
          </p>
          <fieldset>
            <legend class="font-semibold">
              {t('vip_checkout_terms_title')}
            </legend>
            <div class="reserve-offers">
              {[
                { months: 1, price: 100, label: '1 month = 100 CZK' },
                { months: 6, price: 300, label: '6 months = 300 CZK' },
                { months: 12, price: 500, label: '12 months = 500 CZK' },
              ].map((offer) => (
                <label class="reserve-offer">
                  <input
                    type="radio"
                    name="months"
                    value={offer.months}
                    required
                  />
                  <span>
                    {t(
                      offer.label as
                        | '1 month = 100 CZK'
                        | '6 months = 300 CZK'
                        | '12 months = 500 CZK',
                    )}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          <button type="submit" class="connect-button" disabled>
            {t('vip_checkout_review_button')}
          </button>
        </form>
        <p
          id="reserve-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></p>
        <div
          id="reserve-review"
          hidden
          tabindex="-1"
          aria-labelledby="reserve-review-title"
        >
          <h3 id="reserve-review-title" class="font-bold">
            {t('vip_checkout_review_title')}
          </h3>
          <dl class="reserve-summary">
            <div>
              <dt>{t('vip_checkout_offer_label')}</dt>
              <dd data-review="offerName"></dd>
            </div>
            <div>
              <dt>{t('vip_checkout_amount_label')}</dt>
              <dd data-review="amount"></dd>
            </div>
            <div>
              <dt>{t('vip_checkout_steam_label')}</dt>
              <dd data-review="steamId" translate="no"></dd>
            </div>
            <div>
              <dt>{t('vip_checkout_expiry_label')}</dt>
              <dd data-review="estimatedExpiry"></dd>
            </div>
          </dl>
          <button id="reserve-continue" type="button" class="connect-button">
            {t('vip_checkout_continue_button')}
          </button>
        </div>
        <noscript>
          <p>
            {t(
              'Enable JavaScript to pay with PayPal, or use the bank details above.',
            )}
          </p>
        </noscript>
      </section>
      <div class="fl-mt-3/5 rounded border border-gray-800 bg-gray-950/70 fl-p-2/4">
        <p class="font-semibold">
          {t('Click')}{' '}
          <a class="text-blue-400" href={localizedHref('/connect', locale)}>
            {t('HERE')}
          </a>{' '}
          {t('to join through the VIP slot, OR ENTER THIS IN THE CONSOLE:')}
        </p>
        <code class="text-red-400" translate="no">
          connect 82.208.17.101:27516
        </code>
      </div>
      <header class="fl-mt-4/8 fl-mb-4/6">
        <h2 class="fl-text-xl/3xl font-bold tracking-tight">
          {t('Our Supporters')}
        </h2>
        <p class="fl-mt-2/4 fl-text-sm/base text-gray-300">
          {t('A huge thank you to everyone who has supported the server.')}
        </p>
      </header>
      <ul
        class="flex flex-wrap items-center justify-center fl-gap-2/4 fl-text-sm/base text-gray-200"
        data-no-translate
      >
        {supporters.map((name) => (
          <li class="rounded-lg border border-gray-700 bg-gray-950/70 px-2 py-1">
            {name}
          </li>
        ))}
      </ul>
    </article>
  </section>
</Layout>

<script>
  const initializedForms = new WeakSet<HTMLFormElement>();

  function initializeReserveCheckout() {
    const checkout = document.querySelector<HTMLFormElement>('#reserve-form');
    const review = document.querySelector<HTMLElement>('#reserve-review');
    const status = document.querySelector<HTMLElement>('#reserve-status');
    const continueButton =
      document.querySelector<HTMLButtonElement>('#reserve-continue');
    const paypalAction = 'https://www.paypal.com/cgi-bin/webscr';
    const allowedFields = new Set([
      'cmd',
      'business',
      'item_name',
      'item_number',
      'amount',
      'currency_code',
      'custom',
      'notify_url',
      'return',
      'cancel_return',
      'no_shipping',
      'no_note',
      'rm',
    ]);
    type Checkout = {
      action: string;
      fields: Record<string, string>;
      offerName: string;
      amount: string;
      steamId: string;
      estimatedExpiry: string;
    };
    let prepared: Checkout | null = null;
    let busy = false;

    function validateCheckout(value: unknown): Checkout {
      if (!value || typeof value !== 'object' || Array.isArray(value))
        throw new Error('Invalid checkout');
      const data = value as Checkout;
      if (
        data.action !== paypalAction ||
        !data.fields ||
        typeof data.fields !== 'object' ||
        Array.isArray(data.fields)
      )
        throw new Error('Invalid checkout');
      const fields = Object.entries(data.fields);
      if (
        fields.length !== allowedFields.size ||
        JSON.stringify(data.fields).length > 16384
      )
        throw new Error('Invalid checkout');
      for (const [key, field] of fields) {
        if (
          !allowedFields.has(key) ||
          typeof field !== 'string' ||
          field.length > 512 ||
          /[\u0000-\u001f\u007f]/.test(field)
        )
          throw new Error('Invalid checkout');
      }
      if (
        data.fields.cmd !== '_xclick' ||
        data.fields.currency_code !== 'CZK' ||
        !data.fields.business ||
        !/^(100|300|500)(\.00)?$/.test(data.fields.amount ?? '')
      )
        throw new Error('Invalid checkout');
      for (const key of [
        'offerName',
        'amount',
        'steamId',
        'estimatedExpiry',
      ] as const) {
        if (
          typeof data[key] !== 'string' ||
          !data[key].trim() ||
          data[key].length > 256 ||
          /[\u0000-\u001f\u007f]/.test(data[key])
        )
          throw new Error('Invalid checkout');
      }
      if (data.amount !== data.fields.amount)
        throw new Error('Invalid checkout');
      return data;
    }

    if (checkout && review && status && continueButton) {
      if (initializedForms.has(checkout)) return;
      initializedForms.add(checkout);
      const submit = checkout.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )!;
      submit.disabled = false;
      const invalidate = () => {
        prepared = null;
        review.hidden = true;
        status.textContent = '';
      };
      checkout.addEventListener('input', invalidate);
      checkout.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (busy || !checkout.reportValidity()) return;
        invalidate();
        busy = true;
        submit.disabled = true;
        checkout.setAttribute('aria-busy', 'true');
        status.textContent = checkout.dataset.loading ?? '';
        const inputs = new FormData(checkout);
        try {
          const response = await fetch('/api/donations/checkout', {
            method: 'POST',
            credentials: 'same-origin',
            redirect: 'error',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
              Accept: 'application/json',
            },
            body: new URLSearchParams({
              steamid_user: String(inputs.get('steamId') ?? '').trim(),
              offer: String(inputs.get('months') ?? ''),
            }),
            signal: AbortSignal.timeout(15000),
          });
          if (
            !response.ok ||
            !response.headers.get('content-type')?.includes('application/json')
          )
            throw new Error('Checkout unavailable');
          const body = await response.text();
          if (body.length > 24576) throw new Error('Invalid checkout');
          // Validation only prepares a review. Only the separate button can leave this page.
          const data = validateCheckout(JSON.parse(body));
          const expectedAmount = (
            { '1': '100.00', '6': '300.00', '12': '500.00' } as Record<
              string,
              string
            >
          )[String(inputs.get('months'))];
          if (
            data.amount !== expectedAmount ||
            data.fields.item_number !== `reserve-${inputs.get('months')}`
          )
            throw new Error('Mismatched offer');
          if (
            checkout.elements.namedItem('steamId') instanceof
              HTMLInputElement &&
            (
              checkout.elements.namedItem('steamId') as HTMLInputElement
            ).value.trim() !== String(inputs.get('steamId') ?? '').trim()
          )
            throw new Error('Changed checkout');
          if (new FormData(checkout).get('months') !== inputs.get('months'))
            throw new Error('Changed checkout');
          prepared = data;
          review
            .querySelectorAll<HTMLElement>('[data-review]')
            .forEach((element) => {
              element.textContent =
                data[
                  element.dataset.review as
                    'offerName' | 'amount' | 'steamId' | 'estimatedExpiry'
                ];
            });
          review.hidden = false;
          status.textContent = '';
          review.focus();
        } catch {
          status.textContent = checkout.dataset.error ?? '';
        } finally {
          busy = false;
          submit.disabled = false;
          checkout.removeAttribute('aria-busy');
        }
      });
      continueButton.addEventListener('click', () => {
        if (!prepared || busy) return;
        const data = validateCheckout(prepared);
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = paypalAction;
        form.hidden = true;
        for (const [name, value] of Object.entries(data.fields)) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.value = value;
          form.appendChild(input);
        }
        prepared = null;
        continueButton.disabled = true;
        document.body.appendChild(form);
        HTMLFormElement.prototype.submit.call(form);
      });
    }
  }

  // ClientRouter replaces the form without re-running this module script.
  document.addEventListener('astro:page-load', initializeReserveCheckout);
  initializeReserveCheckout();
</script>

<style>
  .reserve-checkout {
    margin-block: 1.5rem;
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--edge);
    border-radius: 0.75rem;
    background: var(--surface);
  }
  .reserve-checkout > * + *,
  #reserve-form > * + * {
    margin-top: 1rem;
  }
  #reserve-form > label,
  #reserve-form > input {
    display: block;
  }
  #reserve-steam {
    width: 100%;
    min-height: 44px;
    padding: 0.75rem;
    border: 1px solid var(--edge);
    border-radius: 0.375rem;
    background: var(--surface);
    color: inherit;
  }
  .reserve-offers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .reserve-offer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 64px;
    padding: 1rem;
    border: 1px solid var(--edge);
    border-radius: 0.5rem;
    cursor: pointer;
  }
  .reserve-offer:has(input:checked) {
    border-color: var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 10%, var(--surface));
  }
  .reserve-offer input {
    accent-color: var(--brand-accent);
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }
  .reserve-checkout :is(input, button):focus-visible,
  #reserve-review:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 4px;
  }
  .reserve-checkout button {
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    white-space: normal;
  }
  .reserve-checkout button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  #reserve-status:not(:empty) {
    padding: 0.75rem;
    border-left: 3px solid var(--brand-accent);
  }
  .reserve-summary {
    display: grid;
    gap: 0.75rem;
    margin-block: 1rem;
  }
  .reserve-summary dt {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .reserve-summary dd {
    overflow-wrap: anywhere;
    font-weight: 600;
  }
</style>
