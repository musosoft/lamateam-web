        <code class="text-red-400">connect 82.208.17.101:27516</code>
      </div>
    </article>

    <header class="mt-8 mb-6 rounded-2xl border border-gray-700 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 shadow-2xl">
      <h2 class="text-2xl font-extrabold tracking-tight md:text-3xl">Kdo podpořil server</h2>
      <p class="mt-2 text-sm text-gray-300 md:text-base">Veľké thanks všetkým, čo podporili chod servera.</p>
    </header>
    <article class="rounded-2xl border border-gray-700 bg-gray-900/80 p-5 shadow-lg">
      <ul class="flex flex-wrap items-center justify-center gap-2 text-sm text-gray-200">
        {supporters.map((name) => <li class="rounded-lg border border-gray-700 bg-gray-950/70 px-2 py-1">{name}</li>)}
      </ul>
    </article>
  </section>
</Layout>
