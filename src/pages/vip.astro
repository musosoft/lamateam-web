<Layout title={t('VIP | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('VIP & Server Support')}
      </h1>
    </header>
    <article class="space-y-3 panel fl-p-3/6 text-gray-200">
      <p class="text-yellow-400">
        {t(
          'Want to support us and be able to join even when the server is full? Become a supporter:',
        )}
      </p>
      <ul class="space-y-1 text-yellow-400 list-disc pl-5">
        <li>{t('1 month = 100 CZK')}</li>
        <li>{t('6 months = 300 CZK')}</li>
        <li>{t('12 months = 500 CZK')}</li>
      </ul>
      <p class="text-yellow-400">
        {t('Send your payment to bank account:')}{' '}
        <strong translate="no">1939775153/0800</strong>
      </p>
      <p class="fl-text-sm/base text-gray-400" translate="no">
        IBAN CZ88 0800 0000 0019 3977 5153
      </p>
      <p>
        {t(
          'Include your nickname in the payment message so we know who sent the contribution.',
        )}
      </p>
      <p>
        {t(
          'You can also support the server without receiving VIP status by contributing any amount. Contact us and we will arrange the details.',
        )}
      </p>
      <div class="fl-mt-3/5 rounded border border-gray-800 bg-gray-950/70 fl-p-2/4">
        <p class="font-semibold">
          {t('Click')}{' '}
          <a class="text-blue-400" href={localizedHref('/connect', locale)}>
            {t('HERE')}
          </a>{' '}
          {t('to join through the VIP slot, OR ENTER THIS IN THE CONSOLE:')}
        </p>
        <code class="text-red-400" translate="no">
          connect 82.208.17.101:27516
        </code>
      </div>
      <header class="fl-mt-4/8 fl-mb-4/6">
        <h2 class="fl-text-xl/3xl font-bold tracking-tight">
          {t('Our Supporters')}
        </h2>
        <p class="fl-mt-2/4 fl-text-sm/base text-gray-300">
          {t('A huge thank you to everyone who has supported the server.')}
        </p>
      </header>
      <ul
        class="flex flex-wrap items-center justify-center fl-gap-2/4 fl-text-sm/base text-gray-200"
        data-no-translate
      >
        {supporters.map((name) => (
          <li class="rounded-lg border border-gray-700 bg-gray-950/70 px-2 py-1">
            {name}
          </li>
        ))}
      </ul>
    </article>
  </section>
</Layout>
