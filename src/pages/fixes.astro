---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
import { Icon } from 'astro-icon/components';
---

<Layout title={t('FPS Fixes | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('FPS, Sound & Radar Fixes')}
      </h1>
    </header>
    <article class="space-y-4 panel fl-p-3/6 text-gray-200">
      <p class="fl-text-sm/base text-gray-300">
        {t('Try these fixes in order.')}
      </p>
      <div>
        <p class="fl-mb-2/4 fl-text-lg/2xl font-semibold">
          {t('1) Quick Fix')}
        </p>
        <div class="inline-flex flex-wrap items-center fl-gap-2/4 rounded bg-gray-950/70 fl-p-2/4 fl-text-sm/base">
          <span class="copy-content" translate="no">
            exec config;exec autoexec;record
            null;stop;soundscape_flush;snd_restart;hud_reloadscheme;overview_mode
            1
          </span>
          <button
            onclick="copyToClipboard(this)"
            aria-label={t('Copy quick fix command')}
            class="text-gray-400 hover:text-white"
          >
            <Icon name="mdi:content-copy" class="h-5 w-5" />
          </button>
        </div>
      </div>
      <div>
        <p class="fl-mb-2/4 fl-text-lg/2xl font-semibold">{t('2) Retry')}</p>
        <div class="inline-flex flex-wrap items-center fl-gap-2/4 rounded bg-gray-950/70 fl-p-2/4 fl-text-sm/base">
          <span class="copy-content" translate="no">
            retry
          </span>
          <button
            onclick="copyToClipboard(this)"
            aria-label={t('Copy retry command')}
            class="text-gray-400 hover:text-white"
          >
            <Icon name="mdi:content-copy" class="h-5 w-5" />
          </button>
        </div>
      </div>
      <div>
        <p class="fl-mb-2/4 fl-text-lg/2xl font-semibold">
          {t('3) CFG fix:')}{' '}
          <kbd
            class="fl-px-2/3 py-1 fl-text-xs/sm font-semibold text-gray-100 bg-gray-700 border border-gray-200 rounded"
            translate="no"
          >
            Win
          </kbd>{' '}
          +{' '}
          <kbd
            class="fl-px-2/3 py-1 fl-text-xs/sm font-semibold text-gray-100 bg-gray-700 border border-gray-200 rounded"
            translate="no"
          >
            X
          </kbd>{' '}
          → <small>{t('Terminal/PowerShell (Admin)')}</small>
        </p>
        <div class="inline-flex flex-wrap items-center fl-gap-2/4 rounded bg-gray-950/70 fl-p-2/4 fl-text-sm/base">
          <span class="copy-content" translate="no">
            irm lamateam.eu/setup | iex
          </span>
          <button
            onclick="copyToClipboard(this)"
            aria-label={t('Copy setup command')}
            class="text-gray-400 hover:text-white"
          >
            <Icon name="mdi:content-copy" class="h-5 w-5" />
          </button>
        </div>
      </div>
    </article>
  </section>
</Layout>
<script is:inline>
  async function copyToClipboard(button) {
    const content = button.parentElement
      .querySelector('.copy-content')
      ?.innerText?.trim();
    if (!content) return;
    await navigator.clipboard.writeText(content);
  }
</script>
