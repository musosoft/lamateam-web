---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
import mapsGenerated from '../data/maps.generated.json';
import { Icon } from 'astro-icon/components';
import {
  loadSourceTVFiles,
  type SourceTVExecutionContext,
} from '../lib/sourcetv';

export const prerender = false;
// Astro 6+/Cloudflare 13+ exposes the supported Worker execution context here.
const cfContext = (
  Astro.locals as App.Locals & { cfContext?: SourceTVExecutionContext }
).cfContext;
const {
  files: demoFiles,
  stale,
  error,
  refreshing,
} = await loadSourceTVFiles(cfContext);
Astro.response.headers.set('Cache-Control', 'no-store');
if (error && demoFiles.length === 0 && !stale && !refreshing)
  Astro.response.status = 503;
const mapImages = new Map(
  mapsGenerated.items.map((item) => [item.map, item.image]),
);
const demos = demoFiles
  .map((file) => {
    const filename = file.split('/').pop() ?? file;
    const match =
      /^auto-(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})-(.+)\.dem(?:\.(?:bz2|gz|zip))?$/i.exec(
        filename,
      );
    const map = match?.[6];
    const date = match
      ? `${match[3]}.${match[2]}.${match[1]} ${match[4]}:${match[5]}`
      : undefined;
    const image = map ? mapImages.get(map) : undefined;
    return {
      file,
      filename,
      map,
      date,
      sortDate: match
        ? `${match[1]}${match[2]}${match[3]}${match[4]}${match[5]}`
        : '',
      image: image?.startsWith('/assets/map-cache/') ? image : undefined,
    };
  })
  .sort(
    (a, b) =>
      b.sortDate.localeCompare(a.sortDate) ||
      b.filename.localeCompare(a.filename),
  );
---

<Layout title={t('SourceTV Demos | LaMaTeAm')} lang={locale}>
  <section class="sourcetv-page w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('SourceTV Demos')}
      </h1>
    </header>
    <article class="demo-panel panel">
      {stale && (
        <p role="status" class="mb-4">
          {refreshing
            ? t(
                'Showing the last available demo list while checking for updates.',
              )
            : t(
                'Showing the last available demo list. Updates are temporarily unavailable.',
              )}
        </p>
      )}
      {demoFiles.length === 0 ? (
        <p role="status">
          {refreshing && !stale
            ? t(
                'Checking for available demos. Please refresh this page shortly.',
              )
            : error && !stale
              ? t('Demo list temporarily unavailable. Please try again later.')
              : t('No demos available yet.')}
        </p>
      ) : (
        <table class="demo-table w-full border-collapse">
          <caption class="sr-only">
            {t(
              'Available SourceTV demo downloads. Times are taken from the recorded filenames.',
            )}
          </caption>
          <thead>
            <tr>
              <th scope="col">{t('Date & time')}</th>
              <th scope="col">{t('Map')}</th>
              <th scope="col">
                <span class="sr-only">{t('Download')}</span>
              </th>
            </tr>
          </thead>
          <tbody data-no-translate>
            {demos.map((demo) => (
              <tr>
                <td>{demo.date ?? '—'}</td>
                <td>
                  <div class="demo-map">
                    {demo.image && (
                      <img
                        src={demo.image}
                        alt=""
                        width="64"
                        height="36"
                        loading="lazy"
                        decoding="async"
                        onerror="this.hidden=true;"
                      />
                    )}
                    <a
                      href={`https://wild-fire-819b.still-fog-235d.workers.dev/download?file=${encodeURIComponent(demo.file)}`}
                      class="demo-map-link"
                      translate="no"
                      aria-label={
                        t('Download') +
                        ' ' +
                        (demo.date ? `${demo.date} ${demo.map}` : demo.filename)
                      }
                      download
                    >
                      {demo.map ?? demo.filename}
                    </a>
                  </div>
                </td>
                <td>
                  <a
                    href={`https://wild-fire-819b.still-fog-235d.workers.dev/download?file=${encodeURIComponent(demo.file)}`}
                    class="demo-download text-blue-400 hover:underline"
                    aria-label={
                      t('Download') +
                      ' ' +
                      (demo.date ? `${demo.date} ${demo.map}` : demo.filename)
                    }
                    title={t('Download') + ' ' + demo.filename}
                    download
                  >
                    <Icon name="mdi:download" class="h-5 w-5" />
                    <span class="demo-download-label">{t('Download')}</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </article>
  </section>
  <style>
    .demo-panel {
      width: 100%;
      padding: 0.5rem clamp(0.5rem, 1vw, 1rem);
    }
    .demo-table {
      width: 100%;
      table-layout: fixed;
    }
    .demo-table th:first-child {
      width: clamp(9rem, 18vw, 14rem);
    }
    .demo-table th:last-child {
      width: clamp(7rem, 12vw, 10rem);
      text-align: right;
    }
    .demo-table th,
    .demo-table td {
      text-align: left;
      padding: 0.65rem 0.5rem;
      border-bottom: 1px solid var(--edge);
    }
    .demo-table td:first-child {
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
      font-size: 0.85rem;
    }
    .demo-table td:last-child {
      text-align: right;
    }
    .demo-map {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .demo-map-link {
      overflow-wrap: anywhere;
      min-width: 0;
      color: var(--link);
      text-underline-offset: 0.2em;
    }
    .demo-map-link:hover {
      text-decoration: underline;
    }
    .demo-map img {
      flex-shrink: 0;
      width: 64px;
      height: 36px;
      object-fit: cover;
      border-radius: 4px;
    }
    .demo-download {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-width: 44px;
      min-height: 44px;
    }
    @media (max-width: 700px) {
      .demo-table th:first-child {
        width: 8rem;
      }
      .demo-table th:last-child {
        width: 3rem;
      }
      .demo-map img,
      .demo-download-label {
        display: none;
      }
      .demo-table th,
      .demo-table td {
        padding: 0.5rem 0.25rem;
        font-size: 0.75rem;
      }
      .demo-table td:first-child {
        font-size: 0.7rem;
      }
    }
  </style>
</Layout>
