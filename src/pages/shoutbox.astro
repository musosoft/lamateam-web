---
// src/pages/shoutbox.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../assets/hero.svg?raw';

// Server-Side Variables
const baseUrl = Astro.locals.runtime.env.PUBLIC_SITE_URL || '/';
const cookies = Astro.cookies;
const sessionCookie = cookies.get('session');
const session = sessionCookie
  ? JSON.parse(decodeURIComponent(sessionCookie.value))
  : {};

// Get the user agent and determine if the request is from the game
const userAgent = Astro.request.headers.get('user-agent') || '';
const isGame = userAgent.includes('Valve Client');

// Access query parameters
const communityId = Astro.url.searchParams.get('communityid');
const playerName = Astro.url.searchParams.get('name');

// Initialize props
let isAuthenticated = false;
let displayPlayerName = 'Guest';
let displayPlayerAvatar = '/assets/default-avatar.webp';
let steamID = '';

// Authentication logic
if (isGame && communityId && playerName) {
  isAuthenticated = true;
  displayPlayerName = playerName;
  steamID = convertToSteam64(communityId);

  if (steamID) {
    const STEAM_API_KEY = Astro.locals.runtime.env.STEAM_API_KEY;
    if (STEAM_API_KEY) {
      const steamApiUrl = `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/?key=${STEAM_API_KEY}&steamids=${steamID}`;
      try {
        const response = await fetch(steamApiUrl);
        if (response.ok) {
          const data = await response.json();
          const player = data.response.players[0];
          displayPlayerAvatar =
            player?.avatarfull || '/assets/default-avatar.webp';
        } else {
          console.error(
            'Failed to fetch avatar from Steam API. Status:',
            response.status,
          );
        }
      } catch (error) {
        console.error('Error fetching avatar from Steam API:', error);
      }
    } else {
      console.error('STEAM_API_KEY is not set.');
    }
  }
} else if (session?.steamID) {
  isAuthenticated = true;
  displayPlayerName = session.playerName || 'Guest';
  displayPlayerAvatar = session.playerAvatar || '/assets/default-avatar.webp';
  steamID = session.steamID;
}

// Helper function to convert communityId to Steam64
function convertToSteam64(communityId: string): string {
  const steamIdMatch = communityId.match(/^\[U:1:(\d+)\]$/);
  if (steamIdMatch) {
    const accountId = BigInt(steamIdMatch[1]);
    const steam64Id = accountId + BigInt('76561197960265728');
    return steam64Id.toString();
  } else {
    console.error('Invalid communityId format:', communityId);
    return '';
  }
}
---

<Layout
  title="Shoutbox"
  isAuthenticated={isAuthenticated}
  userName={displayPlayerName}
  hero={Hero}
>
  <section class="mx-auto w-full">
    {
      isAuthenticated ? (
        <div class="flex items-center space-x-4 mb-6">
          <img
            id="playerAvatar"
            src={displayPlayerAvatar}
            alt="Avatar hráče"
            class="w-12 h-12 rounded-full border-2 border-gray-700"
          />
          <p id="welcomeMessage" class="text-lg text-green-400">
            Vítejte, <strong>{displayPlayerName}</strong>!
          </p>
        </div>
      ) : (
        <div class="mb-6">
          <a href="/api/auth/steam" class="text-blue-500 underline">
            Přihlaste se přes Steam, abyste se mohli připojit k shoutboxu.
          </a>
        </div>
      )
    }

    <form
      id="shoutboxForm"
      class="flex gap-4 items-center mb-6"
      onsubmit="return false;"
    >
      <input
        type="text"
        id="messageInput"
        placeholder="Zadejte svou zprávu"
        class="flex-1 p-3 rounded-md border border-gray-600 bg-gray-800 text-white"
        autocomplete="off"
        disabled={!isAuthenticated}
      />
      <button
        type="button"
        id="sendButton"
        class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md"
        disabled={!isAuthenticated}
      >
        Odeslat
      </button>
    </form>

    <div
      id="shoutboxMessages"
      class="max-h-[400px] overflow-y-auto p-4 bg-gray-800 rounded-md"
    >
      <!-- Messages will load here dynamically -->
    </div>
  </section>

  <script
    is:inline
    define:vars={{ baseUrl, displayPlayerName, displayPlayerAvatar, steamID }}
  >
    document.addEventListener('DOMContentLoaded', function () {
      const messageInput = document.getElementById('messageInput');
      const sendButton = document.getElementById('sendButton');
      const shoutboxMessages = document.getElementById('shoutboxMessages');

      const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

      // Formát času od
      function timeSince(timestamp) {
        const now = Date.now();
        const diffTime = now - new Date(timestamp).getTime();

        if (isNaN(diffTime)) return 'Neplatný čas';

        const seconds = Math.floor(diffTime / 1000);
        const minutes = Math.floor(seconds / 60);
        const hours = Math.floor(minutes / 60);
        const days = Math.floor(hours / 24);
        const months = Math.floor(days / 30); // Přibližný výpočet
        const years = Math.floor(days / 365); // Přibližný výpočet

        if (years > 0)
          return `${years} rok${years > 1 && years < 5 ? 'y' : years > 4 ? 'ů' : ''}`;
        if (months > 0)
          return `${months} měsíc${months > 1 && months < 5 ? 'e' : months > 4 ? 'ů' : ''}`;
        if (days > 0) {
          if (days === 1) return '1 den';
          if (days > 1 && days < 5) return `${days} dny`;
          return `${days} dní`; // For 5+ days
        }
        if (hours > 0)
          return `${hours} hodin${hours > 1 && hours < 5 ? 'y' : ''}`;
        if (minutes > 0)
          return `${minutes} minut${minutes > 1 && minutes < 5 ? 'y' : ''}`;
        return `${seconds} sekund${seconds > 1 && seconds < 5 ? 'y' : ''}`;
      }

      // Render Messages in DOM
      function renderMessages(messages) {
        shoutboxMessages.innerHTML = '';
        messages.forEach(
          ({ player_avatar, player_name, message, timestamp }) => {
            shoutboxMessages.insertAdjacentHTML(
              'beforeend',
              `<div class="flex items-center space-x-4 mb-4">
              <img
                src="${player_avatar || '/assets/default-avatar.webp'}"
                alt="Player Avatar"
                class="w-8 h-8 rounded-full"
              />
              <div class="flex flex-1">
                <p class="text-white"><strong>${player_name}</strong>: ${message}</p>
                <p class="text-gray-400 text-sm ml-auto">${timeSince(timestamp)}</p>
              </div>
            </div>`,
            );
          },
        );
      }

      // Fetch and Render Messages
      async function fetchMessages() {
        try {
          const response = await fetch(`${normalizedBaseUrl}api/shoutbox`);
          if (!response.ok)
            throw new Error(`HTTP error! status: ${response.status}`);
          const messages = await response.json();
          renderMessages(messages);
        } catch (error) {
          console.error('Error fetching messages:', error);
        }
      }

      // Submit Message
      async function handleSubmit() {
        const message = messageInput.value.trim();
        if (!message) return;

        try {
          const response = await fetch(`${normalizedBaseUrl}api/shoutbox`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              steamid: steamID || '',
              player_name: displayPlayerName,
              player_avatar: displayPlayerAvatar,
              message,
            }),
          });
          if (!response.ok)
            throw new Error(`HTTP error! status: ${response.status}`);
          messageInput.value = '';
          fetchMessages();
        } catch (error) {
          console.error('Error submitting message:', error);
        }
      }

      // Event Listeners
      sendButton?.addEventListener('click', handleSubmit);

      // Initial Fetch
      fetchMessages();
    });
  </script>
</Layout>
