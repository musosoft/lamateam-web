---
// src/pages/shoutbox.astro
import Layout from '../layouts/Layout.astro';

// Read environment
const baseUrl = Astro.locals.runtime.env.PUBLIC_SITE_URL
  || import.meta.env.PUBLIC_SITE_URL
  || '/';
const STEAM_API_KEY = Astro.locals.runtime.env.STEAM_API_KEY
  || import.meta.env.STEAM_API_KEY;

// Grab cookies
const cookies = Astro.cookies;

// Helper: parse session cookie
function parseSessionCookie() {
  const raw = cookies.get('session')?.value;
  if (!raw) return {};
  try {
    return JSON.parse(decodeURIComponent(raw));
  } catch {
    return {};
  }
}

// In-game detection
const userAgent = Astro.request.headers.get('user-agent')?.toLowerCase() || '';
const isGame = userAgent.includes('valve') || userAgent.includes('steam');

// For in-game usage, read these cookies if they exist
const rawCommunityId = cookies.get('communityid')?.value || '';
const rawPlayerName = cookies.get('name')?.value || '';

// Convert [U:1:xxxx] → 64-bit
function convertToSteam64(communityId: string): string {
  const match = communityId.match(/^\[U:1:(\d+)\]$/);
  if (match) {
    return (BigInt(match[1]) + BigInt('76561197960265728')).toString();
  }
  return communityId; // If it's already 64-bit or invalid
}

// Parse session
const session = parseSessionCookie();

// Decide final steamID & playerName
let steamID = '';
let playerName = 'Guest';

if (isGame && rawCommunityId) {
  // In-game scenario
  steamID = convertToSteam64(rawCommunityId);
  playerName = rawPlayerName || 'Guest';
} else {
  // Normal browser scenario
  steamID = session?.steamID || '';
  playerName = session?.playerName || 'Guest';
}

// isAuthenticated: true if we have a valid steamID & not "Guest"
const isAuthenticated = Boolean(steamID && playerName !== 'Guest');

// Set a default avatar
let playerAvatar = '/assets/default-avatar.webp';

// If we have steamID, fetch avatar from the Steam API
async function fetchSteamAvatar(steam64: string) {
  if (!STEAM_API_KEY) {
    console.error('STEAM_API_KEY is not set.');
    return '/assets/default-avatar.webp';
  }
  try {
    const steamApiUrl =
      `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/`
      + `?key=${STEAM_API_KEY}&steamids=${steam64}`;
    const response = await fetch(steamApiUrl);
    if (!response.ok) {
      console.error('Steam API error:', response.status);
      return '/assets/default-avatar.webp';
    }
    const data = await response.json();
    return data.response.players[0]?.avatarfull || '/assets/default-avatar.webp';
  } catch (err) {
    console.error('Error fetching avatar:', err);
    return '/assets/default-avatar.webp';
  }
}

// Only fetch avatar if we have a steamID
if (steamID) {
  playerAvatar = await fetchSteamAvatar(steamID);
}
---

<Layout title="Shoutbox">
  <section class="mx-auto w-full">
    {
      isAuthenticated ? (
        <div class="flex items-center space-x-4 mb-6">
          <img
            id="playerAvatar"
            src={playerAvatar}
            alt="Avatar hráče"
            class="w-12 h-12 rounded-full border-2 border-gray-700"
          />
          <p id="welcomeMessage" class="text-lg text-green-400">
            Vítej, <strong>{playerName}</strong>!
          </p>
        </div>
      ) : (
        <div class="mb-6">
          <a href="/api/auth/steam" class="text-blue-500 underline">
            Přihlaste se přes Steam, abyste se mohli připojit k shoutboxu.
          </a>
        </div>
      )
    }

    <form
      id="shoutboxForm"
      class="flex gap-4 items-center mb-6"
      onsubmit="return false;"
    >
      <input
        type="text"
        id="messageInput"
        placeholder="Zadejte svou zprávu"
        class="flex-1 p-3 rounded-md border border-gray-600 bg-gray-800 text-white"
        autocomplete="off"
        disabled={!isAuthenticated}
      />
      <button
        type="button"
        id="sendButton"
        class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md"
        disabled={!isAuthenticated}
      >
        Odeslat
      </button>
    </form>

    <div
      id="shoutboxMessages"
      class="~max-h-64/96 overflow-y-auto p-4 bg-gray-800 rounded-md"
    >
      <!-- Messages will load here dynamically -->
    </div>
  </section>

  <script is:inline define:vars={{ baseUrl, playerName, playerAvatar, steamID }}>
  // This code will run in the browser on page load
  document.addEventListener('DOMContentLoaded', () => {
      const messageInput = document.getElementById('messageInput');
      const sendButton = document.getElementById('sendButton');
      const shoutboxMessages = document.getElementById('shoutboxMessages');

      const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;

      // timeSince
      function timeSince(timestamp) {
        const now = Date.now();
        const diffTime = now - new Date(timestamp).getTime();
        if (isNaN(diffTime)) return 'Neplatný čas';

        const seconds = Math.floor(diffTime / 1000);
        const minutes = Math.floor(seconds / 60);
        const hours = Math.floor(minutes / 60);
        const days = Math.floor(hours / 24);
        const months = Math.floor(days / 30);
        const years = Math.floor(days / 365);

        if (years > 0) {
          return `${years} rok${years > 1 && years < 5 ? 'y' : years > 4 ? 'ů' : ''}`;
        }
        if (months > 0) {
          return `${months} měsíc${months > 1 && months < 5 ? 'e' : months > 4 ? 'ů' : ''}`;
        }
        if (days > 0) {
          if (days === 1) return '1 den';
          if (days > 1 && days < 5) return `${days} dny`;
          return `${days} dní`;
        }
        if (hours > 0) {
          return `${hours} hodin${hours > 1 && hours < 5 ? 'y' : ''}`;
        }
        if (minutes > 0) {
          return `${minutes} minut${minutes > 1 && minutes < 5 ? 'y' : ''}`;
        }
        return `${seconds} sekund${seconds > 1 && seconds < 5 ? 'y' : ''}`;
      }

      // Render messages
      function renderMessages(messages) {
        shoutboxMessages.innerHTML = '';
        messages.forEach(({ player_avatar, player_name, message, timestamp }) => {
            shoutboxMessages.insertAdjacentHTML(
              'beforeend',
              `<div class="flex items-center space-x-4 mb-4">
              <img
                src="${player_avatar || '/assets/default-avatar.webp'}"
                alt="Player Avatar"
                class="w-8 h-8 rounded-full"
              />
              <div class="flex flex-1">
                <p class="text-white"><strong>${player_name}</strong>: ${message}</p>
                <p class="text-gray-400 text-sm ml-auto">${timeSince(timestamp)}</p>
              </div>
             </div>`
        );
        });
      }

      // Fetch & render
      async function fetchMessages() {
        try {
          const response = await fetch(`${normalizedBaseUrl}api/shoutbox`);
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          const messages = await response.json();
          renderMessages(messages);
        } catch (error) {
          console.error('Error fetching messages:', error);
        }
      }

      // Submit new message
      async function handleSubmit() {
      const message = messageInput.value.trim();
      if (!message) return;

        try {
          const response = await fetch(`${normalizedBaseUrl}api/shoutbox`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              steamid: steamID || '',
              player_name: playerName,
              player_avatar: playerAvatar,
            message,
            }),
          });
        if (!response.ok)
            throw new Error(`HTTP error! status: ${response.status}`);
        
          messageInput.value = '';
          fetchMessages();
        } catch (error) {
          console.error('Error submitting message:', error);
        }
      }

    sendButton?.addEventListener('click', handleSubmit);

    // On load, fetch existing messages
      fetchMessages();
    });
  </script>
</Layout>
