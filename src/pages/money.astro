---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
---

<Layout title={t('Money | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('Money in CS:S')}
      </h1>
    </header>
    <article class="space-y-6 panel fl-p-3/6 text-gray-200">
      <p class="fl-text-sm/base text-gray-300">
        {t('👤 = awarded to the player only • 👥 = awarded to the entire team')}
      </p>
      <p class="text-center fl-text-lg/2xl">
        {t('Starting money:')}{' '}
        <strong class="text-green-400" translate="no">
          $800
        </strong>
      </p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] table-fixed border-collapse border border-gray-600 rounded-lg mb-6 overflow-hidden">
          <thead>
            <tr>
              <th class="w-1/2 px-4 py-2 text-left bg-linear-to-r from-blue-800 to-blue-600 border border-gray-700">
                {t('CT')}
              </th>
              <th class="w-1/2 px-4 py-2 text-left bg-linear-to-l from-red-800 to-red-600 border border-gray-700">
                {t('T')}
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t('👤 Enemy kill:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$300
                </strong>
              </td>
              <td class="px-4 py-2 border border-gray-700">
                {t('👤 Enemy kill:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$300
                </strong>
              </td>
            </tr>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t('👥 Win by elimination:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$3250
                </strong>
              </td>
              <td class="px-4 py-2 border border-gray-700">
                {t('👥 Win by elimination:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$3250
                </strong>
              </td>
            </tr>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t('👥 Win when time expires:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$3250
                </strong>
              </td>
              <td class="px-4 py-2 border border-gray-700">—</td>
            </tr>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t('👥 Defuse the bomb:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$3500
                </strong>
              </td>
              <td class="px-4 py-2 border border-gray-700">
                {t('👥 Bomb explodes:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$3500
                </strong>
              </td>
            </tr>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t(
                  '👤 First hostage contact: +$150 / rescue: +$1000 / team bonus: +$850',
                )}
              </td>
              <td class="px-4 py-2 border border-gray-700">
                {t('👥 Bomb planted + round lost:')}{' '}
                <strong class="text-green-400" translate="no">
                  +$800
                </strong>
              </td>
            </tr>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t(
                  '👥 Loss bonus: $1400 +$500 for each consecutive loss (max $3400)',
                )}
              </td>
              <td class="px-4 py-2 border border-gray-700">
                {t(
                  '👥 Loss bonus: $1400 +$500 for each consecutive loss (max $3400)',
                )}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] table-fixed border-collapse border border-gray-600 rounded-lg mb-6 overflow-hidden">
          <thead>
            <tr>
              <th class="w-1/2 px-4 py-2 text-left bg-linear-to-r from-blue-800 to-blue-600 border border-gray-700">
                {t('CT Penalties')}
              </th>
              <th class="w-1/2 px-4 py-2 text-left bg-linear-to-l from-red-800 to-red-600 border border-gray-700">
                {t('T Penalties')}
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t('👤 Teamkill:')}{' '}
                <strong class="text-red-400" translate="no">
                  -$3300
                </strong>
              </td>
              <td class="px-4 py-2 border border-gray-700">
                {t('👤 Teamkill:')}{' '}
                <strong class="text-red-400" translate="no">
                  -$3300
                </strong>
              </td>
            </tr>
            <tr class="hover:bg-gray-700">
              <td class="px-4 py-2 border border-gray-700">
                {t('👤 Injure a hostage: -$150 / kill a hostage: -$1500')}
              </td>
              <td class="px-4 py-2 border border-gray-700">—</td>
            </tr>
          </tbody>
        </table>
      </div>
    </article>
  </section>
  <style>
    table :is(th, td):first-child {
      text-align: right;
    }
  </style>
</Layout>
