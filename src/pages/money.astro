---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Peníze | LaMaTeam">
  <section class="mx-auto w-full max-w-6xl px-4 py-8 text-left text-gray-100">
    <header class="mb-6 rounded-2xl border border-gray-700 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 shadow-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">Peníze v CS:S</h1>
      <p class="mt-2 text-sm text-gray-300 md:text-base">Rýchly prehľad ako zarábaš a strácaš money.</p>
    </header>

    <article class="space-y-6 rounded-2xl border border-gray-700 bg-gray-900/80 p-5 shadow-lg">
      <p class="text-center text-lg">Start kola: <strong class="text-green-400">$800</strong></p>
      <p class="text-center text-sm text-gray-300">👤 = len hráč, ktorý akciu spravil • 👥 = celý tím</p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[700px] table-fixed border-collapse border border-gray-600 rounded-lg overflow-hidden">
          <thead>
            <tr>
              <th class="w-1/2 px-4 py-2 text-left bg-gradient-to-r from-blue-800 to-blue-600 border border-gray-700">CT</th>
              <th class="w-1/2 px-4 py-2 text-left bg-gradient-to-l from-red-800 to-red-600 border border-gray-700">T</th>
            </tr>
          </thead>
          <tbody class="text-gray-200">
            <tr class="hover:bg-gray-700"><td class="px-4 py-2 border border-gray-700">👤 Kill: <strong class="text-green-400">+$300</strong></td><td class="px-4 py-2 border border-gray-700">👤 Kill: <strong class="text-green-400">+$300</strong></td></tr>
            <tr class="hover:bg-gray-700"><td class="px-4 py-2 border border-gray-700">👥 Výhra elimináciou: <strong class="text-green-400">+$3250</strong></td><td class="px-4 py-2 border border-gray-700">👥 Výhra elimináciou: <strong class="text-green-400">+$3250</strong></td></tr>
            <tr class="hover:bg-gray-700"><td class="px-4 py-2 border border-gray-700">👥 Defuse: <strong class="text-green-400">+$3500</strong></td><td class="px-4 py-2 border border-gray-700">👥 Plant + výbuch: <strong class="text-green-400">+$3500</strong></td></tr>
            <tr class="hover:bg-gray-700"><td class="px-4 py-2 border border-gray-700">👥 Prohra bonus: $1400 → +$500 (max $3400)</td><td class="px-4 py-2 border border-gray-700">👥 Prohra bonus: $1400 → +$500 (max $3400)</td></tr>
            <tr class="hover:bg-gray-700"><td class="px-4 py-2 border border-gray-700">👤 Teamkill: <strong class="text-red-400">-$3300</strong></td><td class="px-4 py-2 border border-gray-700">👤 Teamkill: <strong class="text-red-400">-$3300</strong></td></tr>
          </tbody>
        </table>
      </div>
    </article>
  </section>
</Layout>
