---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/page-copy';
import {
  localeFromPath,
  localizedHref,
  type SiteLocale,
} from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);

const commandGroups = [
  {
    title: t('Most Used'),
    items: [
      { cmd: '!motd', desc: t('Opens the server information/MOTD window.') },
      {
        cmd: '!nb',
        desc: t('Attempts to unblock you (or a target) when stuck.'),
      },
      {
        cmd: '!rtv',
        desc: t(
          'Rock the Vote — starts a vote to change the map, when available.',
        ),
      },
      { cmd: '!nominate <map>', desc: t('Nominates a map for the vote.') },
      { cmd: '!resetscore / !rs / !r', desc: t('Resets your score (K/D).') },
    ],
  },
  {
    title: t('Map and Server Information'),
    items: [
      {
        cmd: '!timeleft',
        desc: t('Shows the time remaining on the current map.'),
      },
      { cmd: '!nextmap', desc: t('Shows the next map (or a pending vote).') },
      { cmd: '!currentmap', desc: t('Shows the current map.') },
      { cmd: '!thetime', desc: t('Shows the current server time.') },
    ],
  },
  {
    title: t('HLstatsX / Statistics'),
    items: [
      { cmd: '!rank', desc: t('Shows your HLstatsX rank.') },
      {
        cmd: '!session',
        desc: t('Shows statistics for your current session.'),
      },
      { cmd: '!kpd / !kdratio', desc: t('Shows your K/D statistics.') },
      {
        cmd: '!top10 / !top20 / !top5',
        desc: t('Shows the player leaderboards.'),
      },
      {
        cmd: '!statsme',
        desc: t('Shows a quick overview of your statistics.'),
      },
      { cmd: '!hlx_menu', desc: t('Opens the HLstatsX menu.') },
    ],
  },
  {
    title: t('Other Plugins'),
    items: [
      {
        cmd: 'bet <t|ct> <all|half|third|amount>',
        desc: t('TeamBets — places a bet on the round winner.'),
      },
      { cmd: 'bounty', desc: t('Shows the current bounty rewards.') },
      {
        cmd: '!comms',
        desc: t('Shows the status of your mute/gag restrictions.'),
      },
      {
        cmd: '!tagslist',
        desc: t('HexTags — selects an available tag, if permitted.'),
      },
      {
        cmd: '!trace',
        desc: t(
          'Spray trace — shows information about a spray, if the plugin is enabled.',
        ),
      },
    ],
  },
  {
    title: t('Demo / Report a Cheater'),
    items: [
      { cmd: 'record <demo_name>', desc: t('Starts recording a demo.') },
      { cmd: 'stop', desc: t('Stops recording the demo.') },
      { cmd: 'playdemo <demo_name>', desc: t('Plays a saved demo.') },
      {
        cmd: 'status',
        desc: t('Lists players and SteamIDs in the console for your report.'),
      },
    ],
  },
];
---

<Layout title={t('Commands | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">
        {t('Player Commands')}
      </h1>
    </header>
    <section class="panel fl-p-3/6" aria-label={t('Server command reference')}>
      <p class="fl-text-sm/base text-gray-300 fl-mb-3/6">
        {t('A complete overview of useful commands for our server. Use them')}{' '}
        <span class="font-semibold">{t('without a prefix')}</span>{' '}
        {t('in the console or')}{' '}
        <span class="font-semibold">{t('with the / or ! prefix')}</span>{' '}
        {t('in chat.')}
      </p>
      <div class="grid fl-gap-3/6 md:grid-cols-2 xl:grid-cols-3">
        {commandGroups.map((group) => (
          <article class="panel fl-p-3/6 transition hover:border-cyan-500/60">
            <h2 class="fl-mb-3/5 fl-text-lg/2xl font-bold text-cyan-300">
              {group.title}
            </h2>
            <ul class="space-y-3">
              {group.items.map((item) => (
                <li class="rounded border border-gray-800 bg-gray-950/70 fl-p-2/4">
                  <code
                    class="mb-1 block wrap-break-word fl-text-sm/base font-semibold text-lime-400"
                    translate="no"
                  >
                    {item.cmd}
                  </code>
                  <p class="fl-text-sm/base text-gray-300">{item.desc}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="fl-mt-4/8 rounded border border-amber-500/40 bg-amber-500/10 fl-p-3/5 fl-text-sm/base text-amber-200">
        <p class="font-semibold">{t('Note:')}</p>
        <p>
          {t(
            'Some commands may depend on permissions, the current game state (warmup/round), or a specific plugin. If a command does not work, try it without a prefix in the console, or with the',
          )}{' '}
          <code class="rounded bg-black/30 px-1" translate="no">
            /
          </code>{' '}
          {t('or')}{' '}
          <code class="rounded bg-black/30 px-1" translate="no">
            !
          </code>{' '}
          {t('prefix in chat. You can also check the')}{' '}
          <a
            href={localizedHref('/hitreg', locale)}
            class="font-semibold underline decoration-dotted hover:text-amber-100"
          >
            {t('Hitreg')}
          </a>{' '}
          {t('page.')}
        </p>
      </div>
    </section>
  </section>
</Layout>
