---
import Layout from '../layouts/Layout.astro';

const admins = ['Crazy69', 'Ipos', 'muso.sk', 'Zuzule'];
---

<Layout title="Admini | LaMaTeam">
  <section class="mx-auto w-full max-w-4xl px-4 py-8 text-left text-gray-100">
    <header class="mb-6 rounded-2xl border border-gray-700 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 p-6 shadow-2xl">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">Kdo je admin</h1>
    </header>
    <article class="rounded-2xl border border-gray-700 bg-gray-900/80 p-5 shadow-lg">
      <ul class="space-y-2">
        {admins.map((name) => <li class="rounded-xl border border-gray-800 bg-gray-950/70 px-3 py-2">{name}</li>)}
      </ul>
    </article>
  </section>
</Layout>
