---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { isCheckAdmin } from '../lib/check-admin';
import { translator } from '../lib/page-copy';
import { localeFromPath, type SiteLocale } from '../lib/localized-content';
interface Props {
  locale?: SiteLocale;
}
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const showCheck = isCheckAdmin(
  Astro.locals.steamProfile?.steamID,
  env.CHECK_ADMIN_STEAM64_ALLOWLIST,
);

const admins = ['Crazy69', 'Ipos', 'muso.sk', 'Zuzule'];
---

<Layout title={t('Admins | LaMaTeAm')} lang={locale}>
  <section class="w-full fl-py-2/5 text-left text-gray-100">
    <header class="fl-mb-4/6 page-heading flex flex-wrap items-center gap-4">
      <h1 class="fl-text-2xl/4xl font-bold tracking-tight">{t('Admins')}</h1>
    </header>
    <article class="space-y-6 panel fl-p-3/6 text-gray-200">
      {showCheck && (
        <section
          class="check-tool"
          data-check-page
          lang="en"
          aria-label="Player lookup"
        >
          <div class="check-toolbar">
            <h2 class="font-semibold">Check recent players</h2>
            <button type="button" data-check-refresh>
              Refresh
            </button>
          </div>
          <p class="check-muted" data-check-observed>
            Loading recent visits…
          </p>
          <p role="status" aria-live="polite" data-check-players-status>
            Loading identities…
          </p>
          <ul
            class="check-player-list"
            aria-label="Recent players"
            aria-busy="true"
            data-check-players
          />
          <noscript>JavaScript is required for player lookup.</noscript>
        </section>
      )}
      <header>
        <h2 class="fl-text-xl/3xl font-bold tracking-tight">
          {t('Admin Rules')}
        </h2>
        <p class="fl-mt-2/4 fl-text-sm/base text-gray-300">
          <em>{t('Not knowing the rules is no excuse.')}</em>
        </p>
      </header>
      <ul
        translate="no"
        class="flex flex-wrap items-center fl-gap-2/4 fl-text-sm/base text-gray-200"
      >
        {admins.map((name) => (
          <li class="rounded-lg border border-gray-700 bg-gray-950/70 px-3 py-2 font-semibold">
            {name}
          </li>
        ))}
      </ul>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">
          {t('1. Basic Admin Responsibilities')}
        </h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>
            <strong>{t('Atmosphere and conduct')}</strong>{' '}
            {t(
              '— Create a friendly atmosphere, do not act superior to regular players, and do not abuse your privileges.',
            )}
          </li>
          <li>
            <strong>{t('Following the rules')}</strong>{' '}
            {t(
              '— Admins must follow the same rules as players and must not change maps or start votes without a valid reason.',
            )}
          </li>
          <li>
            <strong>{t('Activity and communication')}</strong>{' '}
            {t(
              '— Stay active and give advance notice if you will be away for an extended period.',
            )}
          </li>
        </ul>
      </section>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">
          {t('2. Enforcement Procedure')}
        </h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>
            <strong>{t('Escalation')}</strong>{' '}
            {t(
              '— reminder → warning → kick/short ban; longer bans require evidence.',
            )}
          </li>
          <li>
            <strong>{t('Evidence')}</strong>{' '}
            {t(
              '— Record a demo or take screenshots when dealing with cheats, and keep the evidence for at least 14 days.',
            )}
          </li>
          <li>
            <strong>{t('Reason')}</strong>{' '}
            {t(
              '— Always provide a truthful and respectful reason for a punishment.',
            )}
          </li>
          <li>
            <strong>{t('Respect for other admins')}</strong>{' '}
            {t(
              "— Do not change another admin's punishment without discussing it first.",
            )}
          </li>
        </ul>
      </section>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">
          {t('3. Dealing with Cheaters')}
        </h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>{t('Observe the suspected player discreetly.')}</li>
          <li>
            {t('Record a demo with')}{' '}
            <code translate="no">record &lt;demo_name&gt;</code>{' '}
            {t('and finish it with')} <code translate="no">stop</code>.
          </li>
          <li>
            {t('Verify the SteamID with')} <code translate="no">status</code>.
          </li>
          <li>{t('Issue a ban when the cheating is clear.')}</li>
        </ul>
      </section>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">
          {t('4. Conduct Toward Players')}
        </h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>{t('Help players, but do not grant unreasonable requests.')}</li>
          <li>
            {t('Handle insults and spam progressively (mute/gag, kick, ban).')}
          </li>
        </ul>
      </section>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">
          {t('5. Commands and Team Management')}
        </h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>{t('Use admin commands appropriately for the situation.')}</li>
          <li>
            {t('Use SwapTeam only when the teams are clearly unbalanced.')}
          </li>
          <li>
            {t(
              'Change maps or start votes only when necessary (bug, plugin failure, or a large number of players leaving).',
            )}
          </li>
        </ul>
      </section>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">{t('6. Penalties for Admins')}</h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>{t('Head admins may review logs and evidence.')}</li>
          <li>
            {t(
              'Repeated or serious violations may result in the removal of admin privileges.',
            )}
          </li>
          <li>
            {t('Head admins decide whether privileges will be restored.')}
          </li>
        </ul>
      </section>
      <section>
        <h3 class="fl-text-lg/2xl font-bold">{t('7. Final Notes')}</h3>
        <ul class="mt-2 list-disc space-y-2 pl-5">
          <li>
            {t('Admins are here to support the community and fair play.')}
          </li>
          <li>{t('Stay calm and communicate respectfully.')}</li>
          <li>{t('Contact the head admins if anything is unclear.')}</li>
        </ul>
      </section>
    </article>
  </section>
</Layout>

<script>
  import '../scripts/check/client';
</script>

<style>
  .check-tool {
    border: 1px solid #374151;
    border-radius: 0.75rem;
    padding: 1rem;
  }
  .check-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .check-tool :global([hidden]) {
    display: none !important;
  }
  .check-tool :global(button),
  .check-tool :global(a) {
    min-height: 2.75rem;
  }
  .check-tool :global(button) {
    cursor: pointer;
  }
  .check-tool :global(button:focus-visible),
  .check-tool :global(a:focus-visible) {
    outline: 2px solid #fbbf24;
    outline-offset: 3px;
  }
  .check-toolbar button {
    border: 1px solid #4b5563;
    border-radius: 0.5rem;
    padding: 0.4rem 0.8rem;
  }
  .check-muted,
  .check-tool :global(small),
  .check-tool :global(dt) {
    color: #9ca3af;
    font-size: 0.8rem;
  }
  .check-tool :global([data-flagged='true']) {
    color: #fde68a;
  }
  .check-player-list {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
  }
  .check-player-list :global(li) {
    border-top: 1px solid #374151;
  }
  .check-player-list :global(.check-player-toggle) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.65rem 0;
    text-align: left;
  }
  .check-player-list :global(.check-player-toggle:hover),
  .check-player-list :global(.check-player-toggle[aria-expanded='true']) {
    color: #fbbf24;
  }
  .check-player-list :global(.check-player-info) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .check-player-list :global(strong),
  .check-player-list :global(small) {
    display: block;
  }
  .check-player-list :global(.check-results) {
    padding: 0.75rem;
    margin-bottom: 0.75rem;
    border-radius: 0.5rem;
    background: #111827;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .check-player-list :global(dl) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.75rem;
    margin-block: 0.75rem;
  }
  .check-player-list :global(dd) {
    margin: 0;
  }
  .check-player-list :global(a) {
    display: inline-flex;
    align-items: center;
    color: #fbbf24;
    text-decoration: underline;
  }
</style>
