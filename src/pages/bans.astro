---
import Layout from '../layouts/Layout.astro';
import BanTable from '../components/BanTable.astro';
import { loadSourceBans } from '../lib/sourcebans';

export const prerender = false;
const result = await loadSourceBans();
Astro.response.headers.set('Cache-Control', 'no-store');
if (!result.data) Astro.response.status = 503;
---

<Layout title="Ban List | LaMaTeAm">
  <BanTable {...result} />
</Layout>
