---
interface Props {
  current: 'player' | 'server' | 'admin';
}

const { current } = Astro.props;

const tabs = [
  { id: 'player', label: 'Hráč guide', href: '/player-guide' },
  { id: 'server', label: 'Server guide', href: '/server-guide' },
  { id: 'admin', label: 'Admin guide', href: '/admin-guide' },
] as const;
---

<nav class="mb-6 flex flex-wrap items-center justify-center gap-2">
  {
    tabs.map((tab) => {
      const isCurrent = tab.id === current;
      return (
        <a
          href={tab.href}
          class={`rounded-lg border px-4 py-2 text-sm font-semibold transition ${isCurrent
            ? 'border-cyan-400 bg-cyan-500/20 text-cyan-200'
            : 'border-gray-700 bg-gray-900/70 text-gray-200 hover:border-cyan-500/70 hover:text-cyan-200'}`}
          aria-current={isCurrent ? 'page' : undefined}
        >
          {tab.label}
        </a>
      );
    })
  }
</nav>
