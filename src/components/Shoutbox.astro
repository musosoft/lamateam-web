---
// src/components/Shoutbox.astro
export interface Props {
  baseUrl: string;
  session: any; // Define session prop type
}

const { baseUrl, session } = Astro.props;
console.log('Base URL:', import.meta.env.PUBLIC_SITE_URL || process.env.PUBLIC_SITE_URL);


// Detect in-game user and query parameters
const communityId = Astro.url.searchParams.get('communityid');
const playerNameQuery = Astro.url.searchParams.get('name');
const isGame = navigator.userAgent.includes('Valve Client');

// Determine if the user is authenticated either via session or in-game query parameters
const isAuthenticated = (isGame && communityId && playerNameQuery) || Boolean(session?.steamID);

// Determine which player details to display
const displayPlayerName = isGame && playerNameQuery ? playerNameQuery : session?.playerName || "Guest";
const displayPlayerAvatar = session?.playerAvatar || '/assets/default-avatar.webp';
---

<div class="flex flex-col space-y-4 max-h-[400px] w-full p-4 bg-gray-800 rounded-md text-white text-sm">
  {isAuthenticated ? (
    <div class="flex items-center space-x-2">
      <img src={displayPlayerAvatar} alt="Player Avatar" class="w-8 h-8 rounded-full" />
      <div class="text-green-500">Welcome, {displayPlayerName}</div>
    </div>
  ) : (
    <a href="/api/auth/steam" class="text-blue-500 underline">Login with Steam</a>
  )}

  <form id="shoutboxForm" class="flex gap-2 items-center" onsubmit="return false;">
    <input
      type="text"
      id="messageInput"
      placeholder="Enter your message"
      class="flex-1 p-2 rounded-md border border-gray-600 bg-gray-900 text-white"
      autocomplete="off"
      disabled={!isAuthenticated}
    />
    <button type="button" id="sendButton" class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md" disabled={!isAuthenticated}>
      Send
    </button>
  </form>

  <div id="shoutboxMessages" class="flex-1 overflow-y-auto p-2 bg-gray-800 rounded-md text-white text-sm">
    <!-- Messages will load here dynamically -->
  </div>
</div>

<script is:inline define:vars={{ baseUrl, isAuthenticated, displayPlayerName, displayPlayerAvatar }}>
  document.addEventListener('DOMContentLoaded', async function () {
    console.log('Client-side Environment Variables:', {
      PUBLIC_SITE_URL: baseUrl,
    });
    console.log('Document loaded');
    const isGame = userAg
    const userAgent = navent.includes('Valve Client');
    console.log('User Agent:', userAgent);
    console.log('Is Game:', isGame);

    const urlParams = new URLSearchParams(window.location.search);
    const communityId = urlParams.get('communityid');
    const playerNameQuery = urlParams.get('name');
    console.log('Community ID:', communityId);
    console.log('Player Name Query:', playerNameQuery);

    const welcomeMessage = document.getElementById('welcome-message');
    const avatarImage = document.getElementById('player-avatar');

    console.log('Checking for required elements in the DOM.');
    if (!welcomeMessage || !avatarImage) {
      console.error('Required elements not found in DOM.');
      return;
    }

    if (isGame && communityId && playerNameQuery) {
      console.log('In-game parameters detected. Updating UI.');
      welcomeMessage.innerText = `Welcome, ${playerNameQuery}`;
      avatarImage.src = '/assets/default-avatar.webp'; // Replace with Steam avatar if available
      document.getElementById('messageInput').disabled = false;
      document.getElementById('sendButton').disabled = false;
      console.log('UI update for in-game authentication complete.');
    } else {
      console.log('In-game authentication not triggered.');
    }

    const sendButton = document.getElementById('sendButton');
    const messageInput = document.getElementById('messageInput');

    if (!isAuthenticated) return;

    async function fetchMessages() {
      try {
        const response = await fetch(`${baseUrl}api/shoutbox`);
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        
        const data = await response.json();
        renderMessages(data);
      } catch (error) {
        console.error('Error fetching messages:', error);
      }
    }

    function renderMessages(messages) {
      const shoutboxContainer = document.getElementById('shoutboxMessages');
      shoutboxContainer.innerHTML = ""; // Clear existing messages
      messages.forEach((msg) => {
        const messageElement = document.createElement('div');
        messageElement.className = "flex items-center space-x-2 p-1";
        const avatar = document.createElement('img');
        avatar.src = msg.player_avatar || '/assets/default-avatar.webp';
        avatar.alt = 'Player Avatar';
        avatar.className = 'w-6 h-6 rounded-full';
        const text = document.createElement('div');
        text.textContent = `${msg.player_name}: ${msg.message} (${new Date(msg.timestamp).toLocaleTimeString()})`;
        messageElement.appendChild(avatar);
        messageElement.appendChild(text);
        shoutboxContainer.appendChild(messageElement);
      });
      shoutboxContainer.scrollTop = 0; // Auto-scroll to latest message
    }

    async function handleSubmit() {
      const newMessage = messageInput.value.trim();
      if (!newMessage) return;

      try {
        const response = await fetch(`${baseUrl}api/shoutbox`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            player_name: displayPlayerName,
            player_avatar: displayPlayerAvatar,
            message: newMessage
          }),
        });
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        
        messageInput.value = ''; // Clear input field
        fetchMessages(); // Refresh messages after sending
      } catch (error) {
        console.error('Error submitting message:', error);
      }
    }

    fetchMessages(); // Load messages initially
    sendButton.addEventListener('click', handleSubmit); // Use button click for submission
  });
</script>

