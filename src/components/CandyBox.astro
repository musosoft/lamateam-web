---
// src/components/CandyBox.astro
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  hidden?: boolean;
}

const { href = '/', hidden = false } = Astro.props;
---

{
  !hidden && (
    <a
      href={href}
      class="fixed right-2 top-2 z-50 rounded-lg bg-gray-600 p-2 text-white shadow-lg transition hover:bg-blue-700"
      aria-label="Domů"
      title="Domů"
    >
      <Icon name="mdi:home" class="h-7 w-7" />
    </a>
  )
}
