---
// src/components/CandyBox.astro
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  hidden?: boolean;
}

const { href = '/', hidden = false } = Astro.props;
---

{
  !hidden && (
    <a
      href={href}
      class="fixed left-2 top-2 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-blue-500/15 text-blue-400 shadow-md transition-all duration-200 hover:bg-blue-500/30 hover:text-white hover:scale-110 hover:shadow-blue-500/20 hover:shadow-lg"
      aria-label="Domů"
    >
      <Icon name="mdi:home" class="h-6 w-6" />
    </a>
  )
}
