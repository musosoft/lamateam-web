---
import { Icon } from 'astro-icon/components';
import { env } from 'cloudflare:workers';
import { localeFromPath } from '../lib/localized-content';
import { translator, chatCopy } from '../lib/page-copy';
import { selectHomeLocale } from '../lib/motd-locale';
const locale =
  selectHomeLocale({
    pathname: Astro.url.pathname,
    userAgent: Astro.request.headers.get('user-agent'),
    acceptLanguage: Astro.request.headers.get('accept-language'),
    country: Astro.request.cf?.country as string | undefined,
  }) ?? localeFromPath(Astro.url.pathname);
const t = translator(locale);
const gamePlaceholder = {
  en: 'Click Send to chat',
  cs: 'Klikněte na Odeslat',
  sk: 'Kliknite na Odoslať',
  pl: 'Kliknij Wyślij',
  hu: 'Kattints a Küldésre',
  de: 'Zum Chatten Senden anklicken',
  uk: 'Натисніть Надіслати',
  fr: 'Cliquez sur Envoyer',
}[locale];
const baseUrl = env.PUBLIC_BASE_URL || '/';
const cookies = Astro.cookies;
function parseSessionCookie() {
  const raw = cookies.get('session')?.value;
  if (!raw) return {};
  try {
    return JSON.parse(decodeURIComponent(raw));
  } catch {
    return {};
  }
}
const userAgent = Astro.request.headers.get('user-agent')?.toLowerCase() || '';
const isGame = userAgent.includes('valve') || userAgent.includes('steam');
const rawCommunityId =
  Astro.url.searchParams.get('communityid') ||
  cookies.get('communityid')?.value ||
  '';
const rawPlayerName =
  Astro.url.searchParams.get('name') || cookies.get('name')?.value || '';
function convertToSteam64(communityId: string): string {
  const match = communityId.match(/^\[U:1:(\d+)\]$/);
  return match
    ? (BigInt(match[1]) + BigInt('76561197960265728')).toString()
    : communityId;
}
const session = parseSessionCookie();
const steamID =
  isGame && rawCommunityId
    ? convertToSteam64(rawCommunityId)
    : session?.steamID || '';
const playerName =
  isGame && rawCommunityId
    ? rawPlayerName || 'Guest'
    : session?.playerName || 'Guest';
const isAuthenticated = !!(steamID && playerName !== 'Guest');
async function fetchSteamAvatar(steam64: string) {
  if (!env.STEAM_API_KEY) return '/assets/default-avatar.webp';
  try {
    const response = await fetch(
      `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/?key=${env.STEAM_API_KEY}&steamids=${steam64}`,
    );
    if (!response.ok) return '/assets/default-avatar.webp';
    const data = (await response.json()) as {
      response?: { players?: Array<{ avatarfull?: string }> };
    };
    return (
      data.response?.players?.[0]?.avatarfull || '/assets/default-avatar.webp'
    );
  } catch {
    return '/assets/default-avatar.webp';
  }
}
const playerAvatar = steamID
  ? await fetchSteamAvatar(steamID)
  : '/assets/default-avatar.webp';
---

<div
  id="live-chat-shell"
  transition:persist="live-chat"
  data-base-url={baseUrl}
  data-steam-id={steamID}
  data-player-name={playerName}
  data-player-avatar={playerAvatar}
  data-authenticated={String(isAuthenticated)}
  data-default-open={String(isGame)}
  data-session-render={Astro.isPrerendered ? 'static' : 'request'}
  data-locale={locale}
  data-copy={JSON.stringify(chatCopy(locale))}
>
  <section
    id="live-chat-panel"
    class="live-chat-panel"
    aria-labelledby="shoutbox-title"
    hidden
  >
    <header class="live-chat-heading">
      <div>
        <p class="eyebrow">LaMaTeAm</p>
        <h2 id="shoutbox-title" tabindex="-1">
          {t('Live Chat')}
        </h2>
      </div>
      <button
        type="button"
        class="chat-close"
        aria-label={t('Close Live Chat')}
        aria-controls="live-chat-panel"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="chat-account">
      {isAuthenticated ? (
        <span translate="no">{playerName}</span>
      ) : (
        <a href="/api/auth/steam" data-astro-reload>
          {t('Sign in with Steam to chat')}
        </a>
      )}
    </div>
    <div
      id="shoutboxMessages"
      class="shoutbox-feed"
      data-no-translate
      aria-live="polite"
      aria-label={t('Recent community messages')}
    >
      <p class="shoutbox-status">{t('Loading messages…')}</p>
    </div>
    <form id="shoutboxForm" class="chat-compose">
      <label for="messageInput" class="sr-only">
        {t('Your message')}
      </label>
      <input
        type="text"
        id="messageInput"
        placeholder={
          isAuthenticated
            ? t('Say hello to the team…')
            : t('Sign in with Steam to chat')
        }
        autocomplete="off"
        maxlength="500"
        data-game-placeholder={gamePlaceholder}
        disabled={!isAuthenticated}
      />
      <button
        type="submit"
        id="sendButton"
        class="connect-button"
        disabled={!isAuthenticated}
      >
        {t('Send')}
      </button>
    </form>
    <p
      id="shoutbox-status"
      class="shoutbox-status"
      role="status"
      aria-live="polite"
    ></p>
  </section>
  <button
    type="button"
    id="chat-launcher"
    class="chat-launcher"
    aria-label={t('Open Live Chat')}
    aria-controls="live-chat-panel"
    aria-expanded="false"
    title={t('Live Chat')}
  >
    <Icon name="mdi:chat-outline" class="h-6 w-6" />
  </button>
</div>
<script>
  let cleanupChat: (() => void) | undefined;
  function initializeChat() {
    cleanupChat?.();
    const shell = document.querySelector<HTMLElement>('#live-chat-shell');
    if (!shell) return;
    const copy: Record<string, string> = JSON.parse(shell.dataset.copy || '{}');
    const tc = (key: string) => {
      const value = copy[key];
      if (!value) throw new Error(`Missing chat copy: ${key}`);
      return value;
    };
    const relativeTime = new Intl.RelativeTimeFormat(
      shell.dataset.locale || 'en',
      { numeric: 'auto' },
    );
    const panel = shell.querySelector<HTMLElement>('#live-chat-panel')!;
    const launcher = shell.querySelector<HTMLButtonElement>('#chat-launcher')!;
    const close = shell.querySelector<HTMLButtonElement>('.chat-close')!;
    const input = shell.querySelector<HTMLInputElement>('#messageInput')!;
    const send = shell.querySelector<HTMLButtonElement>('#sendButton')!;
    const form = shell.querySelector<HTMLFormElement>('#shoutboxForm')!;
    // Check the actual client UA too: persisted/prerendered shells may be static.
    const inGame = /valve|steam/i.test(navigator.userAgent);
    const feed = shell.querySelector<HTMLElement>('#shoutboxMessages')!;
    const status = shell.querySelector<HTMLElement>('#shoutbox-status')!;
    const controller = new AbortController();
    const { signal } = controller;
    if (inGame) input.placeholder = input.dataset.gamePlaceholder!;
    input.addEventListener(
      'keydown',
      (event) => {
        // Spaces remain ordinary text. Only implicit Enter submission is unsafe.
        if (inGame && event.key === 'Enter' && !event.isComposing) {
          event.preventDefault();
        }
      },
      { signal },
    );
    // Guard keyboard activation on Send as well as implicit input submission.
    // Literal spaces in the text input are never intercepted.
    send.addEventListener(
      'keydown',
      (event) => {
        if (inGame && ['Enter', ' ', 'Spacebar'].includes(event.key)) {
          event.preventDefault();
        }
      },
      { signal },
    );
    let pointerSend = false;
    let pointerReset: number | undefined;
    send.addEventListener(
      'click',
      (event) => {
        pointerSend = !inGame || event.detail > 0;
        if (inGame && !pointerSend) event.preventDefault();
        window.clearTimeout(pointerReset);
        // Native click default submission runs after event listeners; retain
        // permission through that default action, but not into another task.
        pointerReset = window.setTimeout(() => {
          pointerSend = false;
        }, 0);
      },
      { signal },
    );
    const requests = new Set<AbortController>();
    const preference = 'lamateam-chat-open';
    const authenticated = shell.dataset.authenticated === 'true';
    let posting = false;
    let reading = false;
    let refreshQueued = false;
    let refreshed = false;
    const base = shell.dataset.baseUrl || '/';
    const endpoint = `${base.endsWith('/') ? base : base + '/'}api/shoutbox`;
    input.disabled = send.disabled = !authenticated;
    const request = async (options?: RequestInit) => {
      const pending = new AbortController();
      requests.add(pending);
      const timeout = window.setTimeout(() => pending.abort(), 12_000);
      try {
        const response = await fetch(endpoint, {
          credentials: 'same-origin',
          ...options,
          signal: pending.signal,
        });
        if (!response.ok) throw new Error('Chat unavailable');
        return options?.method === 'POST' ? null : await response.json();
      } finally {
        window.clearTimeout(timeout);
        requests.delete(pending);
      }
    };
    const timeSince = (timestamp: string) => {
      const elapsed = Date.now() - new Date(timestamp).getTime();
      if (!Number.isFinite(elapsed)) return tc('Invalid time');
      const seconds = Math.max(0, Math.floor(elapsed / 1000));
      for (const [unit, size] of [
        ['year', 31536000],
        ['month', 2592000],
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
        ['second', 1],
      ] as const) {
        if (seconds >= size || size === 1) {
          const count = Math.floor(seconds / size);
          return relativeTime.format(-count, unit);
        }
      }
    };
    const renderMessages = (
      messages: Array<{
        player_avatar?: string;
        player_name: string;
        message: string;
        timestamp: string;
      }>,
    ) => {
      // Keep messages as text, and outside the translation capture.
      const previous = feed.textContent;
      const fragment = document.createDocumentFragment();
      if (!messages.length) {
        const empty = document.createElement('p');
        empty.className = 'shoutbox-status';
        empty.textContent = tc('No messages yet. Start the conversation.');
        fragment.append(empty);
      }
      messages.forEach(({ player_avatar, player_name, message, timestamp }) => {
        const row = document.createElement('div');
        row.className = 'shoutbox-message';
        const avatar = document.createElement('img');
        avatar.src = '/assets/default-avatar.webp';
        try {
          const url = new URL(player_avatar || '');
          if (url.protocol === 'https:') avatar.src = url.href;
        } catch {}
        avatar.alt = '';
        avatar.loading = 'lazy';
        const content = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = player_name;
        const text = document.createElement('p');
        (text as ParentNode).append(
          name,
          document.createTextNode(': ' + message),
        );
        const time = document.createElement('time');
        time.textContent = timeSince(timestamp) || '';
        (content as ParentNode).append(text, time);
        (row as ParentNode).append(avatar, content);
        fragment.append(row);
      });
      // Avoid repeating live-region announcements on an unchanged poll.
      if (fragment.textContent !== previous) feed.replaceChildren(fragment);
    };
    const fetchMessages = async () => {
      if (signal.aborted) return;
      if (reading) {
        refreshQueued = true;
        return;
      }
      reading = true;
      try {
        const messages = await request();
        if (
          !Array.isArray(messages) ||
          messages.some(
            (m) =>
              !m ||
              typeof m.player_name !== 'string' ||
              typeof m.message !== 'string' ||
              typeof m.timestamp !== 'string',
          )
        )
          throw new Error('Invalid messages');
        if (!signal.aborted) {
          renderMessages(messages);
          refreshed = true;
        }
      } catch {
        if (!signal.aborted) {
          if (!refreshed)
            feed.textContent = tc(
              'Chat is unavailable right now. Please try again shortly.',
            );
          else
            status.textContent = tc(
              'Chat updates are temporarily unavailable.',
            );
        }
      } finally {
        reading = false;
        if (refreshQueued && !signal.aborted) {
          refreshQueued = false;
          if (!panel.hidden) void fetchMessages();
        }
      }
    };
    const setOpen = (open: boolean, moveFocus = false) => {
      panel.hidden = !open;
      launcher.hidden = open;
      launcher.setAttribute('aria-expanded', String(open));
      try {
        localStorage.setItem(preference, String(open));
      } catch {}
      if (moveFocus) {
        if (open) panel.querySelector<HTMLElement>('#shoutbox-title')?.focus();
        else launcher.focus();
      }
      if (open) void fetchMessages();
    };
    // First-time game visitors start open; an explicit close survives route
    // transitions instead of unexpectedly restoring the sidebar track.
    let saved = inGame || shell.dataset.defaultOpen === 'true';
    try {
      const stored = localStorage.getItem(preference);
      if (stored !== null) saved = stored === 'true';
    } catch {}
    const linkedToChat = ['#shoutbox-title', '#live-chat-panel'].includes(
      window.location?.hash ?? '',
    );
    setOpen(saved || linkedToChat, (inGame && saved) || linkedToChat);
    launcher.addEventListener('click', () => setOpen(true, true), { signal });
    close.addEventListener('click', () => setOpen(false, true), { signal });
    panel.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape') {
          event.stopPropagation();
          setOpen(false, true);
        }
      },
      { signal },
    );
    // A non-modal panel must not cover a keyboard user's focused page control.
    document.addEventListener(
      'focusin',
      (event) => {
        if (
          inGame ||
          panel.hidden ||
          !(event.target instanceof HTMLElement) ||
          shell.contains(event.target)
        )
          return;
        const focus = event.target.getBoundingClientRect();
        const box = panel.getBoundingClientRect();
        if (
          focus.right > box.left &&
          focus.left < box.right &&
          focus.bottom > box.top &&
          focus.top < box.bottom
        )
          setOpen(false);
      },
      { signal },
    );
    form.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();
        if (inGame && !pointerSend) return;
        const message = input.value.trim();
        if (!authenticated || posting || !message) return;
        posting = true;
        send.disabled = true;
        status.textContent = tc('Sending…');
        try {
          await request({
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              steamid: shell.dataset.steamId,
              player_name: shell.dataset.playerName,
              player_avatar: shell.dataset.playerAvatar,
              message,
            }),
          });
          if (signal.aborted) return;
          input.value = '';
          status.textContent = tc('Message sent.');
          void fetchMessages();
        } catch {
          if (!signal.aborted)
            status.textContent = tc('Message not sent. Please try again.');
        } finally {
          posting = false;
          if (!signal.aborted) send.disabled = !authenticated;
        }
      },
      { signal },
    );
    const timer = window.setInterval(() => {
      if (!panel.hidden && document.visibilityState === 'visible')
        void fetchMessages();
    }, 30_000);
    cleanupChat = () => {
      controller.abort();
      window.clearTimeout(pointerReset);
      window.clearInterval(timer);
      requests.forEach((request) => request.abort());
      requests.clear();
    };
  }
  initializeChat();
  document.addEventListener('astro:page-load', initializeChat);
  document.addEventListener('astro:before-swap', (event) => {
    cleanupChat?.();
    const current = document.querySelector<HTMLElement>('#live-chat-shell');
    const incoming = (
      event as Event & { newDocument?: Document }
    ).newDocument?.querySelector<HTMLElement>('#live-chat-shell');
    // Persist drafts/messages across navigation, but refresh view credentials
    // from a request-rendered page. Static SEO pages have no session snapshot.
    if (!current || !incoming || incoming.dataset.sessionRender !== 'request')
      return;
    const input = current.querySelector<HTMLInputElement>('#messageInput');
    if (input && current.dataset.steamId !== incoming.dataset.steamId)
      input.value = '';
    for (const key of [
      'baseUrl',
      'steamId',
      'playerName',
      'playerAvatar',
      'authenticated',
      'defaultOpen',
      'sessionRender',
      'locale',
      'copy',
    ])
      current.dataset[key] = incoming.dataset[key];
    const account = current.querySelector('.chat-account');
    const nextAccount = incoming.querySelector('.chat-account');
    if (account && nextAccount)
      account.replaceChildren(
        ...Array.from(nextAccount.childNodes, (node) => node.cloneNode(true)),
      );
    const nextInput = incoming.querySelector<HTMLInputElement>('#messageInput');
    if (input && nextInput) {
      input.dataset.gamePlaceholder = nextInput.dataset.gamePlaceholder;
      input.placeholder = /valve|steam/i.test(navigator.userAgent)
        ? nextInput.dataset.gamePlaceholder!
        : nextInput.placeholder;
    }
    // Persist drafts and user messages, but take control labels from the new
    // server-rendered locale. This is component hydration, not translation.
    for (const selector of [
      '#shoutbox-title',
      '#sendButton',
      'label[for="messageInput"]',
    ]) {
      const target = current.querySelector(selector);
      const source = incoming.querySelector(selector);
      if (target && source) target.textContent = source.textContent;
    }
    for (const selector of [
      '#chat-launcher',
      '.chat-close',
      '#shoutboxMessages',
    ]) {
      const target = current.querySelector(selector);
      const source = incoming.querySelector(selector);
      if (!target || !source) continue;
      for (const attribute of ['aria-label', 'title']) {
        const value = source.getAttribute(attribute);
        if (value !== null) target.setAttribute(attribute, value);
      }
    }
  });
</script>
