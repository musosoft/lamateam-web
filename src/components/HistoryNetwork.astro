---
interface Props {
  nodes: Array<{
    id: string;
    name: string;
    kind: 'community' | 'server' | 'person' | 'project' | 'provider';
    summary: string;
    period: string;
  }>;
  links: Array<{
    from: string;
    to: string;
    kind: string;
    account: string;
    period: string;
  }>;
}

const { nodes } = Astro.props;
const names = new Map(nodes.map(({ id, name }) => [id, name]));
const displayNames: Record<string, string> = {
  rivals: 'Rivals',
  zaparit: 'Zaparit.cz',
  tweakgaming: 'NL Tweakgaming',
  'old-vega': 'Old VEGA',
};
// Equal calendar-year spacing throughout; dense history remains scrollable.
const x = (year: number) => 90 + (year - 2006) * 110;
const horizon = 2027;
const graphWidth = x(2027.5) + 40;
const graphHeight = 930;

// Approximate editorial positions, not researched launch/closure timestamps.
// Archive captures establish observations only, not continuous server operation.
// The topology follows the owner's latest correction, not the older links prop.
const position = {
  agt: x(2006),
  zonax: x(2009),
  vcielka: x(2010),
  vcielkaEnd: x(2015),
  vcielkaJoin: x(2013.35),
  zonaxJoin: x(2013.15),
  zoneMerge: x(2013.5),
  gamesStart: x(2011.8),
  // Layout only: Games joined existing AGZ before Sep 2014; no exact date known.
  gamesJoin: x(2014.1),
  avalonStart: x(2018),
  battleStart: x(2013.25),
  battleMerge: x(2014.7),
  redStart: x(2011),
  // Owner's approximate sequence: Black Birds starts as Red Skillers ends.
  birdsStart: x(2015),
  birdsMerge: x(2015),
  rivalsMerge: x(2015.55),
  noobStart: x(2011),
  noobEnd: x(2016),
  // Confirmed participant move before 2014, not a server merger or closure.
  // Both connector positions are editorial; observations continue through 2016.
  noobDeparture: x(2012.65),
  noobJoin: x(2013),
  // Old VEGA's participant handoff is undated; route into Black Birds' start.
  oldVegaStart: x(2010),
  oldVegaEnd: x(2014.3),
  oldVegaJoin: x(2014.55),
  // Independent partnership, not a merger; both positions are editorial only.
  germanyStart: x(2008),
  germanyJoin: x(2012.85),
  // Owner-recalled approximate closure, independent of the partnership.
  germanyEnd: x(2018),
  // Editorial extension only; the Rivals → Red Skillers handoff is approximate.
  mainPause: x(2019),
  redReopens: x(2019),
  jzdStart: x(2021),
  jzdMerge: x(2021),
  // Layout-only rejoin: the JZD → LaMaTeAm handoff is undated.
  lamaMerge: x(2024),
  zaparitStart: x(2007),
  zaparitEnd: x(2015),
  zaparitJoin: x(2015.15),

  tweakStart: x(2008),
  // Original NL server's owner-recalled approximate closure, not archive range.
  tweakEnd: x(2012),
  // Owner recalls providing servers during Tweakgaming's own difficulties.
  // Approximate timing, before ZonaX joins the AGT/main lane.
  tweakProvision: x(2011.2),
  end: x(2027.5),
};
const lane = {
  main: 268,
  vcielka: 70,
  games: 105,
  zonax: 145,
  battle: 200,
  germany: 350,
  birds: 410,
  avalon: 105,
  red: 465,
  jzd: 540,
  noob: 630,
  zaparit: 720,
  oldVega: 800,
  tweak: 885,
};
const color = {
  main: '#b8a0ff',
  agz: '#6d9fff',
  zonax: '#68d5c0',
  battle: '#99a9fa',
  red: '#edac79',
  birds: '#f18faa',
  rivals: '#d6b8ff',
  germany: '#79c7b4',
  jzd: '#74d69d',
  lama: '#f2ce75',
  noob: '#8cb7f8',
  zaparit: '#d4c27d',
  vcielka: '#7dd5e8',
  oldVega: '#c9a0da',
  tweak: '#a7c784',
  games: '#e5b5dd',
  gamesMuted: '#8b909b',
  avalon: '#e5b5dd',
};

type Marker = {
  id: string;
  x: number;
  y: number;
  labelY: number;
  color: string;
  labelX?: number;
  anchor?: 'start' | 'end';
};
const markers: Marker[] = [
  {
    id: 'agteam',
    x: position.agt,
    y: lane.main,
    labelY: lane.main - 28,
    color: color.main,
  },
  {
    id: 'zonax',
    x: position.zonax,
    y: lane.zonax,
    labelY: lane.zonax - 24,
    color: color.zonax,
  },
  {
    id: 'aggressive-zone',
    x: position.zoneMerge,
    y: lane.main,
    labelY: lane.main - 35,
    color: color.agz,
    labelX: position.zoneMerge - 38,
    anchor: 'end' as const,
  },
  {
    id: 'battleforce',
    x: position.battleStart,
    y: lane.battle,
    labelY: lane.battle - 24,
    labelX: position.battleStart - 16,
    anchor: 'end' as const,
    color: color.battle,
  },
  {
    id: 'rivals',
    x: position.rivalsMerge,
    y: lane.main,
    labelY: lane.main - 28,
    color: color.rivals,
  },
  {
    id: 'red-skillers',
    x: position.redStart,
    y: lane.red,
    labelY: lane.red - 24,
    color: color.red,
  },
  {
    id: 'black-birds',
    x: position.birdsStart,
    y: lane.birds,
    labelY: lane.birds + 28,
    labelX: position.birdsStart + 16,
    color: color.birds,
  },
  {
    id: 'red-skillers',
    x: position.redReopens,
    y: lane.red,
    labelY: lane.red - 24,
    labelX: position.redReopens + 16,
    color: color.red,
  },
  {
    id: 'jzd',
    x: position.jzdStart,
    y: lane.jzd,
    labelY: lane.jzd + 32,
    color: color.jzd,
  },
  {
    id: 'lamateam',
    x: position.lamaMerge,
    y: lane.main,
    labelY: lane.main - 28,
    color: color.lama,
  },
  {
    id: 'noobstyle',
    x: position.noobStart,
    y: lane.noob,
    labelY: lane.noob - 24,
    color: color.noob,
  },
  {
    id: 'zaparit',
    x: position.zaparitStart,
    y: lane.zaparit,
    labelY: lane.zaparit - 24,
    color: color.zaparit,
  },
  {
    id: 'vcielka',
    x: position.vcielka,
    y: lane.vcielka,
    labelY: lane.vcielka - 20,
    color: color.vcielka,
  },
  {
    id: 'old-vega',
    x: position.oldVegaStart,
    y: lane.oldVega,
    labelY: lane.oldVega - 24,
    color: color.oldVega,
  },
  {
    id: 'tweakgaming',
    x: position.tweakStart,
    y: lane.tweak,
    labelY: lane.tweak - 24,
    color: color.tweak,
  },
  {
    id: 'gamers-germany',
    x: position.germanyStart,
    y: lane.germany,
    labelY: lane.germany - 24,
    color: color.germany,
  },
  {
    id: 'games-community',
    x: position.gamesStart,
    y: lane.games,
    labelY: lane.games + 20,
    color: color.games,
  },
  {
    id: 'avalon',
    x: position.avalonStart,
    y: lane.avalon,
    labelY: lane.avalon - 24,
    labelX: position.avalonStart + 16,
    color: color.avalon,
  },
].filter(({ id }) => names.has(id));

const paths = [
  {
    ids: ['agteam', 'aggressive-zone'],
    d: `M ${position.agt} ${lane.main} H ${position.zonaxJoin}`,
    color: color.main,
  },
  {
    ids: ['zonax', 'aggressive-zone'],
    d: `M ${position.zonax} ${lane.zonax} H ${position.zonaxJoin} V ${lane.main} H ${position.zoneMerge}`,
    color: color.zonax,
  },
  {
    ids: ['aggressive-zone', 'battleforce'],
    d: `M ${position.zoneMerge} ${lane.main} H ${position.battleMerge}`,
    color: color.agz,
  },
  {
    ids: ['battleforce'],
    d: `M ${position.battleStart} ${lane.battle} H ${position.battleMerge} V ${lane.main}`,
    color: color.battle,
  },
  {
    ids: ['battleforce', 'rivals'],
    d: `M ${position.battleMerge} ${lane.main} H ${position.rivalsMerge}`,
    color: color.battle,
  },
  {
    ids: ['rivals'],
    d: `M ${position.rivalsMerge} ${lane.main} H ${position.mainPause}`,
    color: color.rivals,
  },
  {
    ids: ['rivals', 'red-skillers'],
    d: `M ${position.mainPause} ${lane.main} V ${lane.red}`,
    color: color.red,
    movement: true,
  },
  {
    ids: ['lamateam'],
    d: `M ${position.lamaMerge} ${lane.main} H ${x(horizon)}`,
    color: color.lama,
  },
  {
    ids: ['lamateam'],
    d: `M ${x(horizon)} ${lane.main} H ${position.end}`,
    color: color.lama,
    continuation: true,
  },
  {
    ids: ['red-skillers', 'black-birds'],
    d: `M ${position.redStart} ${lane.red} H ${position.birdsMerge} V ${lane.birds}`,
    color: color.red,
  },
  {
    ids: ['black-birds', 'rivals'],
    d: `M ${position.birdsStart} ${lane.birds} H ${position.rivalsMerge} V ${lane.main}`,
    color: color.birds,
  },
  {
    ids: ['red-skillers', 'jzd'],
    d: `M ${position.redReopens} ${lane.red} H ${position.jzdMerge} V ${lane.jzd}`,
    color: color.red,
  },
  {
    ids: ['jzd', 'lamateam'],
    d: `M ${position.jzdStart} ${lane.jzd} H ${position.lamaMerge} V ${lane.main}`,
    color: color.jzd,
  },
  {
    ids: ['noobstyle'],
    d: `M ${position.noobStart} ${lane.noob} H ${position.noobEnd}`,
    color: color.noob,
  },
  {
    ids: ['noobstyle', 'aggressive-zone'],
    d: `M ${position.noobDeparture} ${lane.noob} V ${lane.noob - 20} H ${position.noobJoin} V ${lane.main}`,
    color: color.noob,
    relationship: true,
    crossingSeparators: [{ x: position.noobJoin, y: lane.red }],
  },
  {
    ids: ['zaparit', 'battleforce'],
    d: `M ${position.zaparitEnd} ${lane.zaparit} H ${position.zaparitJoin} V ${lane.main}`,
    color: color.zaparit,
    participant: true,
  },
  {
    ids: ['zaparit'],
    d: `M ${position.zaparitStart} ${lane.zaparit} H ${position.zaparitEnd}`,
    color: color.zaparit,
    observation: true,
  },
  {
    ids: ['vcielka'],
    d: `M ${position.vcielka} ${lane.vcielka} H ${position.vcielkaEnd}`,
    color: color.vcielka,
  },
  {
    ids: ['vcielka', 'zonax'],
    d: `M ${position.vcielkaJoin} ${lane.vcielka} V ${lane.main}`,
    color: color.vcielka,
    participant: true,
    crossingSeparators: [{ x: position.vcielkaJoin, y: lane.games }],
  },
  {
    ids: ['old-vega'],
    d: `M ${position.oldVegaStart} ${lane.oldVega} H ${position.oldVegaEnd}`,
    color: color.oldVega,
  },
  {
    ids: ['old-vega', 'black-birds'],
    d: `M ${position.oldVegaEnd} ${lane.oldVega} H ${position.oldVegaJoin} V ${lane.birds} H ${position.birdsStart}`,
    color: color.oldVega,
    participant: true,
    crossingSeparators: [lane.red, lane.noob, lane.zaparit].map((y) => ({
      x: position.oldVegaJoin,
      y,
    })),
  },
  {
    ids: ['gamers-germany'],
    d: `M ${position.germanyStart} ${lane.germany} H ${position.germanyEnd}`,
    color: color.germany,
  },
  {
    ids: ['gamers-germany', 'agteam'],
    d: `M ${position.germanyJoin} ${lane.germany} V ${lane.main}`,
    color: color.germany,
    relationship: true,
  },
  {
    ids: ['tweakgaming'],
    d: `M ${position.tweakStart} ${lane.tweak} H ${position.tweakEnd}`,
    color: color.tweak,
  },
  {
    ids: ['tweakgaming', 'agteam'],
    d: `M ${position.tweakProvision} ${lane.tweak} V ${lane.main}`,
    color: color.tweak,
    movement: true,
    crossingSeparators: [
      lane.germany,
      lane.red,
      lane.noob,
      lane.zaparit,
      lane.oldVega,
    ].map((y) => ({ x: position.tweakProvision, y })),
  },
  {
    ids: ['games-community', 'aggressive-zone'],
    d: `M ${position.gamesJoin} ${lane.games} V ${lane.main}`,
    color: color.games,
  },
  {
    ids: ['games-community'],
    d: `M ${position.gamesStart} ${lane.games} H ${position.gamesJoin}`,
    color: color.games,
  },
  {
    ids: ['games-community', 'avalon'],
    d: `M ${position.gamesJoin} ${lane.games} H ${position.avalonStart}`,
    color: color.gamesMuted,
    muted: true,
  },
  {
    ids: ['games-community', 'avalon'],
    d: `M ${position.avalonStart} ${lane.games} H ${position.end}`,
    color: color.games,
    faded: true,
  },
].filter(({ ids }) => ids.every((id) => names.has(id)));

const junctions = [
  { x: position.germanyJoin, y: lane.main, color: color.germany },
  { x: position.gamesJoin, y: lane.main, color: color.games },
  { x: position.zonaxJoin, y: lane.main, color: color.zonax },
  { x: position.battleMerge, y: lane.main, color: color.battle },
  { x: position.birdsMerge, y: lane.birds, color: color.red },
  { x: position.jzdMerge, y: lane.jzd, color: color.red },
  { x: position.noobDeparture, y: lane.noob, color: color.noob },
  { x: position.vcielkaJoin, y: lane.main, color: color.vcielka },
];
const closures = [
  {
    id: 'gamers-germany',
    x: position.germanyEnd,
    y: lane.germany,
    color: color.germany,
  },
  {
    id: 'tweakgaming',
    x: position.tweakEnd,
    y: lane.tweak,
    color: color.tweak,
  },
  {
    id: 'zaparit',
    x: position.zaparitEnd,
    y: lane.zaparit,
    color: color.zaparit,
  },
  {
    id: 'noobstyle',
    x: position.noobEnd,
    y: lane.noob,
    color: color.noob,
  },
  {
    id: 'old-vega',
    x: position.oldVegaEnd,
    y: lane.oldVega,
    color: color.oldVega,
  },
  {
    id: 'vcielka',
    x: position.vcielkaEnd,
    y: lane.vcielka,
    color: color.vcielka,
  },
].filter(({ id }) => names.has(id));
---

<figure class="history-network">
  <div
    class="graph-scroll"
    tabindex="0"
    role="region"
    aria-label="Horizontal server history; scroll to explore"
  >
    <svg
      viewBox={`0 0 ${graphWidth} ${graphHeight}`}
      style={`min-width: ${Math.min(graphWidth, 1900)}px`}
      role="img"
      aria-labelledby="history-network-title history-network-desc"
    >
      <title id="history-network-title">CS:S server network</title>
      <desc id="history-network-desc">
        Approximate CS:S community history on an equally spaced yearly timeline.
        Aggressive Ghost Team, ZonaX, Aggressive Zone, BattleForce and Rivals
        lead through reopened Red-Skillers and JZD to LaMaTeAm, with an off-main
        interval. Solid spans show community activity or archive observations,
        not verified lifespans. Dashed links show Old VEGA's player move, Gamers
        of Germany's independent partnership, Tweakgaming's server provision and
        the Rivals-to-Red-Skillers move; dotted links show other participant
        moves. Crossing gaps are not junctions. T-shaped caps mark lane
        endpoints, including owner-recalled closures around 2012 for Tweakgaming
        and 2018 for Gamers of Germany. Games Community is pink through its
        Aggressive Zone junction, then muted gray until Avalon starts in 2018
        and continues in faded pink. LaMaTeAm's dashed tail and Avalon's faded
        line end at the editorial 2027.5 display boundary, not a predicted
        closure. Handoff positions follow oral history and are illustrative
        where exact dates are unknown.
      </desc>
      <g class="calendar">
        {Array.from({ length: horizon - 2006 + 1 }, (_, i) => 2006 + i).map(
          (year) => (
            <g>
              <path
                d={`M ${x(year)} 48 V ${graphHeight - 20}`}
                class="year-grid"
              />
            </g>
          ),
        )}
      </g>
      <path
        d={`M ${position.agt} 280 H ${position.end}`}
        class="timeline-rail"
      />
      {paths.map((path) => (
        <g>
          {path.crossingSeparators && (
            <g aria-hidden="true" class="crossing-separators">
              {path.crossingSeparators.map(({ x, y }) => (
                <path d={`M ${x} ${y - 9} V ${y + 9}`} />
              ))}
            </g>
          )}
          <path
            d={path.d}
            stroke={path.color}
            class:list={[
              'thread',
              {
                movement: path.movement,
                relationship: path.relationship,
                continuation: path.continuation,
                participant: path.participant,
                faded: path.faded,
                muted: path.muted,
              },
            ]}
          />
        </g>
      ))}
      {junctions.map((point) => (
        <circle
          cx={point.x}
          cy={point.y}
          r="6"
          class="junction"
          stroke={point.color}
        />
      ))}
      {closures.map((point) => (
        <g class="closure" style={`--lane-color: ${point.color}`}>
          <path d={`M ${point.x} ${point.y - 8} V ${point.y + 8}`} />
        </g>
      ))}
      <g class="calendar-labels" aria-hidden="true">
        {Array.from({ length: horizon - 2006 + 1 }, (_, i) => 2006 + i).map(
          (year) => (
            <g>
              <path d={`M ${x(year)} 297 V 302`} class="year-tick" />
              <text x={x(year)} y="292" text-anchor="middle" class="year-label">
                {year}
              </text>
            </g>
          ),
        )}
      </g>
      {markers.map((node) => (
        <g class="milestone" style={`--lane-color: ${node.color}`}>
          <circle cx={node.x} cy={node.y} r="6" />
          <text
            x={node.labelX ?? node.x}
            y={node.labelY}
            text-anchor={node.anchor ?? 'start'}
            class="server-name"
          >
            {displayNames[node.id] ?? names.get(node.id)}
          </text>
        </g>
      ))}
      <g class="legend" transform={`translate(${graphWidth - 820}, 655)`}>
        <rect width="770" height="225" rx="12" />
        <text x="24" y="32" class="legend-title">
          Legend:
        </text>
        <path d="M 24 64 H 82" class="legend-main" />
        <text x="102" y="61">
          <tspan x="102">Evolution of communities running previous</tspan>
          <tspan x="102" dy="20">
            versions of our current server setup
          </tspan>
        </text>
        <path d="M 24 110 H 82" class="thread" />
        <text x="102" y="115">
          Communities joining directly
        </text>
        <path d="M 24 151 H 82" class="thread movement" />
        <text x="102" y="146">
          <tspan x="102">Server provision or partnerships</tspan>
        </text>
        <path d="M 24 195 H 82" class="thread participant" />
        <text x="102" y="200">
          Friendly communities joining after closure
        </text>
      </g>
    </svg>
  </div>
</figure>

<style>
  .history-network {
    --graph-background: #0b0c10;
    margin: 0;
    min-width: 0;
    max-width: 100%;
    color: #e4e8f0;
    font-family: inherit;
  }
  .graph-scroll {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-color: #4b4762 var(--graph-background);
    scrollbar-width: thin;
  }
  .graph-scroll:focus-visible {
    outline: 2px solid #b8a0ff;
    outline-offset: 4px;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 1560px;
    height: auto;
  }
  .year-grid {
    stroke: #ffffff;
    stroke-opacity: 0.06;
    stroke-width: 1;
  }
  .year-label {
    fill: #e0deee;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .timeline-rail {
    fill: none;
    stroke: #292737;
    stroke-width: 44;
    stroke-linecap: round;
  }
  .year-tick {
    stroke: #aaa5bd;
    stroke-width: 1;
  }
  .thread {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .crossing-separators path {
    fill: none;
    stroke: var(--graph-background);
    stroke-width: 12;
    pointer-events: none;
  }
  .movement,
  .relationship,
  .continuation {
    stroke-dasharray: 7 7;
  }
  .participant {
    stroke-dasharray: 1 8;
  }
  .faded {
    opacity: 0.55;
  }
  .muted {
    opacity: 0.4;
  }
  .legend rect {
    fill: var(--graph-background);
    stroke: #393647;
  }
  .legend text {
    fill: #c9ced9;
    font-size: 15px;
  }
  .legend .legend-title {
    fill: #e4e8f0;
    font-size: 17px;
    font-weight: 650;
  }
  .legend path {
    stroke: #b8a0ff;
  }
  .legend-main {
    stroke-width: 10;
    stroke-linecap: round;
  }
  .milestone circle,
  .junction {
    fill: var(--graph-background);
    stroke-width: 3;
  }
  .milestone circle {
    stroke: var(--lane-color);
  }
  .server-name {
    fill: var(--lane-color);
    font-size: 16px;
    font-weight: 650;
  }
  .closure path {
    stroke: var(--lane-color);
    stroke-width: 3;
  }
</style>
