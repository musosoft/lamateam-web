---
interface Props {
  nodes: Array<{
    id: string;
    name: string;
    kind: 'community' | 'server' | 'person' | 'project' | 'provider';
    summary: string;
    period: string;
  }>;
  links: Array<{
    from: string;
    to: string;
    kind: string;
    account: string;
    period: string;
  }>;
}

const { nodes } = Astro.props;
const names = new Map(nodes.map(({ id, name }) => [id, name]));
const x = (year: number) => 90 + (year - 2006) * 110;

// Approximate editorial positions, not researched launch/closure timestamps.
// Archive captures establish observations only. In particular, the AGZ website
// trail below must not be interpreted as continuous server operation.
// The topology follows the owner's latest correction, not the older links prop.
const position = {
  agt: x(2006),
  zonax: x(2011.8),
  zoneMerge: x(2013.5),
  zoneWebEnd: x(2016.8),
  battleStart: x(2013.25),
  battleMerge: x(2014.7),
  redStart: x(2011),
  birdsStart: x(2013),
  birdsMerge: x(2014.5),
  rivalsMerge: x(2015.55),
  noobStart: x(2012.2),
  noobEnd: x(2016),
  noobJoin: x(2016.7),
  redReopens: x(2015.8),
  jzdStart: x(2014),
  jzdMerge: x(2017),
  lamaMerge: x(2018),
  end: x(2020),
};
const lane = {
  main: 220,
  zonax: 92,
  battle: 145,
  birds: 350,
  red: 395,
  jzd: 440,
  reopened: 495,
  noob: 550,
  zaparit: 620,
};
const color = {
  main: '#b8a0ff',
  zonax: '#68d5c0',
  battle: '#99a9fa',
  red: '#edac79',
  birds: '#f18faa',
  jzd: '#74d69d',
  noob: '#8cb7f8',
  zaparit: '#d4c27d',
};

type Marker = {
  id: string;
  x: number;
  y: number;
  labelY: number;
  color: string;
  labelX?: number;
  anchor?: 'start' | 'end';
};
const markers: Marker[] = [
  {
    id: 'agteam',
    x: position.agt,
    y: lane.main,
    labelY: 192,
    color: color.main,
  },
  {
    id: 'zonax',
    x: position.zonax,
    y: lane.zonax,
    labelY: 67,
    color: color.zonax,
  },
  {
    id: 'aggressive-zone',
    x: position.zoneMerge,
    y: lane.main,
    labelY: 185,
    color: color.main,
    labelX: position.zoneMerge - 18,
    anchor: 'end' as const,
  },
  {
    id: 'battleforce',
    x: position.battleStart,
    y: lane.battle,
    labelY: 121,
    labelX: position.battleStart - 16,
    anchor: 'end' as const,
    color: color.battle,
  },
  {
    id: 'rivals',
    x: position.rivalsMerge,
    y: lane.main,
    labelY: 192,
    color: color.main,
  },
  {
    id: 'red-skillers',
    x: position.redStart,
    y: lane.red,
    labelY: 375,
    color: color.red,
  },
  {
    id: 'black-birds',
    x: position.birdsStart,
    y: lane.birds,
    labelY: 325,
    color: color.birds,
  },
  {
    id: 'red-skillers',
    x: position.redReopens,
    y: lane.reopened,
    labelY: 520,
    color: color.red,
  },
  {
    id: 'jzd',
    x: position.jzdStart,
    y: lane.jzd,
    labelY: 472,
    color: color.jzd,
  },
  {
    id: 'lamateam',
    x: position.lamaMerge,
    y: lane.main,
    labelY: 192,
    color: color.jzd,
  },
  {
    id: 'noobstyle',
    x: position.noobStart,
    y: lane.noob,
    labelY: 530,
    color: color.noob,
  },
  { id: 'zaparit', x: 470, y: lane.zaparit, labelY: 598, color: color.zaparit },
].filter(({ id }) => names.has(id));

const paths = [
  {
    ids: ['agteam', 'aggressive-zone'],
    d: `M ${position.agt} ${lane.main} H ${position.zoneMerge}`,
    color: color.main,
  },
  {
    ids: ['zonax', 'aggressive-zone'],
    d: `M ${position.zonax} ${lane.zonax} H ${position.zoneMerge} V ${lane.main}`,
    color: color.zonax,
  },
  {
    ids: ['aggressive-zone', 'battleforce'],
    d: `M ${position.zoneMerge} ${lane.main} H ${position.battleMerge}`,
    color: color.main,
  },
  {
    ids: ['battleforce'],
    d: `M ${position.battleStart} ${lane.battle} H ${position.battleMerge} V ${lane.main}`,
    color: color.battle,
  },
  {
    ids: ['battleforce', 'rivals'],
    d: `M ${position.battleMerge} ${lane.main} H ${position.rivalsMerge}`,
    color: color.main,
  },
  {
    ids: ['rivals', 'lamateam'],
    d: `M ${position.rivalsMerge} ${lane.main} H ${position.lamaMerge}`,
    color: color.main,
  },
  {
    ids: ['lamateam'],
    d: `M ${position.lamaMerge} ${lane.main} H ${position.end}`,
    color: color.jzd,
  },
  {
    ids: ['red-skillers', 'black-birds'],
    d: `M ${position.redStart} ${lane.red} H ${position.birdsMerge} V ${lane.birds}`,
    color: color.red,
  },
  {
    ids: ['black-birds', 'rivals'],
    d: `M ${position.birdsStart} ${lane.birds} H ${position.rivalsMerge} V ${lane.main}`,
    color: color.birds,
  },
  {
    ids: ['red-skillers', 'jzd'],
    d: `M ${position.redReopens} ${lane.reopened} H ${position.jzdMerge} V ${lane.jzd}`,
    color: color.red,
  },
  {
    ids: ['jzd', 'lamateam'],
    d: `M ${position.jzdStart} ${lane.jzd} H ${position.lamaMerge} V ${lane.main}`,
    color: color.jzd,
  },
  {
    ids: ['noobstyle'],
    d: `M ${position.noobStart} ${lane.noob} H ${position.noobEnd}`,
    color: color.noob,
  },
  {
    ids: ['noobstyle', 'rivals'],
    d: `M ${position.noobEnd} ${lane.noob} H ${position.noobJoin} V ${lane.main}`,
    color: color.noob,
    movement: true,
  },
  {
    ids: ['zaparit', 'battleforce'],
    d: `M 470 ${lane.zaparit} H ${position.battleMerge - 38} V 305 H ${position.battleMerge} V ${lane.main}`,
    color: color.zaparit,
    movement: true,
  },
].filter(({ ids }) => ids.every((id) => names.has(id)));

const junctions = [
  { x: position.battleMerge, y: lane.main, color: color.battle },
  { x: position.birdsMerge, y: lane.birds, color: color.red },
  { x: position.jzdMerge, y: lane.jzd, color: color.red },
  { x: position.noobEnd, y: lane.noob, color: color.noob },
];
---

<figure class="history-network">
  <p class="scroll-cue">
    <span aria-hidden="true">↔</span> Swipe / scroll sideways to explore the
    full network
  </p>
  <div
    class="graph-scroll"
    tabindex="0"
    role="region"
    aria-label="Horizontal server history; scroll to explore"
  >
    <svg
      viewBox="0 0 1790 660"
      role="img"
      aria-labelledby="history-network-title history-network-desc"
    >
      <title id="history-network-title">CS:S server network</title>
      <desc id="history-network-desc">
        Aggressive Ghost Team and ZonaX converge at the start of Aggressive
        Zone. The earlier parallel Battleforce line joins the main lane,
        followed by Rivals and LaMaTeAm. Red Skillers joins Black Birds, which
        joins Rivals. Red Skillers later reopens and joins JZD; JZD joins the
        main lane at LaMaTeAm. noobstyle.sk and Zaparit.cz have separate lanes
        with player-movement connections. All spans and handoff positions are
        approximate. The faint dashed Aggressive Zone branch represents later
        archived website presence, not a proven server lifespan. Battleforce's
        early portal and noobstyle's archive captures are observations, not
        founding dates. JZD's approximate era follows the owner's oral account.
      </desc>
      <g class="calendar">
        {Array.from({ length: 15 }, (_, i) => 2006 + i).map((year) => (
          <g>
            <path d={`M ${x(year)} 48 V 635`} class="year-grid" />
            <text x={x(year)} y="28" text-anchor="middle" class="year-label">
              {year}
            </text>
          </g>
        ))}
      </g>
      {names.has('aggressive-zone') && (
        <path
          d={`M ${position.zoneMerge} ${lane.main} V 280 H ${position.zoneWebEnd}`}
          stroke={color.main}
          class="website-trail"
        >
          <title>Aggressive Zone · archived website presence; not evidence of continued server operation</title>
        </path>
      )}
      {paths.map((path) => (
        <path
          d={path.d}
          stroke={path.color}
          class:list={['thread', { movement: path.movement }]}
        />
      ))}
      {junctions.map((point) => (
        <circle
          cx={point.x}
          cy={point.y}
          r="6"
          class="junction"
          stroke={point.color}
        />
      ))}
      {markers.map((node) => (
        <g class="milestone" style={`--lane-color: ${node.color}`}>
          <circle cx={node.x} cy={node.y} r="6" />
          <text
            x={node.labelX ?? node.x}
            y={node.labelY}
            text-anchor={node.anchor ?? 'start'}
            class="server-name"
          >
            {node.id === 'rivals' ? 'Rivals' : names.get(node.id)}
          </text>
        </g>
      ))}
    </svg>
  </div>
</figure>

<style>
  .history-network {
    --graph-background: #0b0c10;
    margin: 0;
    color: #e4e8f0;
    font-family: inherit;
  }
  .graph-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-color: #4b4762 var(--graph-background);
    scrollbar-width: thin;
  }
  .graph-scroll:focus-visible {
    outline: 2px solid #b8a0ff;
    outline-offset: 4px;
  }
  .scroll-cue {
    display: none;
    margin: 0 0 16px;
    color: #c5cad4;
    font-size: 12px;
    line-height: 1.5;
  }
  .scroll-cue span {
    color: #b8a0ff;
    margin-right: 6px;
  }
  @media (width < 1608px) {
    .scroll-cue {
      display: block;
    }
  }
  svg {
    display: block;
    width: 100%;
    min-width: 1560px;
    height: auto;
  }
  .year-grid {
    stroke: #ffffff;
    stroke-opacity: 0.06;
    stroke-width: 1;
  }
  .year-label {
    fill: #aab1c0;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .website-trail {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 3 7;
    opacity: 0.45;
  }
  .thread {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .movement {
    stroke-dasharray: 7 7;
  }
  .milestone circle,
  .junction {
    fill: var(--graph-background);
    stroke-width: 3;
  }
  .milestone circle {
    stroke: var(--lane-color);
  }
  .server-name {
    fill: var(--lane-color);
    font-size: 16px;
    font-weight: 650;
  }
</style>
