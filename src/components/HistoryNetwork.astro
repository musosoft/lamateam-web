---
interface Props {
  nodes: Array<{
    id: string;
    name: string;
    kind: 'community' | 'server' | 'person' | 'project' | 'provider';
    summary: string;
    period: string;
  }>;
  links: Array<{
    from: string;
    to: string;
    kind: string;
    account: string;
    period: string;
  }>;
}

const { nodes } = Astro.props;
const names = new Map(nodes.map(({ id, name }) => [id, name]));
const displayNames: Record<string, string> = {
  rivals: 'Rivals',
  zaparit: '[CZ] www.Zaparit.cz',
  tweakgaming: 'NL Tweakgaming',
};
// Preserve room for the dense early history, with a compact later-year scale.
const x = (year: number) =>
  90 + (Math.min(year, 2020) - 2006) * 110 + Math.max(0, year - 2020) * 50;
const currentYear = new Date().getUTCFullYear();
const horizon = Math.max(2030, Math.ceil((currentYear + 1) / 5) * 5);
const graphWidth = x(horizon) + 100;
const graphHeight = 930;

// Approximate editorial positions, not researched launch/closure timestamps.
// Archive captures establish observations only. In particular, the AGZ website
// trail below must not be interpreted as continuous server operation.
// The topology follows the owner's latest correction, not the older links prop.
const position = {
  agt: x(2006),
  zonax: x(2009),
  vcielka: x(2010),
  vcielkaEnd: x(2015),
  vcielkaJoin: x(2016.35),
  zoneMerge: x(2013.5),
  zoneWebEnd: x(2016.8),
  battleStart: x(2013.25),
  battleMerge: x(2014.7),
  redStart: x(2011),
  birdsStart: x(2013),
  birdsMerge: x(2014.5),
  rivalsMerge: x(2015.55),
  noobStart: x(2011),
  noobEnd: x(2016),
  noobJoin: x(2016.7),
  mainPause: x(2018),
  redReopens: x(2018),
  jzdStart: x(2021),
  jzdMerge: x(2021),
  lamaMerge: x(2024),
  zaparitStart: x(2007),
  zaparitEnd: x(2015),
  zaparitJoin: x(2015.15),
  vegaStart: x(2010),
  vegaEnd: x(2014.3),
  vegaJoin: x(2014.55),
  tweakStart: x(2008),
  tweakEnd: x(2012),
  end: x(Math.max(currentYear + 1, 2027)),
};
const lane = {
  main: 280,
  vcielka: 70,
  zonax: 145,
  battle: 200,
  birds: 410,
  red: 465,
  jzd: 540,
  noob: 630,
  zaparit: 720,
  vega: 800,
  tweak: 885,
};
const color = {
  main: '#b8a0ff',
  zonax: '#68d5c0',
  battle: '#99a9fa',
  red: '#edac79',
  birds: '#f18faa',
  jzd: '#74d69d',
  noob: '#8cb7f8',
  zaparit: '#d4c27d',
  vcielka: '#7dd5e8',
  vega: '#c9a0da',
  tweak: '#a7c784',
};

type Marker = {
  id: string;
  x: number;
  y: number;
  labelY: number;
  color: string;
  labelX?: number;
  anchor?: 'start' | 'end';
};
const markers: Marker[] = [
  {
    id: 'agteam',
    x: position.agt,
    y: lane.main,
    labelY: lane.main - 28,
    color: color.main,
  },
  {
    id: 'zonax',
    x: position.zonax,
    y: lane.zonax,
    labelY: lane.zonax - 24,
    color: color.zonax,
  },
  {
    id: 'aggressive-zone',
    x: position.zoneMerge,
    y: lane.main,
    labelY: lane.main - 35,
    color: color.main,
    labelX: position.zoneMerge - 18,
    anchor: 'end' as const,
  },
  {
    id: 'battleforce',
    x: position.battleStart,
    y: lane.battle,
    labelY: lane.battle - 24,
    labelX: position.battleStart - 16,
    anchor: 'end' as const,
    color: color.battle,
  },
  {
    id: 'rivals',
    x: position.rivalsMerge,
    y: lane.main,
    labelY: lane.main - 28,
    color: color.main,
  },
  {
    id: 'red-skillers',
    x: position.redStart,
    y: lane.red,
    labelY: lane.red - 24,
    color: color.red,
  },
  {
    id: 'black-birds',
    x: position.birdsStart,
    y: lane.birds,
    labelY: lane.birds - 24,
    color: color.birds,
  },
  {
    id: 'red-skillers',
    x: position.redReopens,
    y: lane.red,
    labelY: lane.red - 24,
    labelX: position.redReopens + 16,
    color: color.red,
  },
  {
    id: 'jzd',
    x: position.jzdStart,
    y: lane.jzd,
    labelY: lane.jzd + 32,
    color: color.jzd,
  },
  {
    id: 'lamateam',
    x: position.lamaMerge,
    y: lane.main,
    labelY: lane.main - 28,
    color: color.jzd,
  },
  {
    id: 'noobstyle',
    x: position.noobStart,
    y: lane.noob,
    labelY: lane.noob - 24,
    color: color.noob,
  },
  {
    id: 'zaparit',
    x: position.zaparitStart,
    y: lane.zaparit,
    labelY: lane.zaparit - 24,
    color: color.zaparit,
  },
  {
    id: 'vcielka',
    x: position.vcielka,
    y: lane.vcielka,
    labelY: lane.vcielka - 20,
    color: color.vcielka,
  },
  {
    id: 'vega',
    x: position.vegaStart,
    y: lane.vega,
    labelY: lane.vega - 24,
    color: color.vega,
  },
  {
    id: 'tweakgaming',
    x: position.tweakStart,
    y: lane.tweak,
    labelY: lane.tweak - 24,
    color: color.tweak,
  },
].filter(({ id }) => names.has(id));

const paths = [
  {
    ids: ['agteam', 'aggressive-zone'],
    d: `M ${position.agt} ${lane.main} H ${position.zoneMerge}`,
    color: color.main,
  },
  {
    ids: ['zonax', 'aggressive-zone'],
    d: `M ${position.zonax} ${lane.zonax} H ${position.zoneMerge} V ${lane.main}`,
    color: color.zonax,
  },
  {
    ids: ['aggressive-zone', 'battleforce'],
    d: `M ${position.zoneMerge} ${lane.main} H ${position.battleMerge}`,
    color: color.main,
  },
  {
    ids: ['battleforce'],
    d: `M ${position.battleStart} ${lane.battle} H ${position.battleMerge} V ${lane.main}`,
    color: color.battle,
  },
  {
    ids: ['battleforce', 'rivals'],
    d: `M ${position.battleMerge} ${lane.main} H ${position.rivalsMerge}`,
    color: color.main,
  },
  {
    ids: ['rivals', 'red-skillers'],
    d: `M ${position.rivalsMerge} ${lane.main} H ${position.mainPause} V ${lane.red}`,
    color: color.main,
  },
  {
    ids: ['lamateam'],
    d: `M ${position.lamaMerge} ${lane.main} H ${position.end}`,
    color: color.jzd,
  },
  {
    ids: ['red-skillers', 'black-birds'],
    d: `M ${position.redStart} ${lane.red} H ${position.birdsMerge} V ${lane.birds}`,
    color: color.red,
  },
  {
    ids: ['black-birds', 'rivals'],
    d: `M ${position.birdsStart} ${lane.birds} H ${position.rivalsMerge} V ${lane.main}`,
    color: color.birds,
  },
  {
    ids: ['red-skillers', 'jzd'],
    d: `M ${position.redReopens} ${lane.red} H ${position.jzdMerge} V ${lane.jzd}`,
    color: color.red,
  },
  {
    ids: ['jzd', 'lamateam'],
    d: `M ${position.jzdStart} ${lane.jzd} H ${position.lamaMerge} V ${lane.main}`,
    color: color.jzd,
  },
  {
    ids: ['noobstyle'],
    d: `M ${position.noobStart} ${lane.noob} H ${position.noobEnd}`,
    color: color.noob,
  },
  {
    ids: ['noobstyle', 'rivals'],
    d: `M ${position.noobEnd} ${lane.noob} H ${position.noobJoin} V ${lane.main}`,
    color: color.noob,
    movement: true,
  },
  {
    ids: ['zaparit', 'battleforce'],
    d: `M ${position.zaparitEnd} ${lane.zaparit} H ${position.zaparitJoin} V ${lane.main}`,
    color: color.zaparit,
    movement: true,
  },
  {
    ids: ['zaparit'],
    d: `M ${position.zaparitStart} ${lane.zaparit} H ${position.zaparitEnd}`,
    color: color.zaparit,
    observation: true,
    annotation:
      '[CZ] www.Zaparit.cz · approximate archive-observation range, not founding or closure dates',
  },
  {
    ids: ['vcielka'],
    d: `M ${position.vcielka} ${lane.vcielka} H ${position.vcielkaEnd}`,
    color: color.vcielka,
  },
  {
    ids: ['zonax', 'vcielka'],
    d: `M ${position.zoneMerge} ${lane.zonax} V ${lane.vcielka}`,
    color: color.zonax,
  },
  {
    ids: ['vcielka', 'rivals'],
    d: `M ${position.vcielkaEnd} ${lane.vcielka} H ${position.vcielkaJoin} V ${lane.main}`,
    color: color.vcielka,
    movement: true,
  },
  {
    ids: ['vega'],
    d: `M ${position.vegaStart} ${lane.vega} H ${position.vegaEnd}`,
    color: color.vega,
  },
  {
    ids: ['vega', 'aggressive-zone'],
    d: `M ${position.vegaEnd} ${lane.vega} H ${position.vegaJoin} V ${lane.main}`,
    color: color.vega,
    movement: true,
  },
  {
    ids: ['tweakgaming'],
    d: `M ${position.tweakStart} ${lane.tweak} H ${position.tweakEnd}`,
    color: color.tweak,
    observation: true,
    annotation:
      'NL Tweakgaming · approximate server-listing observation range, not a full server lifespan',
  },
].filter(({ ids }) => ids.every((id) => names.has(id)));

const junctions = [
  { x: position.battleMerge, y: lane.main, color: color.battle },
  { x: position.birdsMerge, y: lane.birds, color: color.red },
  { x: position.jzdMerge, y: lane.jzd, color: color.red },
  { x: position.noobEnd, y: lane.noob, color: color.noob },
  { x: position.zoneMerge, y: lane.vcielka, color: color.zonax },
  { x: position.vcielkaEnd, y: lane.vcielka, color: color.vcielka },
  { x: position.zaparitEnd, y: lane.zaparit, color: color.zaparit },
  { x: position.vegaEnd, y: lane.vega, color: color.vega },
  { x: position.tweakEnd, y: lane.tweak, color: color.tweak },
];
---

<figure class="history-network">
  <p class="scroll-cue">
    <span aria-hidden="true">↔</span> Swipe / scroll sideways to explore the
    full network
  </p>
  <div
    class="graph-scroll"
    tabindex="0"
    role="region"
    aria-label="Horizontal server history; scroll to explore"
  >
    <svg
      viewBox={`0 0 ${graphWidth} ${graphHeight}`}
      style={`min-width: ${Math.min(graphWidth, 1900)}px`}
      role="img"
      aria-labelledby="history-network-title history-network-desc"
    >
      <title id="history-network-title">CS:S server network</title>
      <desc id="history-network-desc">
        Aggressive Ghost Team and ZonaX converge at the start of Aggressive
        Zone. The earlier parallel Battleforce line joins the main lane,
        followed by Rivals. The main lane pauses as players move to the reopened
        Red Skillers lane, then through JZD, before resuming at LaMaTeAm. The
        main lane has no activity line across that off-main interval. The
        earlier Red Skillers segment joins Black Birds, which joins Rivals.
        noobstyle.sk and [CZ] www.Zaparit.cz have separate lanes with
        player-movement connections. All spans and handoff positions are
        approximate. The faint dashed Aggressive Zone branch represents later
        archived website presence, not a proven server lifespan. Battleforce's
        early portal and noobstyle's archive captures are observations, not
        founding dates. The off-main sequence follows the owner's approximate
        recollection. The Zaparit and NL Tweakgaming stippled spans represent
        archive observations only, not full lifespans or founding/closure dates.
        Vcielka coexists with ZonaX, receives its community continuation when
        ZonaX merges into Aggressive Zone, then closes and its members join
        Rivals. Red Skillers has two separate active spans on the same lane,
        with a gap between its first merger and reopening. Vega remains separate
        before its members join the Aggressive Zone thread. NL Tweakgaming is an
        independent server with a code-source relationship, not a community
        merger.
      </desc>
      <g class="calendar">
        {Array.from({ length: horizon - 2006 + 1 }, (_, i) => 2006 + i).map(
          (year) => (
            <g>
              <path
                d={`M ${x(year)} 48 V ${graphHeight - 20}`}
                class="year-grid"
              />
              <text x={x(year)} y="28" text-anchor="middle" class="year-label">
                {year}
              </text>
            </g>
          ),
        )}
      </g>
      {names.has('aggressive-zone') && (
        <path
          d={`M ${position.zoneMerge} ${lane.main} V 340 H ${position.zoneWebEnd} V ${lane.main}`}
          stroke={color.main}
          class="website-trail"
        >
          <title>Aggressive Zone · archived website presence; not evidence of continued server operation</title>
        </path>
      )}
      {paths.map((path) => (
        <path
          d={path.d}
          stroke={path.color}
          class:list={[
            'thread',
            { movement: path.movement, observation: path.observation },
          ]}
        >
          {path.annotation && <title>{path.annotation}</title>}
        </path>
      ))}
      {junctions.map((point) => (
        <circle
          cx={point.x}
          cy={point.y}
          r="6"
          class="junction"
          stroke={point.color}
        />
      ))}
      {markers.map((node) => (
        <g class="milestone" style={`--lane-color: ${node.color}`}>
          <circle cx={node.x} cy={node.y} r="6" />
          <text
            x={node.labelX ?? node.x}
            y={node.labelY}
            text-anchor={node.anchor ?? 'start'}
            class="server-name"
          >
            {displayNames[node.id] ?? names.get(node.id)}
          </text>
        </g>
      ))}
    </svg>
  </div>
</figure>

<style>
  .history-network {
    --graph-background: #0b0c10;
    margin: 0;
    color: #e4e8f0;
    font-family: inherit;
  }
  .graph-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-color: #4b4762 var(--graph-background);
    scrollbar-width: thin;
  }
  .graph-scroll:focus-visible {
    outline: 2px solid #b8a0ff;
    outline-offset: 4px;
  }
  .scroll-cue {
    display: none;
    margin: 0 0 16px;
    color: #c5cad4;
    font-size: 12px;
    line-height: 1.5;
  }
  .scroll-cue span {
    color: #b8a0ff;
    margin-right: 6px;
  }
  @media (width < 2400px) {
    .scroll-cue {
      display: block;
    }
  }
  svg {
    display: block;
    width: 100%;
    min-width: 1560px;
    height: auto;
  }
  .year-grid {
    stroke: #ffffff;
    stroke-opacity: 0.06;
    stroke-width: 1;
  }
  .year-label {
    fill: #aab1c0;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .website-trail {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 3 7;
    opacity: 0.45;
  }
  .thread {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .movement {
    stroke-dasharray: 7 7;
  }
  .observation {
    stroke-width: 2;
    stroke-dasharray: 2 5;
  }
  .milestone circle,
  .junction {
    fill: var(--graph-background);
    stroke-width: 3;
  }
  .milestone circle {
    stroke: var(--lane-color);
  }
  .server-name {
    fill: var(--lane-color);
    font-size: 16px;
    font-weight: 650;
  }
</style>
