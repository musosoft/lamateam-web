---
const { locale } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 30 20"
  width="30"
  height="20"
  aria-hidden="true"
  focusable="false"
>
  {locale === 'en' ? (
    <>
      <rect width="30" height="20" fill="#012169" />
      <path d="M0 0 30 20M30 0 0 20" stroke="#fff" stroke-width="5" />
      <path d="M0 0 30 20M30 0 0 20" stroke="#c8102e" stroke-width="2" />
      <path d="M15 0v20M0 10h30" stroke="#fff" stroke-width="8" />
      <path d="M15 0v20M0 10h30" stroke="#c8102e" stroke-width="4" />
    </>
  ) : locale === 'fr' ? (
    <>
      <rect width="10" height="20" fill="#002395" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#ed2939" />
    </>
  ) : locale === 'cs' ? (
    <>
      <rect width="30" height="10" fill="#fff" />
      <rect y="10" width="30" height="10" fill="#d7141a" />
      <path d="M0 0 15 10 0 20Z" fill="#11457e" />
    </>
  ) : locale === 'sk' ? (
    <>
      <rect width="30" height="7" fill="#fff" />
      <rect y="7" width="30" height="6" fill="#0b4ea2" />
      <rect y="13" width="30" height="7" fill="#ee1c25" />
      <path
        d="M7 5h8v7q-4 5-8 0Z"
        fill="#ee1c25"
        stroke="#fff"
        stroke-width="0.8"
      />
      <path d="M11 6v7M8.5 8h5M8 10h6" stroke="#fff" stroke-width="1" />
      <path d="M7.5 12q1-2 2-1q1-3 2.5-1q1-1 2.5 2q-3 4-7 0Z" fill="#0b4ea2" />
    </>
  ) : locale === 'pl' ? (
    <>
      <rect width="30" height="10" fill="#fff" />
      <rect y="10" width="30" height="10" fill="#dc143c" />
    </>
  ) : locale === 'uk' ? (
    <>
      <rect width="30" height="10" fill="#0057b7" />
      <rect y="10" width="30" height="10" fill="#ffd700" />
    </>
  ) : locale === 'hu' ? (
    <>
      <rect width="30" height="7" fill="#ce2939" />
      <rect y="7" width="30" height="6" fill="#fff" />
      <rect y="13" width="30" height="7" fill="#477050" />
    </>
  ) : (
    <>
      <rect width="30" height="7" fill="#111" />
      <rect y="7" width="30" height="6" fill="#dd0000" />
      <rect y="13" width="30" height="7" fill="#ffce00" />
    </>
  )}
</svg>
