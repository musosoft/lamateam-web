---
interface Props {
  title: string;
  isAuthenticated: boolean;
  userName: string;
  hero: string;
}

const { title, isAuthenticated, userName, hero } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LaMaTeam - Game Community" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={hero} />
  </head>
  <body>
    <main id="main-content" class="group fixed inset-0 flex items-center justify-center bg-gray-900 backdrop-blur-sm">
      <div class="absolute inset-0 opacity-100 block group-hover:hidden animate-pointer"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <Fragment set:html={hero} />
      </div>

      <!-- Slot for main content (index) -->
      <slot />
    </main>

    <!-- Script for handling authentication logic -->
    <script is:inline define:vars={{ isAuthenticated, userName }}>
      document.addEventListener("DOMContentLoaded", async () => {
        const loginBtn = document.getElementById("login");
        const logoutBtn = document.getElementById("logout");
        const userGreeting = document.getElementById("greeting-message");

        try {
          const { signIn, signOut } = await import("auth-astro/client");

          if (isAuthenticated) {
            if (userGreeting) userGreeting.innerText = `Welcome, ${userName}`;
            if (logoutBtn) {
              logoutBtn.classList.remove("hidden");
              logoutBtn.onclick = () => signOut();
            }
            if (loginBtn) loginBtn.classList.add("hidden");
          } else {
            if (userGreeting) userGreeting.innerText = "Please log in with Steam to access this feature.";
            if (loginBtn) {
              loginBtn.classList.remove("hidden");
              loginBtn.onclick = () => signIn("steam");
            }
            if (logoutBtn) logoutBtn.classList.add("hidden");
          }
        } catch (error) {
          console.warn("auth-astro client not available. Using mock functions.");
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @keyframes pointer-animation {
    0% { left: 0; top: 0; transform: rotate(135deg); }
    25% { left: 0; top: calc(100% - 75px); transform: rotate(45deg); }
    50% { top: calc(100% - 75px); left: calc(100% - 75px); transform: rotate(-45deg); }
    75% { left: calc(100% - 75px); top: 0; transform: rotate(-135deg); }
    100% { left: 0; top: 0; transform: rotate(135deg); }
  }
  
  .animate-pointer {
    position: fixed;
    left: 0;
    top: 0;
    width: 75px;
    height: 75px;
    background-image: url(/assets/pointer.svg);
    background-repeat: no-repeat;
    animation: pointer-animation 3.5s infinite forwards;
  }
</style>
