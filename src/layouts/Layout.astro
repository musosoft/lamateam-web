---
// src/layouts/Layout.astro
import CandyBox from '../components/CandyBox.astro';
import "../assets/tailwind.css";

const cookies = Astro.cookies;
const userAgent = Astro.request.headers.get('user-agent')?.toLowerCase() || '';
const isGame = userAgent.includes('valve') || userAgent.includes('steam');

const queryCommunityId = Astro.url.searchParams.get('communityid') || '';
const queryPlayerName = Astro.url.searchParams.get('name') || '';
let communityId = queryCommunityId || cookies.get('communityid')?.value || '';
let playerName = queryPlayerName || cookies.get('name')?.value || '';

const cookieOptions = {
  path: '/',
  httpOnly: false,
  sameSite: 'lax' as const,
  secure: !import.meta.env.DEV,
  maxAge: 60 * 60 * 24 * 30,
};

if (queryCommunityId) {
  cookies.set('communityid', communityId, cookieOptions);
}
if (queryPlayerName) {
  cookies.set('name', playerName, cookieOptions);
}

interface Props {
  title: string;
}

const { title } = Astro.props;
const motdQuery =
  communityId && playerName
    ? `?communityid=${encodeURIComponent(communityId)}&name=${encodeURIComponent(playerName)}`
    : '';
const homeHref = motdQuery ? `/${motdQuery}` : '/';
const hideHomeIcon = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LaMaTeam - Game Community" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body>
    <main
      id="main-content"
      class=`group fixed inset-0 flex items-center justify-center bg-gray-900 backdrop-blur-sm ${isGame ? 'bg-opacity-0' : ''}`
    >
      <div
        class=`absolute inset-0 opacity-100 block ${isGame ? 'group-hover:hidden animate-pointer' : ''}`
      >
      </div>
      <div
        class="relative flex grow flex-col h-full w-full overflow-y-auto rounded-lg z-10 justify-start fl-p-2/8 text-center text-white text-sm"
      >
        <CandyBox href={homeHref} hidden={hideHomeIcon} />
        <slot />
        <div
          id="translate-wrapper"
          class="fixed bottom-2 right-2 z-50 flex items-center gap-2 rounded-xl bg-gray-600 hover:bg-blue-700 px-2 py-2 text-white shadow-xl backdrop-blur-md transition-all"
        >
          <span class="text-xl">🌐</span>
          <div
            id="google_translate_element"
            class="[&_.goog-te-combo]:cursor-pointer [&_.goog-te-combo]:appearance-none [&_.goog-te-combo]:bg-transparent [&_.goog-te-combo]:text-sm [&_.goog-te-combo]:font-medium [&_.goog-te-combo]:text-white [&_.goog-te-combo]:outline-none [&_.goog-te-gadget_span]:hidden [&_.goog-te-gadget]:text-[0px]! [&_img]:hidden [&_option]:bg-gray-800 [&_option]:text-white"
          >
          </div>
        </div>
      </div>
    </main>
    <script is:inline>
      window.googleTranslateElementInit = () => {
        new google.translate.TranslateElement(
          { pageLanguage: 'cs' },
          'google_translate_element',
        );
      };
    </script>
    <script is:inline define:vars={{ isGame, communityId, playerName, motdQuery }}>
      (() => {
        if (!isGame) {
          return;
        }

        const lastPageKey = 'lmta_motd_last_page';
        const restoreGuardKey = 'lmta_motd_restore_once';
        const currentPath = `${window.location.pathname}${window.location.search}`;

        if (window.location.pathname === '/') {
          const alreadyRestored = sessionStorage.getItem(restoreGuardKey) === '1';
          const saved = localStorage.getItem(lastPageKey);
          const hasHash = window.location.hash && window.location.hash.length > 1;
          const isValidSaved = !!saved && saved.startsWith('/') && !saved.startsWith('/#');

          if (!alreadyRestored && !hasHash && isValidSaved && saved !== '/' && saved !== currentPath) {
            sessionStorage.setItem(restoreGuardKey, '1');
            window.location.replace(saved);
            return;
          }
          sessionStorage.setItem(restoreGuardKey, '1');
        } else {
          localStorage.setItem(lastPageKey, currentPath);
        }

        if (!communityId || !playerName) {
          return;
        }

        const applyMotdQuery = () => {
          const links = document.querySelectorAll('a[href]');
          links.forEach((link) => {
            const rawHref = link.getAttribute('href');
            if (!rawHref) {
              return;
            }

            if (
              rawHref.startsWith('#') ||
              rawHref.startsWith('mailto:') ||
              rawHref.startsWith('tel:') ||
              rawHref.startsWith('javascript:') ||
              rawHref.startsWith('steam://')
            ) {
              return;
            }

            let parsed;
            try {
              parsed = new URL(rawHref, window.location.origin);
            } catch {
              return;
            }

            if (parsed.origin !== window.location.origin) {
              return;
            }

            if (parsed.pathname.startsWith('/api/')) {
              return;
            }

            if (!parsed.searchParams.get('communityid')) {
              parsed.searchParams.set('communityid', communityId);
            }

            if (!parsed.searchParams.get('name')) {
              parsed.searchParams.set('name', playerName);
            }

            const nextHref = `${parsed.pathname}${parsed.search}${parsed.hash}`;
            if (nextHref !== rawHref) {
              link.setAttribute('href', nextHref);
            }
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', applyMotdQuery, {
            once: true,
          });
        } else {
          applyMotdQuery();
        }
      })();
    </script>
    <script
      is:inline
      src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
    ></script>
  </body>
</html>
