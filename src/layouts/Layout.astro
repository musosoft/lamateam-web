---
// src/layouts/Layout.astro
import { Icon } from 'astro-icon/components';
interface Props {
  title: string;
  isAuthenticated: boolean;
  userName: string;
  hero: string;
}

const { title, isAuthenticated, userName, hero } = Astro.props;

// Accessing query parameters using Astro.url
const communityId = Astro.url.searchParams.get('communityid');
const playerName = Astro.url.searchParams.get('name');
const isGame = navigator.userAgent.includes('Valve Client');
const inGameAuthenticated = isGame && communityId && playerName;

// Pass these variables globally for use in child components
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LaMaTeam - Game Community" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body>
    <main
      id="main-content"
      class=`group fixed inset-0 flex items-center justify-center bg-gray-900 backdrop-blur-sm ${isGame ? 'bg-opacity-0' : ''}`
    >
      <div
        class=`absolute inset-0 opacity-100 block ${isGame ? 'group-hover:hidden animate-pointer' : ''}`
      >
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        {isGame && <Fragment set:html={hero} />}
      </div>
      <div
        class="relative flex grow flex-col h-full w-full overflow-y-scroll rounded-lg z-10 justify-center ~p-2/8 text-center text-white text-sm"
      >
        <a
          href="/"
          class="absolute top-2 right-2 text-white bg-gray-600 hover:bg-blue-700 p-2 rounded-lg text-4xl z-50"
        >
          <Icon name="mdi:dots-grid" /></a
        >
        <slot />
      </div>
    </main></body
  >
</html>
