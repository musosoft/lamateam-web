---
// src/layouts/Layout.astro
interface Props {
  title: string;
  isAuthenticated: boolean;
  userName: string;
  hero: string;
}

const { title, isAuthenticated, userName, hero } = Astro.props;

// Accessing query parameters using Astro.url
const communityId = Astro.url.searchParams.get('communityid');
const playerName = Astro.url.searchParams.get('name');
const isGame = navigator.userAgent.includes('Valve Client');
const inGameAuthenticated = isGame && communityId && playerName;

// Pass these variables globally for use in child components
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="LaMaTeam - Game Community" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body>
    <main id="main-content" class="group fixed inset-0 flex items-center justify-center bg-gray-900 backdrop-blur-sm">
      <div class=`absolute inset-0 opacity-100 block ${isGame ? 'group-hover:hidden animate-pointer' : ''}`></div>
      <div class="absolute inset-0 flex items-center justify-center">
        {isGame && <Fragment set:html={hero} />}
      </div>

      <!-- Slot for main content (index or others) -->
      <slot />
    </main>

    <!-- Script for handling global authentication and in-game logic -->
    <script is:inline define:vars={{ isAuthenticated, userName, inGameAuthenticated, playerName, communityId }}>
      document.addEventListener("DOMContentLoaded", () => {
        const userGreeting = document.getElementById("greeting-message");

        if (inGameAuthenticated) {
          // For in-game users with valid query params
          if (userGreeting) userGreeting.innerText = `Welcome, ${playerName}`;
        } else if (isAuthenticated) {
          // Regular authenticated users
          if (userGreeting) userGreeting.innerText = `Welcome, ${userName}`;
        } else {
          // Non-authenticated users
          if (userGreeting) userGreeting.innerText = "Please log in with Steam to access this feature.";
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @keyframes pointer-animation {
    0% { left: 0; top: 0; transform: rotate(135deg); }
    25% { left: 0; top: calc(100% - 75px); transform: rotate(45deg); }
    50% { top: calc(100% - 75px); left: calc(100% - 75px); transform: rotate(-45deg); }
    75% { left: calc(100% - 75px); top: 0; transform: rotate(-135deg); }
    100% { left: 0; top: 0; transform: rotate(135deg); }
  }

  .animate-pointer {
    position: fixed;
    left: 0;
    top: 0;
    width: 75px;
    height: 75px;
    background-image: url(/assets/pointer.svg);
    background-repeat: no-repeat;
    animation: pointer-animation 3.5s infinite forwards;
  }
</style>
