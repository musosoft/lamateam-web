{
  "name": "lamateam-web",
  "account_id": "35fb1fa78fd6e4b3fec59816541918fd",
  "compatibility_date": "2026-01-20",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "dist/client",
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "lamateam.eu",
      "zone_name": "lamateam.eu",
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://lamateam.eu/",
    "TURSO_DATABASE_URL": "libsql://lama-musosoft.aws-eu-west-1.turso.io",
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "78ed4236838944ed86f5f0cedbac92c6" },
  ],
  // Approximate, per-colo burst protection; not a global usage or spend cap.
  "ratelimits": [
    {
      "name": "TRANSLATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
  "observability": {
    "logs": { "enabled": true },
  },
}
